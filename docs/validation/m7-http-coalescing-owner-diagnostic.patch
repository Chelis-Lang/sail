+// Unselected diagnostic: bounded metadata from this test process only.
+#[cfg(test)]
+type OwnerSample = (
+    std::time::Instant,
+    std::time::Instant,
+    bool,
+    Vec<(String, Option<String>, Option<String>, Option<String>)>,
+);
+
+#[cfg(test)]
+fn owner_field(path: &std::path::Path) -> Option<String> {
+    let mut bytes = Vec::with_capacity(256);
+    std::fs::File::open(path)
+        .ok()?
+        .take(4097)
+        .read_to_end(&mut bytes)
+        .ok()?;
+    (bytes.len() <= 4096)
+        .then(|| String::from_utf8(bytes).ok())
+        .flatten()
+}
+
+#[cfg(test)]
+pub(crate) fn owner_sample() -> OwnerSample {
+    let started = std::time::Instant::now();
+    let mut rows = Vec::with_capacity(2);
+    let current = std::path::Path::new("/proc/thread-self");
+    rows.push((
+        "calling-thread".to_owned(),
+        owner_field(&current.join("stat")),
+        owner_field(&current.join("schedstat")),
+        owner_field(&current.join("wchan")),
+    ));
+    let mut complete = true;
+    if let Ok(tasks) = std::fs::read_dir("/proc/self/task") {
+        for (index, task) in tasks.take(65).enumerate() {
+            if index == 64 || started.elapsed() >= std::time::Duration::from_millis(10) {
+                complete = false;
+                break;
+            }
+            let Ok(task) = task else {
+                complete = false;
+                continue;
+            };
+            let path = task.path();
+            if owner_field(&path.join("comm")).is_some_and(|name| name.trim() == "reqwest-interna")
+            {
+                let before = owner_field(&path.join("stat"));
+                let sched = owner_field(&path.join("schedstat"));
+                let wait = owner_field(&path.join("wchan"));
+                let after = owner_field(&path.join("stat"));
+                // Both stat records retain task birth; analysis must refuse
+                // deltas across changed/missing birth identities.
+                rows.push((
+                    format!("reqwest-runtime:{}", task.file_name().to_string_lossy()),
+                    before,
+                    sched,
+                    wait,
+                ));
+                rows.push(("runtime-post-stat".to_owned(), after, None, None));
+            }
+        }
+    } else {
+        complete = false;
+    }
+    (started, std::time::Instant::now(), complete, rows)
+}
+
+#[cfg(test)]
+impl Drop for Metrics {
+    fn drop(&mut self) {
+        if let Ok(samples) = self.owner_samples.get_mut() {
+            eprintln!("HTTP transport owner samples: {samples:?}");
+        }
+    }
+}
