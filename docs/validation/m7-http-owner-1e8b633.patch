+#[cfg(test)]
+type OwnerSample = Vec<(String, Option<String>, Option<String>)>;
+
+#[cfg(test)]
+fn read_owner_field(path: &std::path::Path) -> Option<String> {
+    use std::io::Read as _;
+    let mut bytes = Vec::with_capacity(512);
+    std::fs::File::open(path)
+        .ok()?
+        .take(4097)
+        .read_to_end(&mut bytes)
+        .ok()?;
+    if bytes.len() > 4096 {
+        return None;
+    }
+    String::from_utf8(bytes).ok()
+}
+
+#[cfg(test)]
+pub(crate) fn owner_sample() -> OwnerSample {
+    let mut values = Vec::new();
+    let base = std::path::Path::new("/proc/thread-self");
+    values.push((
+        "calling-thread".to_owned(),
+        read_owner_field(&base.join("stat")),
+        read_owner_field(&base.join("schedstat")),
+    ));
+    let Ok(tasks) = std::fs::read_dir("/proc/self/task") else {
+        return values;
+    };
+    let tasks: Vec<_> = tasks.take(65).collect();
+    if tasks.len() > 64 {
+        return values;
+    }
+    for task in tasks.into_iter().flatten() {
+        let path = task.path();
+        let Some(comm) = read_owner_field(&path.join("comm")) else {
+            continue;
+        };
+        if comm.trim() == "reqwest-interna" {
+            values.push((
+                format!("reqwest-runtime:{}", task.file_name().to_string_lossy()),
+                read_owner_field(&path.join("stat")),
+                read_owner_field(&path.join("schedstat")),
+            ));
+        }
+    }
+    values
+}
+
+#[cfg(test)]
+impl Drop for Metrics {
+    fn drop(&mut self) {
+        if let Ok(samples) = self.owner_samples.get_mut() {
+            eprintln!("HTTP owner snapshots: {samples:?}");
+        }
+    }
+}
