+//! Unselected single acquisition control for a retained completed project.
+#![allow(clippy::unwrap_used, reason = "unselected ignored diagnostic fixture")]
+use super::*;
+use std::collections::BTreeMap;
+use std::os::unix::fs::MetadataExt as _;
+use std::path::Path;
+#[test]
+#[ignore = "one explicitly authorized retained-scope acquisition; no Cargo or proof"]
+fn diagnose_retained_input_lease_acquisition_once() {
+    let directory = std::env::var("SAIL_LEASE_DIAGNOSTIC_INPUT").unwrap();
+    let directory = Path::new(&directory);
+    let input: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(directory.join("input.json")).unwrap()).unwrap();
+    let environment: BTreeMap<String, String> =
+        serde_json::from_slice(&std::fs::read(directory.join("environment.json")).unwrap())
+            .unwrap();
+    let cache = Path::new(input["cache"].as_str().unwrap());
+    let workspace = Path::new(input["workspace"].as_str().unwrap());
+    let context = input["context"].as_str().unwrap();
+    let snapshot = runner::refresh_context(cache, workspace, context, &environment).unwrap();
+    let encode = |paths: &[std::path::PathBuf]| {
+        paths
+            .iter()
+            .map(|p| p.as_os_str().as_encoded_bytes().to_vec())
+            .collect::<Vec<_>>()
+    };
+    let observer = precise::Observer::begin(&snapshot.roots, &snapshot.excluded);
+    let Some(mut observer) = observer else {
+        std::fs::write(
+            directory.join("outcome.json"),
+            b"{\"observer_available\":false,\"acquisition_attempted\":false}",
+        )
+        .unwrap();
+        return;
+    };
+    let paths = observer.files();
+    let rows:Vec<_>=paths.iter().map(|path|{let m=std::fs::metadata(path).unwrap();serde_json::json!({"path":path.as_os_str().as_encoded_bytes(),"device":m.dev(),"inode":m.ino()})}).collect();
+    let inventory = serde_json::json!({"snapshot_complete":snapshot.complete,"input_revision":snapshot.revision,"roots":encode(&snapshot.roots),"excluded":encode(&snapshot.excluded),"observer_files":rows});
+    let bytes = serde_json::to_vec(&inventory).unwrap();
+    assert!(bytes.len() <= 8 * 1024 * 1024);
+    std::fs::write(directory.join("inventory.json"), bytes).unwrap();
+    lease::ReadLease::diagnostic_output(directory.to_owned());
+    let mut owner = lease::ReadLease::acquire(&paths);
+    let available = owner.is_some();
+    let owner_clean = owner.as_mut().map(lease::ReadLease::clean);
+    let observer_clean = observer.clean();
+    std::fs::write(directory.join("outcome.json"),serde_json::to_vec(&serde_json::json!({"observer_available":true,"acquisition_attempted":true,"lease_available":available,"owner_clean":owner_clean,"observer_clean":observer_clean})).unwrap()).unwrap();
+    drop(owner);
+    drop(observer);
+}
