diff --git a/crates/sail-daemon/src/remote/transport.rs b/crates/sail-daemon/src/remote/transport.rs
new file mode 100644
index 0000000..562220f
--- /dev/null
+++ b/crates/sail-daemon/src/remote/transport.rs
@@ -0,0 +1,129 @@
+//! Owned HTTP I/O driver; synchronous helpers poll the same async reqwest API.
+
+use std::future::Future;
+use std::sync::{Arc, mpsc};
+use std::thread::JoinHandle;
+
+use reqwest::{Client, ClientBuilder};
+use tokio::runtime::Handle;
+use tokio::sync::Notify;
+
+use super::failure;
+
+/// Refuse a synchronous network operation inside an async runtime before it
+/// reaches Tokio's panicking nested `block_on` path.
+pub(super) fn outside_runtime() -> Result<(), String> {
+    if Handle::try_current().is_ok() {
+        Err(failure(
+            "synchronous HTTP transport requires an owned blocking helper",
+        ))
+    } else {
+        Ok(())
+    }
+}
+
+struct Owner {
+    handle: Handle,
+    stop: Arc<Notify>,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl Drop for Owner {
+    fn drop(&mut self) {
+        self.stop.notify_one();
+        // Runtime destruction occurs only on its owner, never in the caller's
+        // runtime context. Like the original blocking client, final disposal
+        // joins its I/O owner; daemon retirement must remain off foreground
+        // status/publication locks. Kernel-blocked DNS can delay this join.
+        // The I/O thread captures only Notify/builder/ready sender, never an
+        // Owner or Transport; connection tasks own only reqwest internals.
+        // Consequently the final Owner cannot be dropped on its own thread.
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+#[derive(Clone)]
+pub(super) struct Transport {
+    client: Client,
+    owner: Arc<Owner>,
+}
+
+impl Transport {
+    pub(super) fn new(builder: ClientBuilder) -> Result<Self, String> {
+        outside_runtime()?;
+        let stop = Arc::new(Notify::new());
+        let shutdown = Arc::clone(&stop);
+        let (ready, result) = mpsc::sync_channel(1);
+        let thread = std::thread::Builder::new()
+            .name("sail-http-io".to_owned())
+            .spawn(move || {
+                let Ok(runtime) = tokio::runtime::Builder::new_current_thread()
+                    // One optional resolver/blocking worker, in addition to
+                    // the one owned I/O thread. Queued DNS retains the same
+                    // request deadline and fails safe rather than growing
+                    // Tokio's default 512-thread blocking pool.
+                    .max_blocking_threads(1)
+                    .enable_all()
+                    .build()
+                else {
+                    let _ = ready.send(Err(failure("cannot initialize HTTP I/O driver")));
+                    return;
+                };
+                // Match reqwest blocking's construction inside its owned
+                // runtime, preserving resolver and TLS initialization context.
+                let entered = runtime.enter();
+                let client = builder.build();
+                drop(entered);
+                match client {
+                    Ok(client) => {
+                        if ready.send(Ok((client, runtime.handle().clone()))).is_ok() {
+                            runtime.block_on(shutdown.notified());
+                        }
+                    }
+                    Err(_) => {
+                        let _ = ready.send(Err(failure("cannot initialize HTTP transport")));
+                    }
+                }
+                // The owner is no longer entered into a runtime here.
+                drop(runtime);
+            })
+            .map_err(|_| failure("cannot start HTTP I/O driver"))?;
+        match result.recv() {
+            Ok(Ok((client, handle))) => Ok(Self {
+                client,
+                owner: Arc::new(Owner {
+                    handle,
+                    stop,
+                    thread: Some(thread),
+                }),
+            }),
+            Ok(Err(error)) => {
+                let _ = thread.join();
+                Err(error)
+            }
+            Err(_) => {
+                let _ = thread.join();
+                Err(failure("HTTP I/O driver stopped during construction"))
+            }
+        }
+    }
+
+    #[cfg(test)]
+    pub(super) fn same_owner(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.owner, &other.owner)
+    }
+
+    pub(super) fn client(&self) -> &Client {
+        &self.client
+    }
+
+    pub(super) fn run<F: Future>(&self, future: F) -> Result<F::Output, String> {
+        outside_runtime()?;
+        // The helper polls request/body futures directly. The one I/O owner
+        // continuously drives spawned connection tasks and timers; no request
+        // channel, response oneshot, or blocking body-reader adapter is needed.
+        Ok(self.owner.handle.block_on(future))
+    }
+}
