{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sail.invalid/schema/repair-result-v1.json",
  "title": "Sail independent focused/full repair validation v1",
  "type": "object",
  "required": [
    "version",
    "batch",
    "accepted"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "accepted": {
      "type": "boolean"
    },
    "batch": {
      "type": "object",
      "required": [
        "focus",
        "full",
        "manifest_sha256",
        "compiler_invocations",
        "batched"
      ],
      "properties": {
        "focus": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "project-result-v1.json"
            }
          ]
        },
        "full": {
          "$ref": "project-result-v1.json"
        },
        "manifest_sha256": {
          "type": "string"
        },
        "compiler_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "batched": {
          "type": "boolean"
        }
      }
    }
  },
  "$comment": "accepted is recomputed from full evidence: Current, successful complete requested target reports, whole-target successful Verus inventory and successful process seal. Focus evidence cannot authorize acceptance. batched records actual supported engine behavior, not composition of independent processes."
}
