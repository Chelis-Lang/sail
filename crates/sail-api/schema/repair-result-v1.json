{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sail.invalid/schema/repair-result-v1.json",
  "title": "Sail independent focused/full repair validation v1",
  "type": "object",
  "required": [
    "version",
    "batch",
    "accepted"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "accepted": {
      "type": "boolean"
    },
    "batch": {
      "type": "object",
      "required": [
        "focus",
        "full",
        "manifest_sha256",
        "compiler_invocations",
        "batched"
      ],
      "properties": {
        "focus": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "project-result-v1.json"
            }
          ]
        },
        "full": {
          "$ref": "project-result-v1.json"
        },
        "manifest_sha256": {
          "type": "string"
        },
        "compiler_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "batched": {
          "type": "boolean"
        },
        "engine_fault": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^SAIL[0-9]{4}$"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "selection_error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^SAIL[0-9]{4}$"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "preparation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "enabled",
                  "batch_hits",
                  "persistent_hits",
                  "misses",
                  "peak_retained_bytes",
                  "memory_budget_bytes",
                  "disk_budget_bytes"
                ],
                "properties": {
                  "batch_hits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "persistent_hits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "misses": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "peak_retained_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "memory_budget_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "disk_budget_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "version": {
                    "const": 1
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "target": {
                    "$ref": "proof-event-v1.json#/properties/input/properties/target"
                  },
                  "phase": {
                    "type": "string",
                    "enum": [
                      "focus",
                      "full"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$comment": "accepted additionally requires no selection_error and no engine_fault (an engine fault falls back to stock verification, retained in full, which never accepts a repair). accepted is recomputed from full evidence: Current, successful complete requested target reports, whole-target successful Verus inventory and successful process seal. Focus evidence cannot authorize acceptance. batched records actual supported engine behavior, not composition of independent processes."
}
