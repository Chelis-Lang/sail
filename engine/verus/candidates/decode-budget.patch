+macro_rules! forward { ($($name:ident($($arg:ident:$ty:ty),*)),* $(,)?) => {$ (
+    fn $name<V:Visitor<'de>>(self,$($arg:$ty,)*visitor:V)->Result<V::Value,Self::Error>{
+        self.owner.budget.value::<V::Value,Self::Error>()?;
+        self.inner.$name($($arg,)*Checked {inner:visitor,owner:self.owner})
+    }
+)*}; }
+impl<'de, D: Deserializer<'de>> Deserializer<'de> for Guard<'_, D> {
+    type Error = D::Error;
+    forward!(deserialize_bool(),deserialize_i8(),deserialize_i16(),deserialize_i32(),deserialize_i64(),deserialize_i128(),deserialize_u8(),deserialize_u16(),deserialize_u32(),deserialize_u64(),deserialize_u128(),deserialize_f32(),deserialize_f64(),deserialize_char(),deserialize_str(),deserialize_bytes(),deserialize_option(),deserialize_unit(),deserialize_unit_struct(name:&'static str),deserialize_seq(),deserialize_tuple(count:usize),deserialize_tuple_struct(name:&'static str,count:usize),deserialize_map(),deserialize_struct(name:&'static str,fields:&'static [&'static str]),deserialize_enum(name:&'static str,variants:&'static [&'static str]),deserialize_identifier());
+    // String and byte-buffer wire encodings equal the borrowed variants. Redirect
+    // before bincode can allocate; admission occurs before the visitor owns bytes.
+    fn deserialize_string<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, Self::Error> {
+        self.deserialize_str(visitor)
+    }
+    fn deserialize_byte_buf<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, Self::Error> {
+        self.deserialize_bytes(visitor)
+    }
+    fn deserialize_newtype_struct<V: Visitor<'de>>(
+        self,
+        name: &'static str,
+        visitor: V,
+    ) -> Result<V::Value, Self::Error> {
+        if name == "SailBoundedFrames/v1" {
+            // Sole audited exception: Frames already admits every allocation
+            // before reserve, with <=1 MiB frames and <=16 MiB total capacity.
+            self.inner.deserialize_newtype_struct(name, visitor)
+        } else {
+            self.owner.budget.value::<V::Value, Self::Error>()?;
+            self.inner.deserialize_newtype_struct(
+                name,
+                Checked {
+                    inner: visitor,
+                    owner: self.owner,
+                },
+            )
+        }
+    }
+    fn deserialize_any<V: Visitor<'de>>(self, _visitor: V) -> Result<V::Value, Self::Error> {
+        Err(de::Error::custom("unsupported prepared dynamic schema"))
+    }
+    fn deserialize_ignored_any<V: Visitor<'de>>(
+        self,
+        _visitor: V,
+    ) -> Result<V::Value, Self::Error> {
+        Err(de::Error::custom("unsupported prepared ignored schema"))
+    }
+    fn is_human_readable(&self) -> bool {
+        false
+    }
+}
