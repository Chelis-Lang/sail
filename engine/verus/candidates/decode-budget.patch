+        count: usize,
+        visitor: V,
+    ) -> Result<V::Value, Self::Error> {
+        self.owner.budget.value::<V::Value, Self::Error>()?;
+        self.inner.tuple_variant(
+            count,
+            Checked {
+                inner: visitor,
+                owner: self.owner,
+            },
+        )
+    }
+    fn struct_variant<V: Visitor<'de>>(
+        self,
+        fields: &'static [&'static str],
+        visitor: V,
+    ) -> Result<V::Value, Self::Error> {
+        self.owner.budget.value::<V::Value, Self::Error>()?;
+        self.inner.struct_variant(
+            fields,
+            Checked {
+                inner: visitor,
+                owner: self.owner,
+            },
+        )
+    }
