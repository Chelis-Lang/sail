+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde::{Deserialize, Serialize};
+    use std::collections::HashMap;
+    use std::sync::Arc;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    static OWNED_VISITS: AtomicUsize = AtomicUsize::new(0);
+    struct Probe;
+    impl<'de> Deserialize<'de> for Probe {
+        fn deserialize<D: Deserializer<'de>>(decoder: D) -> Result<Self, D::Error> {
+            struct ProbeVisitor;
+            impl<'de> Visitor<'de> for ProbeVisitor {
+                type Value = Probe;
+                fn expecting(&self, f: &mut fmt::Formatter) -> fmt::Result {
+                    f.write_str("owned string allocation probe")
+                }
+                fn visit_borrowed_str<E: de::Error>(self, value: &'de str) -> Result<Probe, E> {
+                    OWNED_VISITS.fetch_add(1, Ordering::SeqCst);
+                    let allocated = value.to_owned();
+                    drop(allocated);
+                    Ok(Probe)
+                }
+            }
+            decoder.deserialize_string(ProbeVisitor)
+        }
+    }
+    #[test]
+    fn refuses_string_before_the_owned_visitor_allocates() {
+        OWNED_VISITS.store(0, Ordering::SeqCst);
+        let bytes =
+            bincode_next::serde::encode_to_vec("x".repeat(8192), bincode_next::config::legacy())
+                .unwrap();
+        assert!(decode::<Probe>(&bytes, 4096).is_err());
+        assert_eq!(OWNED_VISITS.load(Ordering::SeqCst), 0);
+        assert!(decode::<Probe>(&bytes, 128 * 1024).is_ok());
+        assert_eq!(OWNED_VISITS.load(Ordering::SeqCst), 1);
+    }
+    #[test]
+    fn pathological_container_lengths_do_not_reach_reservation() {
+        // These announce a maximal container, but have no element bytes. No
+        // size hint is forwarded and no allocator sees that malicious count.
+        let bytes = u64::MAX.to_le_bytes();
+        let error = decode::<Vec<String>>(&bytes, 4096).unwrap_err().to_string();
+        assert!(error.contains("truncated"), "{error}");
+        assert!(decode::<HashMap<String, String>>(&bytes, 4096).is_err());
+        let mut bytes = 3u64.to_le_bytes().to_vec();
+        bytes.extend(7u64.to_le_bytes());
+        assert!(decode::<Vec<u64>>(&bytes, 4096).is_err());
+    }
+    // This regression deliberately exercises an inline enum larger than the
+    // pointer-sized variants; boxing it would remove the allocation case.
+    #[allow(clippy::large_enum_variant)]
+    #[derive(Debug, Serialize, Deserialize)]
+    enum Large {
+        Inline([u64; 32]),
+        Text(String),
+        Pair(Box<Large>, Box<Large>),
+    }
+    #[test]
+    fn largest_inline_enum_and_recursive_box_are_admitted_before_decode() {
+        let value = Large::Inline([7; 32]);
+        let bytes =
+            bincode_next::serde::encode_to_vec(value, bincode_next::config::legacy()).unwrap();
+        assert!(decode::<Large>(&bytes, size_of::<Large>()).is_err());
+        assert!(decode::<Large>(&bytes, 128 * 1024).is_ok());
+        let mut value = Large::Text("leaf".to_owned());
+        for _ in 0..140 {
+            value = Large::Pair(Box::new(value), Box::new(Large::Text(String::new())));
+        }
+        let bytes =
+            bincode_next::serde::encode_to_vec(&value, bincode_next::config::legacy()).unwrap();
+        assert!(decode::<Large>(&bytes, LIMIT).is_err());
+    }
+    #[derive(Debug, Serialize, Deserialize)]
+    struct Owned {
+        values: Vec<Arc<String>>,
+        map: HashMap<u64, String>,
+    }
+    #[test]
+    fn capacities_growth_and_duplicate_arcs_are_conservatively_charged() {
+        let shared = Arc::new("shared".repeat(100));
+        let value = Owned {
+            values: vec![shared; 257],
+            map: (0..257).map(|n| (n, "owned".repeat(20))).collect(),
+        };
+        let bytes =
+            bincode_next::serde::encode_to_vec(&value, bincode_next::config::legacy()).unwrap();
+        let budget = Budget::new();
+        struct Root<'a>(&'a Budget);
+        impl<'de> DeserializeSeed<'de> for Root<'_> {
+            type Value = Owned;
+            fn deserialize<D: Deserializer<'de>>(self, decoder: D) -> Result<Owned, D::Error> {
+                Owned::deserialize(Guard::new(decoder, self.0))
+            }
+        }
+        let (restored, used) = bincode_next::serde::seed_decode_from_slice(
+            Root(&budget),
+            &bytes,
+            bincode_next::config::legacy(),
+        )
+        .unwrap();
+        assert_eq!(used, bytes.len());
+        assert!(!Arc::ptr_eq(&restored.values[0], &restored.values[1]));
+        let retained = restored.values.capacity() * size_of::<Arc<String>>()
+            + restored
+                .values
+                .iter()
+                .map(|value| value.capacity() + size_of::<String>() + 32)
+                .sum::<usize>()
+            + restored.map.capacity() * (size_of::<(u64, String)>() + 16)
+            + restored.map.values().map(String::capacity).sum::<usize>();
+        assert!(
+            LIMIT - budget.remaining.get() > retained * 2,
+            "old/new capacity overlap must remain admitted"
+        );
+        assert!(decode::<Owned>(&bytes, retained).is_err());
+    }
+    #[test]
+    fn admission_overflow_and_unknown_dynamic_schema_refuse() {
+        let budget = Budget::with_limit(4096);
+        assert!(budget.bytes::<serde::de::value::Error>(usize::MAX).is_err());
+        assert_eq!(budget.remaining.get(), 4096);
+        assert!(decode::<serde::de::IgnoredAny>(&[], LIMIT).is_err());
+    }
+}
