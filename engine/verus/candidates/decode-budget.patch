+/// Decode only the audited derived schema, from borrowed bytes. Input buffer
+/// remains live; every owned conversion is admitted before visitor allocation.
+pub fn decode<T: serde::de::DeserializeOwned>(
+    bytes: &[u8],
+    limit: usize,
+) -> Result<(T, usize), bincode_next::error::DecodeError> {
+    struct Root<'a, T>(&'a Budget, std::marker::PhantomData<T>);
+    impl<'de, T: serde::Deserialize<'de>> DeserializeSeed<'de> for Root<'_, T> {
+        type Value = T;
+        fn deserialize<D: Deserializer<'de>>(self, decoder: D) -> Result<T, D::Error> {
+            T::deserialize(Guard::new(decoder, self.0))
+        }
+    }
+    let budget = Budget::with_limit(limit);
+    bincode_next::serde::seed_decode_from_slice(
+        Root::<T>(&budget, std::marker::PhantomData),
+        bytes,
+        bincode_next::config::legacy().with_limit::<536870912>(),
+    )
+}
