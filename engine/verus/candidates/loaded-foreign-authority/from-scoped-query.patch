+fn import_hash_kind(kind:rustc_span::SourceFileHashAlgorithm)->&'static str {
+    use rustc_span::SourceFileHashAlgorithm::*;
+    match kind {Md5=>"md5",Sha1=>"sha1",Sha256=>"sha256",Blake3=>"blake3"}
