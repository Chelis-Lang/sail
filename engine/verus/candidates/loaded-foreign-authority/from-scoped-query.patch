+fn import_stable_id(id:rustc_span::StableSourceFileId)->[u8;32] {
+    // Pinned StableSourceFileId's derived Hash consumes its complete Hash128.
+    // This stream owns only a digest; it cannot call SpanData.span()/TLS or
+    // allocate a Debug String. Source/runtime identity binds the pinned impl.
+    struct Identity(Sha256);
+    impl std::hash::Hasher for Identity {
+        fn write(&mut self,bytes:&[u8]){self.0.update(bytes);}
+        fn finish(&self)->u64{0} // Hash never consults finish(); final SHA is below.
+    }
+    let mut hash=Identity(Sha256::new());
+    std::hash::Hash::hash(&id,&mut hash);hash.0.finalize().into()
+}
