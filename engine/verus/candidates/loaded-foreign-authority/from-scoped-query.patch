+        }
+        let encoded=(|| {
+        if span.as_string.len()>4096{return Err(<serde_json::Error as serde::ser::Error>::custom("import trace spelling budget"));}
+        match &sources.3 {
+            Ok(imports)=>match imports.record(packed){
