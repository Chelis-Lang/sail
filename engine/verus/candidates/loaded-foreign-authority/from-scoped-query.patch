+fn trace_import_authority(span:&vir::messages::Span,sources:&Sources,packed:[u64;2]) {
+    if !FOCUS.load(Ordering::Relaxed) || std::env::var("SAIL_ENGINE_IMPORT_TRACE").as_deref()!=Ok("1"){return;}
+    // A fixed private observation target is a display filter only, never source
+    // authority. Filter before admission so unrelated memo duplicates cannot
+    // exhaust the supplementary known-binding trace; unsupported tokens skip.
+    let target=std::env::var_os("SAIL_ENGINE_IMPORT_TRACE_TARGET");
+    if !import_trace_selected(target.as_deref(),&span.as_string){return;}
+    drop(target);
+    // <=4096 complete records and <=4 MiB of published bytes, independently.
+    // Existing single bounded observer writer is used under its mutex. No Value
+    // tree, name clone, loader call, compiler borrow or separate buffer exists.
+    if IMPORT_TRACE_STOP.load(Ordering::Acquire){return;}
+    let skipped=Cell::new(false);
+    observe_inner("focus",|phase,writer|{
+        // Limit decisions and publication are serialized by the SAME emitter
+        // mutex. Queued callers cannot each emit a limit replacement after stop.
+        if IMPORT_TRACE_STOP.load(Ordering::Acquire){skipped.set(true);return Ok(());}
+        if IMPORT_TRACE_RECORDS.fetch_update(Ordering::AcqRel,Ordering::Acquire,|n|n.checked_add(1).filter(|n|*n<=4096)).is_err(){
+            IMPORT_TRACE_STOP.store(true,Ordering::Release);
