+                    crate::spans::sail_owned_imports::State::Loaded(owner)=>{
+                        serde_json::to_writer(&mut *writer,&Observation {version:1,phase,event:"import-authority-state",payload:Fields(fields!(
+                            "id":span.id,"words":packed,"as_string":&span.as_string,"eligible":imports.authority(packed).is_ok(),
+                            "initial_state":ObservedDebug(&record.initial.state),"pre_focus_state":ObservedDebug(&record.pre_focus.state),
+                            "initial_start":record.initial.start,"initial_end":record.initial.end,
+                            "pre_focus_start":record.pre_focus.start,"pre_focus_end":record.pre_focus.end,
+                            "original_start":record.original_start,"original_end":record.original_end,
+                            "expected_hash":&record.expected_hash[..usize::from(record.expected_hash_len)],
