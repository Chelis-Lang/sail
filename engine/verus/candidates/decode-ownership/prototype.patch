+mod tests {
+    use super::*;
+    #[test]
+    fn exact_registry_is_sorted_and_unknown_pairs_are_not_admitted() {
+        assert!(VALUES.windows(2).all(|pair| pair[0] < pair[1]));
+        assert!(VISITORS.windows(2).all(|pair| pair[0] < pair[1]));
+        assert!(!value("vir::ast::FutureType"));
+        assert!(!value("vir::messages::Span"));
+        assert!(!visitor("vir::ast::TypX", "custom::Visitor"));
+        assert!(!visitor(
+            "vir::ast::TypX",
+            "serde_core::de::impls::PrimitiveVisitor"
+        ));
+        assert!(!visitor("vir::ast::TypXSuffix", "custom::Visitor"));
+    }
