+// Closed ownership routes for the pinned prepared schema. Exact type+visitor
+// identities, audited derived bodies and pinned serde implementations only.
+// Unknown/custom transitions keep the original conservative accounting.
+pub(super) fn value(name: &str) -> bool {
+    VALUES.binary_search(&name).is_ok() || test_value(name)
+}
+pub(super) fn visitor(value: &str, visitor: &str) -> bool {
+    VISITORS.binary_search(&(value, visitor)).is_ok() || test_visitor(value, visitor)
+}
+pub(super) fn frames(value: &str, visitor: &str) -> bool {
+    value == "vir::sail_graph::Frames"
+        && visitor
+            == "<vir::sail_graph::Frames as serde_core::de::Deserialize<'_>>::deserialize::OwnerVisitor"
+}
+#[cfg(not(test))]
+fn test_value(_: &str) -> bool {
+    false
+}
+#[cfg(not(test))]
+fn test_visitor(_: &str, _: &str) -> bool {
+    false
+}
+#[cfg(test)]
+fn test_value(name: &str) -> bool {
+    name == std::any::type_name::<super::tests::Large>()
+        || name == std::any::type_name::<super::tests::Owned>()
+        || name == std::any::type_name::<super::ownership_tests::Fixed>()
+        || name == std::any::type_name::<super::ownership_tests::Envelope>()
+        || matches!(
+            name,
+            "sail_decode_budget_tests::sail_decode::tests::_::<impl serde_core::de::Deserialize<'_> for sail_decode_budget_tests::sail_decode::tests::Large>::deserialize::__Field"
+                | "sail_decode_budget_tests::sail_decode::ownership_tests::_::<impl serde_core::de::Deserialize<'_> for sail_decode_budget_tests::sail_decode::ownership_tests::Envelope>::deserialize::__Field"
+                | "vir::sail_decode::tests::_::<impl serde_core::de::Deserialize<'_> for vir::sail_decode::tests::Large>::deserialize::__Field"
+                | "vir::sail_decode::ownership_tests::_::<impl serde_core::de::Deserialize<'_> for vir::sail_decode::ownership_tests::Envelope>::deserialize::__Field"
+                | "[u64; 32]"
+                | "alloc::boxed::Box<sail_decode_budget_tests::sail_decode::tests::Large>"
+                | "alloc::sync::Arc<sail_decode_budget_tests::sail_decode::tests::Large>"
+                | "(u64, u64)"
+        )
+}
+#[cfg(test)]
+fn test_visitor(value: &str, visitor: &str) -> bool {
+    if !test_value(value) {
+        return false;
+    }
+    if visitor.starts_with("serde_core::de::impls::") {
+        return matches!(
+            value,
+            "vir::sail_decode::tests::_::<impl serde_core::de::Deserialize<'_> for vir::sail_decode::tests::Large>::deserialize::__Field"
+                | "vir::sail_decode::ownership_tests::_::<impl serde_core::de::Deserialize<'_> for vir::sail_decode::ownership_tests::Envelope>::deserialize::__Field"
+                | "[u64; 32]"
+                | "(u64, u64)"
+        );
+    }
+    if value.ends_with("::__Field") {
+        return visitor.ends_with("::__FieldVisitor")
+            && visitor.strip_suffix("Visitor") == Some(value);
+    }
+    visitor.contains("::_::<impl serde_core::de::Deserialize<'_> for ")
+        && visitor.contains("::sail_decode::")
+        && visitor.contains(">::deserialize::__Visitor")
+}
