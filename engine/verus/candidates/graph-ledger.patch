+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ast::{CrateId, FunX, PathX};
+    fn fun(name: &str) -> Fun {
+        Arc::new(FunX {
+            path: Arc::new(PathX {
+                krate: CrateId::Id(Arc::new("test".to_owned()), 7),
+                segments: Arc::new(vec![Arc::new(name.to_owned())]),
+            }),
+        })
+    }
+    fn node(name: &str) -> Node {
+        Node::Fun(fun(name))
+    }
+    fn graph(nodes: &[Node], edges: &[(Node, Node)]) -> (Graph<Node>, Vec<Node>) {
+        let mut graph = Graph::new();
+        for node in nodes {
+            graph.add_node(node.clone());
+        }
+        for (left, right) in edges {
+            graph.add_edge(left.clone(), right.clone());
+        }
+        graph.compute_sccs();
+        let order = graph.sort_sccs();
+        (graph, order)
+    }
+    fn order_record(capture: &Capture, graph: &Graph<Node>, order: &[Node], input: &[Fun]) {
+        let result = function_order(graph, order, input);
+        capture.record(QueryRef::FunctionOrder(input, &result));
+    }
+    #[test]
+    fn irrelevant_edge_change_survives_but_recursive_change_rejects() {
+        let (a, b, u, v) = (node("a"), node("b"), node("u"), node("v"));
+        let nodes = [a.clone(), b.clone(), u.clone(), v.clone()];
+        let (old, order) = graph(&nodes, &[(a.clone(), b.clone())]);
+        let capture = Capture::default();
+        capture.begin();
+        let rep = old.get_scc_rep(&a);
+        capture.record(QueryRef::SccRep(&a, &rep));
+        capture.record(QueryRef::IsCycle(&a, old.node_is_in_cycle(&a)));
+        order_record(&capture, &old, &order, &[fun("a"), fun("b")]);
+        let ledger = capture.finish().unwrap();
+        let (unrelated, order2) = graph(&nodes, &[(a.clone(), b.clone()), (u.clone(), v.clone())]);
+        assert!(validate(ledger.frames(), &unrelated, &order2).is_ok());
+        let (recursive, order3) = graph(&nodes, &[(a.clone(), b.clone()), (b.clone(), a.clone())]);
+        assert_eq!(validate(ledger.frames(), &recursive, &order3), Err("graph-answer-changed"));
+    }
+    #[test]
+    fn trait_cycle_and_order_answers_are_exact() {
+        let a = node("a");
+        let b = node("b");
+        let t = Node::Trait(fun("trait").path.clone());
+        let nodes = [a.clone(), b.clone(), t.clone()];
+        let (old, order) = graph(&nodes, &[(a.clone(), t.clone()), (t.clone(), a.clone())]);
+        let capture = Capture::default();
+        capture.begin();
+        let members = old.get_scc_nodes(&a);
+        capture.record(QueryRef::SccNodes(&a, &members));
+        let cycle = old.shortest_cycle_back_to_self(&t);
+        capture.record(QueryRef::ShortestCycle(&t, &cycle));
+        order_record(&capture, &old, &order, &[fun("a"), fun("b")]);
+        let ledger = capture.finish().unwrap();
+        assert!(validate(ledger.frames(), &old, &order).is_ok());
+        let (broken, new_order) = graph(&nodes, &[(a.clone(), t.clone())]);
+        assert_eq!(validate(ledger.frames(), &broken, &new_order), Err("graph-answer-changed"));
+        let mut reversed = order.clone();
+        reversed.reverse();
+        assert_eq!(validate(ledger.frames(), &old, &reversed), Err("graph-answer-changed"));
+    }
+    #[test]
+    fn borrowed_frames_match_owned_codec_and_fail_closed_on_malformed() {
+        let a = node("a");
+        let b = node("b");
+        let nodes = [a.clone(), b.clone()];
+        let (graph, order) = graph(&nodes, &[(a.clone(), b.clone()), (b.clone(), a.clone())]);
+        let capture = Capture::default();
+        capture.begin();
+        let rep = graph.get_scc_rep(&a);
+        capture.record(QueryRef::SccRep(&a, &rep));
+        capture.record(QueryRef::IsCycle(&a, true));
+        let members = graph.get_scc_nodes(&a);
+        capture.record(QueryRef::SccNodes(&a, &members));
+        let cycle = graph.shortest_cycle_back_to_self(&a);
+        capture.record(QueryRef::ShortestCycle(&a, &cycle));
+        let selected = [fun("a"), fun("b")];
+        order_record(&capture, &graph, &order, &selected);
+        let ledger = capture.finish().unwrap();
+        for frame in ledger.frames() {
+            let (query, used): (Query, usize) =
+                bincode_next::serde::decode_from_slice(frame, bincode_next::config::legacy())
+                    .unwrap();
+            assert_eq!(used, frame.len());
+            assert_eq!(
+                *frame,
+                bincode_next::serde::encode_to_vec(query, bincode_next::config::legacy()).unwrap()
+            );
+        }
+        assert!(validate(ledger.frames(), &graph, &order).is_ok());
+        assert_eq!(validate(&[], &graph, &order), Err("ledger-coverage"));
+        let mut corrupted = ledger.frames().to_vec();
+        corrupted[0].push(0);
+        assert_eq!(validate(&corrupted, &graph, &order), Err("ledger-trailing"));
+        corrupted[0] = vec![255; 4];
+        assert_eq!(validate(&corrupted, &graph, &order), Err("ledger-shape"));
+    }
+    #[test]
+    fn ledger_decode_bounds_before_allocation() {
+        let frames = vec![vec![1u8; 64], vec![2u8; 128]];
+        let bytes =
+            bincode_next::serde::encode_to_vec(&frames, bincode_next::config::legacy()).unwrap();
+        let (decoded, used): (Frames, usize) =
+            bincode_next::serde::decode_from_slice(&bytes, bincode_next::config::legacy()).unwrap();
+        assert_eq!(used, bytes.len());
+        assert_eq!(decoded.frames(), frames.as_slice());
+        let excessive = ((LIMIT / std::mem::size_of::<Vec<u8>>() + 1) as u64).to_le_bytes();
+        assert!(
+            bincode_next::serde::decode_from_slice::<Frames, _>(
+                &excessive,
+                bincode_next::config::legacy()
+            )
+            .is_err()
+        );
+        let too_big = vec![vec![0u8; FRAME_LIMIT + 1]];
+        let bytes =
+            bincode_next::serde::encode_to_vec(&too_big, bincode_next::config::legacy()).unwrap();
+        assert!(
+            bincode_next::serde::decode_from_slice::<Frames, _>(
+                &bytes,
+                bincode_next::config::legacy()
+            )
+            .is_err()
+        );
+    }
+    #[test]
+    fn quota_release_waits_for_physical_drop_even_during_racing_admission() {
+        use std::sync::mpsc;
+        struct Allocation {
+            bytes: Option<Vec<u8>>,
+            started: mpsc::Sender<()>,
+            finish: mpsc::Receiver<()>,
+        }
+        impl Drop for Allocation {
+            fn drop(&mut self) {
+                self.started.send(()).unwrap();
+                self.finish.recv().unwrap();
+                drop(self.bytes.take());
+            }
+        }
+        let quota = Arc::new(AtomicUsize::new(128));
+        let (started_tx, started_rx) = mpsc::channel();
+        let (finish_tx, finish_rx) = mpsc::channel();
+        let owned =
+            Allocation { bytes: Some(vec![0; 128]), started: started_tx, finish: finish_rx };
+        let worker_quota = quota.clone();
+        let thread = std::thread::spawn(move || {
+            release_after_drop(owned, || {
+                worker_quota.fetch_sub(128, Ordering::SeqCst);
+            })
+        });
+        started_rx.recv().unwrap();
+        assert!(
+            quota
+                .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |old| old
+                    .checked_add(128)
+                    .filter(|value| *value <= 128))
+                .is_err(),
+            "admitted replacement while old allocation is live"
+        );
+        finish_tx.send(()).unwrap();
+        thread.join().unwrap();
+        assert_eq!(
+            quota.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |old| old
+                .checked_add(128)
+                .filter(|value| *value <= 128)),
+            Ok(0)
+        );
+    }
+    #[test]
+    fn final_capture_clone_keeps_recording_owned_until_drop() {
+        let capture = Capture::default();
+        capture.begin();
+        let cloned = capture.clone();
+        drop(capture);
+        let input = node("a");
+        cloned.record(QueryRef::IsCycle(&input, false));
+        assert!(cloned.finish().is_some());
+    }
+    #[test]
+    fn unsupported_or_oversized_read_cannot_publish() {
+        let capture = Capture::default();
+        capture.begin();
+        capture.unsupported();
+        let input = node("a");
+        capture.record(QueryRef::IsCycle(&input, false));
+        assert!(capture.finish().is_none());
+        capture.begin();
+        let huge = Node::SpanInfo { span_infos_index: 0, text: "x".repeat(FRAME_LIMIT + 1) };
+        capture.record(QueryRef::SccRep(&huge, &huge));
+        assert!(capture.finish().is_none());
+        assert!(capture.finish().is_none());
+    }
+}
