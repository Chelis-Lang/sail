@@ -0,0 +1,564 @@
+//! Exact observed call-graph dependencies of one prepared lowering.
+use crate::ast::Fun;
+use crate::recursion::Node;
+use crate::scc::Graph;
+use std::collections::LinkedList;
+use std::io::Write;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+const LIMIT: usize = 16 * 1024 * 1024;
+const FRAME_LIMIT: usize = 1024 * 1024;
+static OWNED: AtomicUsize = AtomicUsize::new(0);
+static ENCODE: Mutex<()> = Mutex::new(());
+pub fn retained_bytes() -> usize {
+    OWNED.load(Ordering::Relaxed)
+}
+fn charge(bytes: usize) -> bool {
+    OWNED
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |old| {
+            old.checked_add(bytes).filter(|next| *next <= LIMIT)
+        })
+        .is_ok()
+}
+#[derive(Clone, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+pub enum Query {
+    SccRep(Node, Node),
+    IsCycle(Node, bool),
+    SccNodes(Node, Vec<Node>),
+    ShortestCycle(Node, Vec<Node>),
+    FunctionOrder(Vec<Fun>, Vec<Vec<Fun>>),
+}
+// Same variant order and field representation; borrowing avoids retained IR clones.
+#[derive(serde::Serialize)]
+pub enum QueryRef<'a> {
+    SccRep(&'a Node, &'a Node),
+    IsCycle(&'a Node, bool),
+    SccNodes(&'a Node, &'a [Node]),
+    ShortestCycle(&'a Node, &'a [Node]),
+    FunctionOrder(&'a [Fun], &'a [Vec<Fun>]),
+}
+struct Writer(Vec<u8>);
+impl Write for Writer {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        let needed = self
+            .0
+            .len()
+            .checked_add(bytes.len())
+            .ok_or_else(|| std::io::Error::other("graph dependency budget"))?;
+        if needed > FRAME_LIMIT {
+            return Err(std::io::Error::other("graph dependency budget"));
+        }
+        if needed > self.0.capacity() {
+            let next = needed.max(self.0.capacity().saturating_mul(2)).max(64).min(FRAME_LIMIT);
+            self.0.try_reserve_exact(next - self.0.len()).map_err(std::io::Error::other)?;
+        }
+        if self.0.capacity() > FRAME_LIMIT {
+            return Err(std::io::Error::other("graph dependency allocation budget"));
+        }
+        self.0.extend_from_slice(bytes);
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+struct Recording {
+    frames: LinkedList<Vec<u8>>,
+    bytes: usize,
+}
+fn release_after_drop<T>(owned: T, release: impl FnOnce()) {
+    drop(owned);
+    release();
+}
+impl Drop for Recording {
+    fn drop(&mut self) {
+        release_after_drop(std::mem::take(&mut self.frames), || {
+            OWNED.fetch_sub(self.bytes, Ordering::Relaxed);
+        });
+    }
+}
+#[derive(Default)]
+struct State {
+    active: bool,
+    recording: Option<Recording>,
+}
+#[derive(Clone)]
+pub struct Capture(Option<Arc<Mutex<State>>>);
+impl Drop for Capture {
+    fn drop(&mut self) {
+        if let Some(inner) = self.0.take() {
+            // into_inner consumes and deallocates the final Arc before returning
+            // its value. Only the final clone releases the capture allocation.
+            if let Some(state) = Arc::into_inner(inner) {
+                release_after_drop(state, || {
+                    OWNED.fetch_sub(128, Ordering::Relaxed);
+                });
+            }
+        }
+    }
+}
+impl Default for Capture {
+    fn default() -> Self {
+        Self(if charge(128) { Some(Arc::new(Mutex::new(State::default()))) } else { None })
+    }
+}
+pub struct Ledger {
+    frames: Vec<Vec<u8>>,
+    bytes: usize,
+}
+impl Ledger {
+    pub fn frames(&self) -> &[Vec<u8>] {
+        &self.frames
+    }
+}
+impl Drop for Ledger {
+    fn drop(&mut self) {
+        release_after_drop(std::mem::take(&mut self.frames), || {
+            OWNED.fetch_sub(self.bytes, Ordering::Relaxed);
+        });
+    }
+}
+impl Capture {
+    pub fn begin(&self) {
+        if let Some(inner) = &self.0 {
+            if let Ok(mut state) = inner.lock() {
+                state.active = true;
+                state.recording = Some(Recording { frames: LinkedList::new(), bytes: 0 });
+            }
+        }
+    }
+    pub fn unsupported(&self) {
+        if let Some(inner) = &self.0 {
+            if let Ok(mut state) = inner.lock() {
+                if state.active {
+                    state.recording = None;
+                }
+            }
+        }
+    }
+    pub fn record(&self, query: QueryRef<'_>) {
+        let Some(inner) = &self.0 else {
+            return;
+        };
+        let Ok(mut state) = inner.lock() else {
+            return;
+        };
+        if !state.active {
+            return;
+        }
+        let Some(recording) = &mut state.recording else {
+            return;
+        };
+        let Ok(_gate) = ENCODE.lock() else {
+            state.recording = None;
+            return;
+        };
+        let mut writer = Writer(Vec::new());
+        if bincode_next::serde::encode_into_std_write(
+            &query,
+            &mut writer,
+            bincode_next::config::legacy(),
+        )
+        .is_err()
+        {
+            state.recording = None;
+            return;
+        }
+        let bytes = writer.0.capacity().saturating_add(64);
+        if !charge(bytes) {
+            state.recording = None;
+            return;
+        }
+        recording.bytes = recording.bytes.saturating_add(bytes);
+        recording.frames.push_back(writer.0);
+    }
+    pub fn finish(&self) -> Option<Ledger> {
+        let mut state = self.0.as_ref()?.lock().ok()?;
+        if !state.active {
+            return None;
+        }
+        state.active = false;
+        let mut recording = state.recording.take()?;
+        // Conversion metadata cannot overlap another conversion or frame encoder.
+        let _gate = ENCODE.lock().ok()?;
+        let mut frames = Vec::new();
+        frames.try_reserve_exact(recording.frames.len()).ok()?;
+        let metadata = frames.capacity().checked_mul(std::mem::size_of::<Vec<u8>>())?;
+        let bytes = recording.bytes.checked_add(metadata)?;
+        if !charge(metadata) {
+            return None;
+        }
+        while let Some(frame) = recording.frames.pop_front() {
+            frames.push(frame);
+        }
+        recording.bytes = 0;
+        Some(Ledger { frames, bytes })
+    }
+}
+// Decode the ledger under its own allocation cap before allocating an untrusted
+// frame vector. The surrounding portable SST decoder has a different budget.
+#[derive(serde::Serialize)]
+#[serde(transparent)]
+pub struct Frames(Vec<Vec<u8>>);
+impl Frames {
+    pub fn frames(&self) -> &[Vec<u8>] {
+        &self.0
+    }
+}
+impl<'de> serde::Deserialize<'de> for Frames {
+    fn deserialize<D: serde::Deserializer<'de>>(decoder: D) -> Result<Self, D::Error> {
+        struct FrameSeed(usize);
+        impl<'de> serde::de::DeserializeSeed<'de> for FrameSeed {
+            type Value = Vec<u8>;
+            fn deserialize<D: serde::Deserializer<'de>>(
+                self,
+                decoder: D,
+            ) -> Result<Vec<u8>, D::Error> {
+                struct FrameVisitor(usize);
+                impl<'de> serde::de::Visitor<'de> for FrameVisitor {
+                    type Value = Vec<u8>;
+                    fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+                        f.write_str("bounded graph frame")
+                    }
+                    fn visit_seq<S: serde::de::SeqAccess<'de>>(
+                        self,
+                        mut seq: S,
+                    ) -> Result<Vec<u8>, S::Error> {
+                        let count = seq
+                            .size_hint()
+                            .ok_or_else(|| serde::de::Error::custom("graph frame length"))?;
+                        if count > FRAME_LIMIT || count > self.0 {
+                            return Err(serde::de::Error::custom("graph frame limit"));
+                        }
+                        let mut frame = Vec::new();
+                        frame.try_reserve_exact(count).map_err(serde::de::Error::custom)?;
+                        if frame.capacity() > self.0 {
+                            return Err(serde::de::Error::custom("graph frame allocation"));
+                        }
+                        while let Some(byte) = seq.next_element::<u8>()? {
+                            if frame.len() >= count {
+                                return Err(serde::de::Error::custom("graph frame shape"));
+                            }
+                            frame.push(byte);
+                        }
+                        if frame.len() != count {
+                            return Err(serde::de::Error::custom("graph frame truncated"));
+                        }
+                        Ok(frame)
+                    }
+                }
+                decoder.deserialize_seq(FrameVisitor(self.0))
+            }
+        }
+        struct FramesVisitor;
+        impl<'de> serde::de::Visitor<'de> for FramesVisitor {
+            type Value = Frames;
+            fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+                f.write_str("bounded graph ledger")
+            }
+            fn visit_seq<S: serde::de::SeqAccess<'de>>(
+                self,
+                mut seq: S,
+            ) -> Result<Frames, S::Error> {
+                let count = seq
+                    .size_hint()
+                    .ok_or_else(|| serde::de::Error::custom("graph ledger length"))?;
+                if count > LIMIT / std::mem::size_of::<Vec<u8>>() {
+                    return Err(serde::de::Error::custom("graph ledger count"));
+                }
+                let mut frames = Vec::new();
+                frames.try_reserve_exact(count).map_err(serde::de::Error::custom)?;
+                let mut remaining = LIMIT
+                    .checked_sub(frames.capacity() * std::mem::size_of::<Vec<u8>>())
+                    .ok_or_else(|| serde::de::Error::custom("graph ledger allocation"))?;
+                while let Some(frame) = seq.next_element_seed(FrameSeed(remaining))? {
+                    if frames.len() >= count {
+                        return Err(serde::de::Error::custom("graph ledger shape"));
+                    }
+                    remaining = remaining
+                        .checked_sub(frame.capacity())
+                        .ok_or_else(|| serde::de::Error::custom("graph ledger limit"))?;
+                    frames.push(frame);
+                }
+                if frames.len() != count {
+                    return Err(serde::de::Error::custom("graph ledger truncated"));
+                }
+                Ok(Frames(frames))
+            }
+        }
+        decoder.deserialize_seq(FramesVisitor)
+    }
+}
+
+// Full graph order is preserved. Empty components have no lowering effects.
+pub fn function_order(graph: &Graph<Node>, sccs: &[Node], functions: &[Fun]) -> Vec<Vec<Fun>> {
+    let mut groups = Vec::new();
+    for rep in sccs {
+        let group = graph
+            .get_scc_nodes(rep)
+            .into_iter()
+            .filter_map(|node| match node {
+                Node::Fun(fun) if functions.contains(&fun) => Some(fun),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        if !group.is_empty() {
+            groups.push(group);
+        }
+    }
+    groups
+}
+pub fn validate(
+    frames: &[Vec<u8>],
+    graph: &Graph<Node>,
+    sccs: &[Node],
+) -> Result<(), &'static str> {
+    let mut bytes =
+        frames.len().checked_mul(std::mem::size_of::<Vec<u8>>()).ok_or("ledger-limit")?;
+    let mut order_queries = 0;
+    for frame in frames {
+        bytes = bytes.checked_add(frame.capacity()).ok_or("ledger-limit")?;
+        if bytes > LIMIT || frame.len() > FRAME_LIMIT {
+            return Err("ledger-limit");
+        }
+        let (query, used): (Query, usize) = bincode_next::serde::decode_from_slice(
+            frame,
+            bincode_next::config::legacy().with_limit::<1048576>(),
+        )
+        .map_err(|_| "ledger-shape")?;
+        if used != frame.len() {
+            return Err("ledger-trailing");
+        }
+        let matching = match query {
+            Query::SccRep(input, expected) => {
+                graph.contains_node(&input) && graph.get_scc_rep(&input) == expected
+            }
+            Query::IsCycle(input, expected) => {
+                graph.contains_node(&input) && graph.node_is_in_cycle(&input) == expected
+            }
+            Query::SccNodes(input, expected) => {
+                graph.contains_node(&input) && graph.get_scc_nodes(&input) == expected
+            }
+            Query::ShortestCycle(input, expected) => {
+                graph.contains_node(&input)
+                    && graph.node_is_in_cycle(&input)
+                    && graph.shortest_cycle_back_to_self(&input) == expected
+            }
+            Query::FunctionOrder(input, expected) => {
+                order_queries += 1;
+                function_order(graph, sccs, &input) == expected
+            }
+        };
+        if !matching {
+            return Err("graph-answer-changed");
+        }
+    }
+    if order_queries != 1 {
+        return Err("ledger-coverage");
+    }
+    Ok(())
+}
