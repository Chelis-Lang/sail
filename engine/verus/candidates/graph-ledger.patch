+pub(super) fn take_bucket(key: &str, krate:&Krate, source_map:Option<&SourceMap>, ctx: &mut vir::context::Ctx) -> Option<(vir::sst::KrateSst,Messages)> {
+    if !active() || !CACHING.load(Ordering::Relaxed) { return None; }
+    let _gate=PREPARATION_GATE.lock().ok()?;
+    MISSES.fetch_add(1,Ordering::Relaxed);
+    if key.is_empty(){return None;}
+    // One cache preparation operation and retained serialized buffer globally.
+    // Moving it out releases all cache ownership before allocating/decoding a miss.
+    let bytes=with_cache(|cache|cache.borrow_mut().bucket.take().filter(|(stored,_)|stored==key).map(|(_,entry)|entry.bytes));
+    let batch=bytes.is_some();
+    let bytes=match bytes.or_else(||read_disk(key)){Some(bytes)=>bytes,None=>return None};
+    let source_inventory=SOURCES.lock().ok()?.clone()?;
+    let _=source_map;
+    let bindings=current_bindings(krate,ctx)?;
+    let mut reader=std::io::Cursor::new(bytes.as_ref());
+    let portable:Portable=vir::messages::sail_resolve_spans(&bindings,||bincode_next::serde::decode_from_std_read(&mut reader,bincode_next::config::legacy().with_limit::<536870912>())).ok()?;
+    if portable.version!=3 || portable.key!=key {return None;}
+    if let Err(stage)=ctx.global.sail_validate_graph_reads(portable.graph_reads.frames()) {emit("prepared-miss",serde_json::json!({"stage":stage,"key":key}));return None;}
+    for (identity,expected) in &portable.bindings {
+        let Some(span)=bindings.get(identity)else{emit("prepared-miss",serde_json::json!({"stage":"span-binding","key":key}));return None;};
+        let Some(actual)=provenance(span,&source_inventory)else{emit("prepared-miss",serde_json::json!({"stage":"span-owner","key":key}));return None;};
+        if actual.as_str()!=expected {emit("prepared-miss",serde_json::json!({"stage":"span-provenance","key":key}));return None;}
+    }
+    if reader.position()!=bytes.len() as u64 {return None;}
+    // PREPARATION_GATE is still held; no decoded ledger survives its release.
+    drop(portable.graph_reads);
+    ctx.sail_restore_effects(portable.effects);
+    MISSES.fetch_sub(1,Ordering::Relaxed);
+    if batch {BATCH_HITS.fetch_add(1,Ordering::Relaxed);}else{PERSISTENT_HITS.fetch_add(1,Ordering::Relaxed);}
+    emit("prepared-restored",serde_json::json!({"source":if batch{"batch"}else{"persistent"},"bytes":bytes.len()}));
+    Some((portable.sst,portable.messages.into_iter().map(|(message,level,immediate)|(Arc::new(message) as ArcDynMessage,level,immediate)).collect()))
+}
+pub(super) fn store_bucket(key: String, graph_reads:vir::sail_graph::Ledger, sst: &vir::sst::KrateSst, ctx: &vir::context::Ctx, source_map:Option<&SourceMap>, messages: std::cell::Ref<'_,Messages>) {
+    if key.is_empty() || !active() || !CACHING.load(Ordering::Relaxed) {emit("prepared-unavailable",serde_json::json!({"stage":"key"})); return; }
+    let Ok(_gate)=PREPARATION_GATE.lock()else{return;};
+    with_cache(|cache|cache.borrow_mut().bucket=None);
+    if ctx.fun.is_some(){return;}
+    let effects=vir::context::SailEffectsView(ctx);
+    if messages.len()>131072 {return;}
+    let Some(messages)=messages.iter().map(|(message,level,immediate)|Some((message.downcast_ref::<MessageX>()?,*level,*immediate))).collect::<Option<Vec<_>>>() else{return;};
+    let Some(source_inventory)=SOURCES.lock().ok().and_then(|sources|sources.clone()) else{emit("prepared-unavailable",serde_json::json!({"stage":"sources"}));return;};
+    let _=source_map;
+    let mut portable=PortableView {version:3,key:&key,bindings:Vec::new(),sst,graph_reads:graph_reads.frames(),effects,messages};
+    let mut writer=Bounded {bytes:Vec::new()};
+    let (encoded,bindings)=vir::messages::sail_collect_spans(||bincode_next::serde::encode_into_std_write(&portable,&mut writer,bincode_next::config::legacy()));
+    if let Err(error)=encoded {emit("prepared-unavailable",serde_json::json!({"stage":"serialize","reason":error.to_string()}));return;}
+    let Some(bindings)=bindings else{emit("prepared-unavailable",serde_json::json!({"stage":"bindings"}));return;};
+    let mut converted=Vec::new();let mut converted_bytes=0usize;
+    for (key,span) in bindings{
+        let Some(value)=provenance(&span,&source_inventory)else{emit("prepared-unavailable",serde_json::json!({"stage":"provenance"}));return;};
+        converted_bytes=converted_bytes.saturating_add(key.1.capacity().saturating_mul(8)).saturating_add(key.2.capacity()).saturating_add(value.capacity()).saturating_add(128);
+        if converted_bytes>16*1024*1024{return;}converted.push((key,value));
+    }
+    portable.bindings=converted;portable.bindings.sort_by(|a,b|a.0.cmp(&b.0));
+    writer.bytes.clear();
+    if bincode_next::serde::encode_into_std_write(&portable,&mut writer,bincode_next::config::legacy()).is_err(){return;}
+    let bytes:Arc<[u8]>=writer.bytes.into();
+    let charge=bytes.len().saturating_add(key.capacity()).saturating_add(std::mem::size_of::<Entry>()).saturating_add(256);
+    if charge>BUDGET {return;}
+    write_disk(&key,&bytes);
+    with_cache(|cache| cache.borrow_mut().bucket=Some((key,Entry {bytes,_charge:charge})));retained_charge();
+}
+fn disk_root()->Option<std::path::PathBuf>{std::env::var_os("SAIL_ENGINE_PREPARED_DIR").map(std::path::PathBuf::from)}
+fn read_disk(key:&str)->Option<Arc<[u8]>> {
+    let root=disk_root()?;let path=root.join(format!("{key}.prepared"));
+    let file=std::fs::File::open(&path).ok()?;
+    let metadata=file.metadata().ok()?;
+    if metadata.len()>(BUFFER_BUDGET+64) as u64 || metadata.len()<64 {return None;}
+    let size=usize::try_from(metadata.len()).ok()?;
+    let mut bytes=Vec::new();bytes.try_reserve_exact(size).ok()?;
+    if bytes.capacity()>BUFFER_BUDGET+64{return None;}
+    bytes.resize(size,0);let mut file=file;
+    file.read_exact(&mut bytes).ok()?;
+    let mut extra=[0u8;1];if file.read(&mut extra).ok()?!=0{return None;}
+    if bytes.len()>BUFFER_BUDGET+64 || bytes.len()<64 {return None;}
+    let (expected,body)=bytes.split_at(64);
+    let actual=Sha256::digest(body).iter().map(|byte|format!("{byte:02x}")).collect::<String>();
+    if expected!=actual.as_bytes(){return None;}
+    Some(Arc::from(body))
+}
+fn write_disk(key:&str,bytes:&[u8]) {
+    let Some(root)=disk_root() else{return;};
+    if std::fs::create_dir_all(&root).is_err(){return;}
+    let Ok(lock)=std::fs::OpenOptions::new().create(true).read(true).write(true).truncate(false).open(root.join("cache.lock")) else{return;};
+    if lock.lock().is_err(){return;}
+    // Reserve temporary bytes under the same lock; count both committed and abandoned
+    // temporary buffers. Never retain a per-entry independent 512 MiB allowance.
+    let files=std::fs::read_dir(&root).into_iter().flatten().flatten().filter(|entry|entry.file_name()!="cache.lock").take(4097).collect::<Vec<_>>();
+    if files.len()>4096{return;}
+    let total=files.iter().filter_map(|entry|entry.metadata().ok().map(|metadata|metadata.len())).fold(0u64,u64::saturating_add);
+    if total.saturating_add(bytes.len() as u64+64)>BUDGET as u64 {for entry in files {let _=std::fs::remove_file(entry.path());}}
+    let remaining=std::fs::read_dir(&root).into_iter().flatten().flatten().filter(|entry|entry.file_name()!="cache.lock").filter_map(|entry|entry.metadata().ok().map(|metadata|metadata.len())).fold(0u64,u64::saturating_add);
+    if remaining.saturating_add(bytes.len() as u64+64)>BUDGET as u64 {return;}
+    let digest=Sha256::digest(bytes).iter().map(|byte|format!("{byte:02x}")).collect::<String>();
+    let temporary=root.join(format!("{key}.{}.tmp",std::process::id()));
+    if let Ok(mut file)=std::fs::File::create(&temporary) {if file.write_all(digest.as_bytes()).and_then(|()|file.write_all(bytes)).is_ok(){let _=std::fs::rename(&temporary,root.join(format!("{key}.prepared")));}}
+    let _=std::fs::remove_file(temporary);
+}
+pub(super) struct RecordingReporter<'a,T> { reporter: &'a T, messages: RefCell<Messages>,charge:Cell<u64>,valid:Cell<bool> }
+impl<'a,T:Diagnostics> RecordingReporter<'a,T> {
+    pub fn new(reporter:&'a T)->Self{Self{reporter,messages:RefCell::new(Vec::new()),charge:Cell::new(0),valid:Cell::new(true)}}
+    pub fn messages(&self)->std::cell::Ref<'_,Messages>{self.messages.borrow()}
+    pub fn cacheable(&self)->bool{self.valid.get()}
+}
+impl<T> Drop for RecordingReporter<'_,T>{fn drop(&mut self){REPORT_BYTES.fetch_sub(self.charge.get(),Ordering::Relaxed);}}
+fn message_charge(msg:&ArcDynMessage)->Option<u64>{
+    let msg=msg.downcast_ref::<MessageX>()?;
+    fn span_charge(span:&vir::messages::Span)->Option<usize>{
+        let raw=(&*span.raw_span) as &(dyn std::any::Any+Send+Sync);
+        let raw_size=if raw.is::<()>(){0}else if raw.is::<rustc_span::SpanData>(){std::mem::size_of::<rustc_span::SpanData>()}else{return None;};
+        Some(span.data.capacity().checked_mul(8)?.checked_add(span.as_string.capacity())?.checked_add(raw_size)?.checked_add(64)?)
+    }
+    // Count reachable allocations even when the original reporter releases its Arc.
+    // Duplicate/shared spans are deliberately overcharged; unknown raw owners miss.
+    let mut charge=std::mem::size_of::<MessageX>().checked_add(128)?.checked_add(msg.note.capacity())?
+        .checked_add(msg.spans.capacity().checked_mul(std::mem::size_of::<vir::messages::Span>())?)?
+        .checked_add(msg.labels.capacity().checked_mul(std::mem::size_of::<vir::messages::MessageLabel>())?)?
+        .checked_add(msg.help.capacity().checked_mul(std::mem::size_of::<String>())?)?;
+    if let Some(note)=&msg.fancy_note{charge=charge.checked_add(note.capacity())?;}
+    for span in &msg.spans{charge=charge.checked_add(span_charge(span)?)?;}
+    for label in &msg.labels{charge=charge.checked_add(label.note.capacity())?.checked_add(span_charge(&label.span)?)?;}
+    for help in &msg.help{charge=charge.checked_add(help.capacity())?;}
+    u64::try_from(charge).ok()
+}
+fn admit_message(msg:&ArcDynMessage)->Option<u64>{
+    let charge=message_charge(msg)?;
+    REPORT_BYTES.fetch_update(Ordering::Relaxed,Ordering::Relaxed,|used|used.checked_add(charge).filter(|used|*used<=16*1024*1024)).ok()?;
+    Some(charge)
+}
+impl<T:Diagnostics> RecordingReporter<'_,T> {
+    fn record(&self,msg:&ArcDynMessage,level:MessageLevel,immediate:Emission){
+        if CACHING.load(Ordering::Relaxed) && self.valid.get(){
+            if let Some(charge)=admit_message(msg){
+                self.charge.set(self.charge.get()+charge);self.messages.borrow_mut().push((msg.clone(),level,immediate));retained_charge();
+            }else{self.valid.set(false);}
+        }
+    }
+}
+impl<T:Diagnostics> air::messages::Diagnostics for RecordingReporter<'_,T> {
