+// Encode complete typed lookup entries. Ordering belongs only to ordered IR,
+// vectors and graph edges; these tables are consumed by keyed lookup.
+const SAIL_KEY_LIMIT:usize=32*1024*1024;
+struct SailKeyWriter(Vec<u8>);
+impl std::io::Write for SailKeyWriter {
+    fn write(&mut self,bytes:&[u8])->std::io::Result<usize>{
+        let needed=self.0.len().checked_add(bytes.len()).ok_or_else(||std::io::Error::other("prepared key budget"))?;
+        if needed>SAIL_KEY_LIMIT{return Err(std::io::Error::other("prepared key budget"));}
+        // Small lookup entries must not each reserve a page; capacity remains charged.
+        if needed>self.0.capacity(){let capacity=needed.max(self.0.capacity().saturating_mul(2)).max(64).min(SAIL_KEY_LIMIT);self.0.try_reserve_exact(capacity-self.0.len()).map_err(std::io::Error::other)?;}
+        if self.0.capacity()>SAIL_KEY_LIMIT{return Err(std::io::Error::other("prepared key allocation budget"));}
+        self.0.extend_from_slice(bytes);Ok(bytes.len())
+    }
+    fn flush(&mut self)->std::io::Result<()>{Ok(())}
+}
+pub fn sail_encode<T:serde::Serialize>(value:&T)->Option<Vec<u8>> {
+    let mut out=SailKeyWriter(Vec::new());
