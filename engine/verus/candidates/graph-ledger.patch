+fn sail_map<K:serde::Serialize,V:serde::Serialize>(map:&HashMap<K,V>,budget:&mut usize)->Option<Vec<(Vec<u8>,Vec<u8>)>> {
+    let overhead=map.len().checked_mul(std::mem::size_of::<(Vec<u8>,Vec<u8>)>())?;
+    *budget=budget.checked_add(overhead)?;if *budget>SAIL_KEY_LIMIT{return None;}
+    let mut entries=Vec::new();entries.try_reserve_exact(map.len()).ok()?;
+    for (key,value) in map {let key=sail_encode(key)?;let value=sail_encode(value)?;
+        *budget=budget.checked_add(key.capacity())?.checked_add(value.capacity())?;
+        if *budget>SAIL_KEY_LIMIT{return None;}entries.push((key,value));}
+    entries.sort();Some(entries)
+}
+fn sail_set<K:serde::Serialize>(set:&HashSet<K>,budget:&mut usize)->Option<Vec<Vec<u8>>> {
+    *budget=budget.checked_add(set.len().checked_mul(std::mem::size_of::<Vec<u8>>())?)?;if *budget>SAIL_KEY_LIMIT{return None;}
+    let mut entries=Vec::new();entries.try_reserve_exact(set.len()).ok()?;
+    for key in set {let value=sail_encode(key)?;*budget=budget.checked_add(value.capacity())?;
+        if *budget>SAIL_KEY_LIMIT{return None;}entries.push(value);}
+    entries.sort();Some(entries)
+}
