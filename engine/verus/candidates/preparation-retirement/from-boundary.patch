+#[cfg(test)] mod namespace_retirement_adapter_tests {
+    use super::*;
+    type GuardPause=(std::sync::mpsc::SyncSender<()>,std::sync::mpsc::Receiver<()>);
+    static GUARD_PAUSE:std::sync::Mutex<Option<GuardPause>>=std::sync::Mutex::new(None);
+    pub(super) fn pause_before_guard_retirement(){
+        let pause=GUARD_PAUSE.lock().unwrap().take();
+        if let Some((started,resume))=pause{let _=started.send(());let _=resume.recv();}
+    }
+    #[test]
+    fn actual_worker_adapter_retires_both_success_and_inner_refusal_before_return() {
+        rustc_data_structures::sync::set_dyn_thread_safe_mode(false);
+        assert!(rustc_data_structures::sync::check_dyn_thread_safe().is_none());
+        let map=SourceMap::new(rustc_span::source_map::FilePathMapping::empty());
+        for imported in [false,true] {
+            let sources=Arc::new(Sources(Vec::new(),0,std::sync::Mutex::new(ProvenanceMemo::default()),Err(crate::spans::sail_owned_imports::CaptureFailure::Missing)));
+            let (sender,receiver)=std::sync::mpsc::channel();
+            let (finished,result)=std::sync::mpsc::sync_channel(1);
+            let worker=std::thread::spawn(move || {
+                let _gate=PREPARATION_GATE.lock().unwrap();
+                let span=if imported {
+                    vir::messages::Span{raw_span:Arc::new(()),id:1,data:vec![1,2],as_string:"exact missing import".to_owned()}
+                }else{
+                    vir::messages::Span{raw_span:Arc::new(rustc_span::SpanData{lo:rustc_span::BytePos(0),hi:rustc_span::BytePos(0),ctxt:rustc_span::SyntaxContext::root(),parent:None}),id:0,data:Vec::new(),as_string:"no location".to_owned()}
+                };
+                let outcome=with_namespace(None,Some(&sender),&sources,|validate|validate(&span).map(|()|17));
+                finished.send(outcome).unwrap();
+            });
+            let (started,notice)=std::sync::mpsc::sync_channel(0);
+            let (resume,continue_service)=std::sync::mpsc::sync_channel(0);
+            *GUARD_PAUSE.lock().unwrap()=Some((started,continue_service));
+            // This peer always releases the pause before any assertion, so a
+            // counterfactual failure cannot strand the compiler or worker.
+            let observer=std::thread::spawn(move||{
+                notice.recv_timeout(std::time::Duration::from_secs(1)).unwrap();
+                let early=result.recv_timeout(std::time::Duration::from_millis(100));
+                let live=sail_namespace::active_bytes();
+                resume.send(()).unwrap();
+                (early,live,result)
+            });
+            let message=receiver.recv_timeout(std::time::Duration::from_secs(1)).unwrap();
+            let ReporterMessage::PreparationNamespace(request)=message else{panic!("expected only the existing prep queue request")};
+            serve_namespace(*request,&map);
+            let (early,live,result)=observer.join().unwrap();
+            worker.join().unwrap();
+            assert_eq!(sail_namespace::active_bytes(),0);
+            assert!(matches!(early,Err(std::sync::mpsc::RecvTimeoutError::Timeout)),"worker returned before compiler guard retirement");
+            assert_eq!(live,16*1024);
+            assert_eq!(result.recv_timeout(std::time::Duration::from_secs(1)).unwrap(),Some(if imported{None}else{Some(17)}));
+            map.new_source_file(rustc_span::FileName::Custom(format!("after-{imported}")),"abc".to_owned());
+        }
+    }
