+// Supplementary failure records share the existing import trace's record/byte
+// caps, mutex, admitted borrowed writer and sticky unavailable replacement.
+// These records describe a refusal, never fresh successful span authority.
+fn trace_namespace_inner<F,P>(phase:&str,encode:F,publish:P)->bool
+where F:FnOnce(&str,&mut ObservationWriter)->Result<(),serde_json::Error>,P:FnOnce(&[u8])->std::io::Result<()> {
+    let skipped=Cell::new(false);
+    observe_inner(phase,|phase,writer|{
+        if IMPORT_TRACE_STOP.load(Ordering::Acquire){skipped.set(true);return Ok(());}
+        if IMPORT_TRACE_RECORDS.fetch_update(Ordering::AcqRel,Ordering::Acquire,|n|n.checked_add(1).filter(|n|*n<=4096)).is_err(){
+            IMPORT_TRACE_STOP.store(true,Ordering::Release);
+            return Err(serde::ser::Error::custom("namespace trace record cap"));
+        }
+        if let Err(error)=encode(phase,writer){IMPORT_TRACE_STOP.store(true,Ordering::Release);return Err(error);}
+        let bytes=writer.bytes.len().checked_add(1).ok_or_else(||<serde_json::Error as serde::ser::Error>::custom("namespace trace size"))?;
+        if bytes>32768 || IMPORT_TRACE_BYTES.fetch_update(Ordering::AcqRel,Ordering::Acquire,|used|used.checked_add(bytes).filter(|used|*used<=4*1024*1024-512)).is_err(){
+            IMPORT_TRACE_STOP.store(true,Ordering::Release);
+            return Err(serde::ser::Error::custom("namespace trace aggregate budget"));
+        }
+        Ok(())
+    },|bytes|if skipped.get(){Ok(())}else{publish(bytes)})
+}
+fn trace_namespace<F>(encode:F)
+where F:FnOnce(&str,&mut ObservationWriter)->Result<(),serde_json::Error> {
+    if !active() || std::env::var("SAIL_ENGINE_IMPORT_TRACE").as_deref()!=Ok("1"){return;}
+    let phase=if FOCUS.load(Ordering::Relaxed){"focus"}else{"full"};
+    trace_namespace_inner(phase,encode,|bytes|{
+        let path=std::env::var_os("SAIL_ENGINE_EVENTS").ok_or_else(||std::io::Error::other("observation path unavailable"))?;
+        let mut out=std::fs::OpenOptions::new().create(true).append(true).open(path)?;out.write_all(bytes)
+    });
+}
+fn namespace_span_fields(span:&vir::messages::Span,phase:&str,writer:&mut ObservationWriter)->Result<(),serde_json::Error>{
+    if span.as_string.len()>4096 || span.data.len()>4096{return Err(serde::ser::Error::custom("namespace trace span budget"));}
+    let raw=&*span.raw_span as &(dyn std::any::Any+Send+Sync);
+    let kind=if raw.is::<rustc_span::SpanData>(){"SpanData"}else if raw.is::<()>(){"unit"}else{"unknown"};
+    serde_json::to_writer(writer,&Observation {version:1,phase,event:"preparation-namespace-refused",payload:Fields(fields!(
+        "boundary":"worker-binding","id":span.id,"data":&span.data,"as_string":&span.as_string,"raw_kind":kind
+    ))})
+}
+fn trace_namespace_span(span:&vir::messages::Span){
+    trace_namespace(|phase,writer|namespace_span_fields(span,phase,writer));
+}
+fn namespace_validation(sources:&Sources,words:[u64;2],files:&[Arc<rustc_span::SourceFile>])->bool {
+    let result=match &sources.3 {Ok(imports)=>imports.validate_binding_files(words,files),Err(reason)=>Err(*reason)};
+    if let Err(reason)=result {
+        trace_namespace(|phase,writer|{
+            let record=sources.3.as_ref().ok().and_then(|imports|imports.record(words).ok());
+            let role=record.map(|record|match &record.state {
+                crate::spans::sail_owned_imports::State::Pending(_)=>"Pending",
+                crate::spans::sail_owned_imports::State::Loaded(_)=>"LoadedForeign",
+                crate::spans::sail_owned_imports::State::Deferred(_)=>"DeferredForeign",
+                crate::spans::sail_owned_imports::State::OriginalDescriptor(_)=>"OriginalDescriptor",
+                crate::spans::sail_owned_imports::State::Unavailable(_)=>"Unavailable",
+            });
+            // Only a bounded current namespace is scanned, under the exact
+            // same files guard as the unchanged validator. No file is cloned.
+            let matches=if files.len()>4096{None}else{record.map(|record|files.iter().filter(|file|matches!(*file.external_src.borrow(),rustc_span::ExternalSource::Foreign{..})&&file.src_hash.hash_bytes()==&record.expected_hash[..usize::from(record.expected_hash_len)]).count())};
+            serde_json::to_writer(writer,&Observation {version:1,phase,event:"preparation-namespace-refused",payload:Fields(fields!(
+                "boundary":"compiler-validation","words":words,"reason":ObservedDebug(&reason),
+                "classification_role":role,"classification_is_frozen":true,"current_files_len":files.len(),
+                "current_foreign_expected_hash_matches":matches
+            ))})
+        });
+    }
+    result.is_ok()
+}
+fn trace_namespace_admission(reason:&'static str){
+    trace_namespace(|phase,writer|serde_json::to_writer(writer,&Observation {version:1,phase,event:"preparation-namespace-refused",payload:Fields(fields!(
+        "boundary":"service-admission","reason":reason,"retained_control_bytes":sail_namespace::retained_bytes()
+    ))}));
+}
