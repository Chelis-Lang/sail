+// Stream the actual complete constructor authority in the already audited
+// record order. No metadata/path clone, SourceMap registration or file I/O.
+fn complete_namespace_digest(crate_id: u64, records: &[Record], originals: &HashMap<Vec<u8>, FileStartEndPos>) -> Option<[u8; 32]> {
+    if records.is_empty() || records.len() != originals.len() || records.len() > RECORD_LIMIT { return None; }
+    let mut hash = Sha256::new();
+    hash.update(b"sail-complete-original-namespace/v1");
+    hash.update(crate_id.to_le_bytes());
+    hash.update((records.len() as u64).to_le_bytes());
+    for record in records {
+        let key = &record.expected_hash[..usize::from(record.expected_hash_len)];
+        let original = originals.get(key)?;
+        if original.start_pos != record.original_start || original.end_pos != record.original_end { return None; }
+        hash.update(record.original_start.to_le_bytes());
+        hash.update(record.original_end.to_le_bytes());
+        hash.update([record.expected_hash_len]);
+        hash.update(key);
+        match &original.filename {
+            None => hash.update([0]),
+            Some(path) => {
+                let spelling = path.as_os_str().as_encoded_bytes();
+                if spelling.len() > NAME_LIMIT { return None; }
+                hash.update([1]);
+                hash.update((spelling.len() as u64).to_le_bytes());
+                hash.update(spelling);
+            }
+        }
+    }
+    Some(hash.finalize().into())
 }
 
