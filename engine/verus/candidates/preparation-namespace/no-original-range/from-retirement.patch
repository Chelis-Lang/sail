+fn complete_known_namespace_absence_matches_stock_none_without_new_coordinates() {
+    session(|| {
+        let map = SourceMap::new(FilePathMapping::empty());
+        let file = imported(&map, "dep.rs", "abcdefgh", 2);
+        let (context, metadata) = fixture(&file);
+        let owner =
+            sail_capture_loaded_imports(&context.imported_crates, &metadata, &map, crate_id)
+                .unwrap();
+        let gap = packed(900, 905);
+        assert_eq!(owner.record(gap).err(), Some(CaptureFailure::UnknownCrate));
+        assert!(owner.no_original_range(gap).is_ok());
+        assert!(context.unpack_span(&gap.to_vec(), Some(&map)).is_none());
+        assert!(owner.current_range(gap).is_err());
+        assert!(
+            owner
+                .validate_no_original_range_files(gap, &map.files())
+                .is_ok()
+        );
