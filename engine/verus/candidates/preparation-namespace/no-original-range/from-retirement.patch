 impl OwnedImportMappings {
+    /// Explicit stock absence role, not a conversion of an arbitrary error.
+    /// The actual current raw-unit/SailSpanKey binding is checked by the caller.
+    /// This supplies neither source contents nor coordinates or a loader recipe.
+    pub(crate) fn no_original_range(&self, packed: [u64; 2]) -> Result<&[u8; 32], CaptureFailure> {
+        if (packed[1] as u32) < (packed[1] >> 32) as u32 { return Err(CaptureFailure::InvalidRange); }
+        let mut known = self.records.iter().filter(|record| record.crate_id == packed[0]);
+        let first = known.next().ok_or(CaptureFailure::UnknownCrate)?;
+        if matches!(first.state, State::Pending(_)) { return Err(CaptureFailure::Unclassified); }
+        let digest = first.complete_original_namespace.as_ref().ok_or(CaptureFailure::IncompleteOriginalNamespace)?;
+        let lo = (packed[1] >> 32) as u32;
+        if first.original_start <= lo && lo <= first.original_end { return Err(CaptureFailure::OriginalRangePresent); }
+        for record in known {
+            if matches!(record.state, State::Pending(_)) { return Err(CaptureFailure::Unclassified); }
+            if record.complete_original_namespace.as_ref() != Some(digest) { return Err(CaptureFailure::IncompleteOriginalNamespace); }
+            if record.original_start <= lo && lo <= record.original_end { return Err(CaptureFailure::OriginalRangePresent); }
+        }
+        Ok(digest)
+    }
+
+    /// The explicit absence role retains the existing whole-namespace work cap.
+    pub(crate) fn validate_no_original_range_files(&self, packed: [u64; 2], files: &[std::sync::Arc<rustc_span::SourceFile>]) -> Result<(), CaptureFailure> {
+        if files.len() > RECORD_LIMIT { return Err(CaptureFailure::Budget); }
+        self.no_original_range(packed).map(|_| ())
+    }
