+            let span = vir::messages::Span {
+                raw_span: raw,
+                id: 17,
+                data: packed(1002, 1006).to_vec(),
+                as_string: "exact current spelling".into(),
+            };
+            let result = crate::verifier::sail_test_import_provenance(&span, owner);
