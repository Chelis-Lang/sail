+                    },
+                    crate::spans::sail_owned_imports::State::OriginalDescriptor(locator)=>{
+                        serde_json::to_writer(&mut *writer,&Observation {version:1,phase,event:"import-authority-state",payload:Fields(fields!(
+                            "authority_phase":"late-handoff","id":span.id,"words":packed,"as_string":&span.as_string,"eligible":imports.original_descriptor(packed).is_ok(),
