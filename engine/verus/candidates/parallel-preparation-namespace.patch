+                data: packed(1002, 1006).to_vec(),
+                as_string: "same exact current binding".into(),
+            };
+            crate::verifier::sail_test_import_provenance(&span, mapping).unwrap()
+        }
+        let original = fingerprint(0, "dep.rs", "abcdefgh");
+        assert_eq!(fingerprint(25, "dep.rs", "abcdefgh"), original);
+        assert_ne!(fingerprint(25, "changed.rs", "abcdefgh"), original);
+        assert_ne!(fingerprint(25, "dep.rs", "abcdXfgh"), original);
+        assert_ne!(fingerprint(25, "dep.rs", "abcdefghZ"), original);
+    });
+}
