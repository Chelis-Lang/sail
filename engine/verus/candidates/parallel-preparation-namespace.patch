+    #[test]
+    fn real_span_binding_message_sst_and_big_integer_schema_roundtrips() {
+        let span = Span {
+            raw_span: Arc::new(()),
+            id: 17,
+            data: vec![29, 31],
+            as_string: "exact α span".to_owned(),
+        };
+        let message = crate::messages::error(&span, "owned diagnostic α");
+        let bindings = vec![(
+            (span.id, span.data.clone(), span.as_string.clone()),
+            "a".repeat(64),
+        )];
+        let sst: KrateSst = Arc::new(KrateSstX {
+            functions: Vec::new(),
+            datatypes: Vec::new(),
+            opaque_types: Vec::new(),
+            traits: Vec::new(),
+            trait_impls: Vec::new(),
+            assoc_type_impls: Vec::new(),
+            reveal_groups: Vec::new(),
+        });
+        let value = (
+            bindings,
+            message.as_ref(),
+            sst,
+            BigInt::from(-32767),
+            BigUint::from(65537u64),
+        );
+        let bytes =
+            bincode_next::serde::encode_to_vec(&value, bincode_next::config::legacy()).unwrap();
+        type Restored = (
+            Vec<(crate::messages::SailSpanKey, String)>,
+            MessageX,
+            KrateSst,
+            BigInt,
+            BigUint,
+        );
+        let (restored, used) = decode::<Restored>(&bytes, LIMIT).unwrap();
+        assert_eq!(used, bytes.len());
+        assert_eq!(restored.0, value.0);
+        assert_eq!(restored.1.note, value.1.note);
+        assert_eq!(restored.1.spans[0].data, span.data);
+        assert_eq!(restored.1.spans[0].as_string, span.as_string);
+        assert_eq!(restored.3, value.3);
+        assert_eq!(restored.4, value.4);
+        assert!(decode::<Restored>(&bytes, 256).is_err());
+    }
+}
