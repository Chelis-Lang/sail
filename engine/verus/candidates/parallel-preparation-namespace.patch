+//! Run-local conservative allocation admission for the audited prepared serde schema.
+//! No quota is released during decoding: overwritten values, growth copies and
+//! failed visitors remain overcharged until the entire decode transaction ends.
+use serde::de::{
+    self, DeserializeSeed, Deserializer, EnumAccess, MapAccess, SeqAccess, VariantAccess, Visitor,
+};
+use std::any::type_name;
+use std::cell::Cell;
+use std::fmt;
+use std::mem::size_of;
+mod schema {
+    include!("sail_decode_schema.rs");
+}
+
+pub const LIMIT: usize = 128 * 1024 * 1024;
+const DEPTH: usize = 128;
+const OVERHEAD: usize = 128;
+const GROWTH: usize = 8;
+pub struct Budget {
+    remaining: Cell<usize>,
+}
+impl Default for Budget {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+impl Budget {
+    pub fn new() -> Self {
+        Self::with_limit(LIMIT)
+    }
+    pub fn with_limit(limit: usize) -> Self {
+        Self {
+            remaining: Cell::new(limit),
+        }
+    }
+    pub(crate) fn charge<E: de::Error>(&self, bytes: usize) -> Result<(), E> {
+        let remaining = self
+            .remaining
+            .get()
+            .checked_sub(bytes)
+            .ok_or_else(|| E::custom("prepared decode allocation budget"))?;
+        self.remaining.set(remaining);
+        Ok(())
+    }
+    fn value<T, E: de::Error>(&self) -> Result<(), E> {
+        let bytes = size_of::<T>()
+            .checked_mul(GROWTH)
+            .and_then(|bytes| bytes.checked_add(OVERHEAD))
+            .ok_or_else(|| E::custom("prepared decode allocation overflow"))?;
+        self.charge(bytes)
+    }
+    fn bytes<E: de::Error>(&self, count: usize) -> Result<(), E> {
+        self.charge(
+            count
+                .checked_mul(GROWTH)
+                .and_then(|bytes| bytes.checked_add(OVERHEAD))
+                .ok_or_else(|| E::custom("prepared decode allocation overflow"))?,
+        )
+    }
+}
+#[derive(Clone, Copy)]
+struct Owner<'a> {
+    budget: &'a Budget,
+    depth: usize,
+    // Exact requested value whose INLINE storage was admitted. This is not
+    // authority for a transparent Arc/Box pointee of a different type.
+    paid: Option<&'static str>,
+    // Access is a fixed field of an audited paid derived/tuple/enum owner.
+    inline: bool,
+}
+impl Owner<'_> {
+    fn unowned(self) -> Self {
+        Self {
+            paid: None,
+            inline: false,
+            ..self
+        }
+    }
+    fn dispatch<'de, V: Visitor<'de>, E: de::Error>(self, fixed: bool) -> Result<Self, E> {
+        let name = type_name::<V::Value>();
+        let trusted = schema::visitor(name, type_name::<V>());
+        if !trusted || self.paid != Some(name) {
+            self.budget.value::<V::Value, E>()?;
+        }
+        Ok(Self {
+            paid: trusted.then_some(name),
+            inline: fixed && trusted,
+            ..self
+        })
+    }
+    fn descend<E: de::Error>(self) -> Result<Self, E> {
+        if self.depth >= DEPTH {
+            return Err(E::custom("prepared decode nesting budget"));
+        }
+        Ok(Self {
+            depth: self.depth + 1,
+            ..self
+        })
+    }
+}
+pub struct Guard<'a, D> {
+    inner: D,
+    owner: Owner<'a>,
+}
+impl<'a, D> Guard<'a, D> {
+    pub fn new(inner: D, budget: &'a Budget) -> Self {
+        Self {
+            inner,
+            owner: Owner {
+                budget,
+                depth: 0,
+                paid: None,
+                inline: false,
+            },
+        }
+    }
+}
+struct Seed<'a, S> {
+    inner: S,
+    owner: Owner<'a>,
+}
+impl<'de, S: DeserializeSeed<'de>> DeserializeSeed<'de> for Seed<'_, S> {
+    type Value = S::Value;
+    fn deserialize<D: Deserializer<'de>>(self, inner: D) -> Result<Self::Value, D::Error> {
+        let name = type_name::<S::Value>();
+        let known_seed = type_name::<S>()
+            .strip_prefix("core::marker::PhantomData<")
+            .and_then(|name| name.strip_suffix('>'))
+            == Some(name);
+        let inherited = known_seed && self.owner.inline && schema::value(name);
+        if !inherited {
+            self.owner.budget.value::<S::Value, D::Error>()?;
+        }
+        self.inner.deserialize(Guard {
+            inner,
+            owner: Owner {
+                paid: known_seed.then_some(name),
+                inline: false,
+                ..self.owner.descend()?
+            },
+        })
+    }
+}
+struct Checked<'a, V> {
+    inner: V,
+    owner: Owner<'a>,
+}
+macro_rules! scalar_visits { ($($name:ident:$ty:ty),* $(,)?) => {$ (
+    fn $name<E:de::Error>(self,value:$ty)->Result<Self::Value,E> { self.inner.$name(value) }
+)*}; }
+impl<'de, V: Visitor<'de>> Visitor<'de> for Checked<'_, V> {
+    type Value = V::Value;
+    fn expecting(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        self.inner.expecting(f)
+    }
+    scalar_visits!(visit_bool:bool,visit_i8:i8,visit_i16:i16,visit_i32:i32,visit_i64:i64,visit_i128:i128,visit_u8:u8,visit_u16:u16,visit_u32:u32,visit_u64:u64,visit_u128:u128,visit_f32:f32,visit_f64:f64,visit_char:char);
+    fn visit_unit<E: de::Error>(self) -> Result<Self::Value, E> {
+        self.inner.visit_unit()
+    }
+    fn visit_none<E: de::Error>(self) -> Result<Self::Value, E> {
+        self.inner.visit_none()
+    }
+    fn visit_str<E: de::Error>(self, value: &str) -> Result<Self::Value, E> {
+        self.owner.budget.bytes(value.len())?;
+        self.inner.visit_str(value)
+    }
+    fn visit_borrowed_str<E: de::Error>(self, value: &'de str) -> Result<Self::Value, E> {
+        self.owner.budget.bytes(value.len())?;
+        self.inner.visit_borrowed_str(value)
+    }
+    fn visit_string<E: de::Error>(self, _value: String) -> Result<Self::Value, E> {
+        Err(E::custom("prepared decoder unexpectedly allocated string"))
+    }
+    fn visit_bytes<E: de::Error>(self, value: &[u8]) -> Result<Self::Value, E> {
+        self.owner.budget.bytes(value.len())?;
+        self.inner.visit_bytes(value)
+    }
+    fn visit_borrowed_bytes<E: de::Error>(self, value: &'de [u8]) -> Result<Self::Value, E> {
+        self.owner.budget.bytes(value.len())?;
+        self.inner.visit_borrowed_bytes(value)
+    }
+    fn visit_byte_buf<E: de::Error>(self, _value: Vec<u8>) -> Result<Self::Value, E> {
+        Err(E::custom("prepared decoder unexpectedly allocated bytes"))
+    }
+    fn visit_some<D: Deserializer<'de>>(self, inner: D) -> Result<Self::Value, D::Error> {
+        self.inner.visit_some(Guard {
+            inner,
+            owner: self.owner.unowned().descend()?,
+        })
+    }
+    fn visit_newtype_struct<D: Deserializer<'de>>(self, inner: D) -> Result<Self::Value, D::Error> {
+        self.inner.visit_newtype_struct(Guard {
+            inner,
+            owner: self.owner.unowned().descend()?,
+        })
+    }
+    fn visit_seq<S: SeqAccess<'de>>(self, inner: S) -> Result<Self::Value, S::Error> {
+        self.inner.visit_seq(Sequence {
+            inner,
+            owner: self.owner,
+        })
+    }
+    fn visit_map<M: MapAccess<'de>>(self, inner: M) -> Result<Self::Value, M::Error> {
+        self.inner.visit_map(Mapping {
+            inner,
+            owner: self.owner.unowned(),
+        })
+    }
+    fn visit_enum<A: EnumAccess<'de>>(self, inner: A) -> Result<Self::Value, A::Error> {
+        self.inner.visit_enum(Enumeration {
+            inner,
+            owner: self.owner,
+        })
+    }
+}
+struct Sequence<'a, S> {
+    inner: S,
+    owner: Owner<'a>,
+}
+impl<'de, S: SeqAccess<'de>> SeqAccess<'de> for Sequence<'_, S> {
+    type Error = S::Error;
+    fn next_element_seed<T: DeserializeSeed<'de>>(
+        &mut self,
+        seed: T,
+    ) -> Result<Option<T::Value>, Self::Error> {
+        let remaining = self.inner.size_hint();
+        let value = self.inner.next_element_seed(Seed {
+            inner: seed,
+            owner: self.owner,
+        })?;
+        // bincode's serde access turns truncated element reads into None.
+        // A finite advertised remainder is an exact wire count, not a capacity hint.
+        if value.is_none() && remaining.is_some_and(|count| count != 0) {
+            return Err(de::Error::custom("prepared sequence truncated"));
+        }
+        Ok(value)
+    }
+    fn size_hint(&self) -> Option<usize> {
+        None
+    }
+}
+struct Mapping<'a, M> {
+    inner: M,
+    owner: Owner<'a>,
+}
+impl<'de, M: MapAccess<'de>> MapAccess<'de> for Mapping<'_, M> {
+    type Error = M::Error;
+    fn next_key_seed<K: DeserializeSeed<'de>>(
+        &mut self,
+        seed: K,
+    ) -> Result<Option<K::Value>, Self::Error> {
+        let remaining = self.inner.size_hint();
+        let value = self.inner.next_key_seed(Seed {
+            inner: seed,
+            owner: self.owner,
+        })?;
+        if value.is_none() && remaining.is_some_and(|count| count != 0) {
+            return Err(de::Error::custom("prepared map truncated"));
+        }
+        Ok(value)
+    }
+    fn next_value_seed<V: DeserializeSeed<'de>>(
+        &mut self,
+        seed: V,
+    ) -> Result<V::Value, Self::Error> {
+        self.inner.next_value_seed(Seed {
+            inner: seed,
+            owner: self.owner,
+        })
+    }
+    fn size_hint(&self) -> Option<usize> {
+        None
+    }
+}
+struct Enumeration<'a, A> {
+    inner: A,
+    owner: Owner<'a>,
+}
+struct Variant<'a, A> {
+    inner: A,
+    owner: Owner<'a>,
+}
+impl<'a, 'de, A: EnumAccess<'de>> EnumAccess<'de> for Enumeration<'a, A> {
+    type Error = A::Error;
+    type Variant = Variant<'a, A::Variant>;
+    fn variant_seed<V: DeserializeSeed<'de>>(
+        self,
+        seed: V,
+    ) -> Result<(V::Value, Self::Variant), Self::Error> {
+        let (value, inner) = self.inner.variant_seed(Seed {
+            inner: seed,
+            owner: self.owner,
+        })?;
+        Ok((
+            value,
+            Variant {
+                inner,
+                owner: self.owner,
+            },
+        ))
+    }
+}
+impl<'de, A: VariantAccess<'de>> VariantAccess<'de> for Variant<'_, A> {
+    type Error = A::Error;
+    fn unit_variant(self) -> Result<(), Self::Error> {
+        self.inner.unit_variant()
+    }
+    fn newtype_variant_seed<T: DeserializeSeed<'de>>(
+        self,
+        seed: T,
+    ) -> Result<T::Value, Self::Error> {
+        self.inner.newtype_variant_seed(Seed {
+            inner: seed,
+            owner: self.owner,
+        })
+    }
+    fn tuple_variant<V: Visitor<'de>>(
+        self,
+        count: usize,
+        visitor: V,
+    ) -> Result<V::Value, Self::Error> {
+        let owner = self.owner.dispatch::<V, Self::Error>(true)?;
+        self.inner.tuple_variant(
+            count,
+            Checked {
+                inner: visitor,
+                owner,
+            },
+        )
+    }
+    fn struct_variant<V: Visitor<'de>>(
+        self,
+        fields: &'static [&'static str],
+        visitor: V,
+    ) -> Result<V::Value, Self::Error> {
+        let owner = self.owner.dispatch::<V, Self::Error>(true)?;
+        self.inner.struct_variant(
+            fields,
+            Checked {
+                inner: visitor,
+                owner,
+            },
+        )
+    }
+}
+macro_rules! forward { ($($name:ident($fixed:expr;$($arg:ident:$ty:ty),*)),* $(,)?) => {$ (
+    fn $name<V:Visitor<'de>>(self,$($arg:$ty,)*visitor:V)->Result<V::Value,Self::Error>{
+        let owner = self.owner.dispatch::<V, Self::Error>($fixed)?;
+        self.inner.$name($($arg,)*Checked {inner:visitor,owner})
+    }
+)*}; }
+impl<'de, D: Deserializer<'de>> Deserializer<'de> for Guard<'_, D> {
+    type Error = D::Error;
+    forward!(deserialize_bool(false;),deserialize_i8(false;),deserialize_i16(false;),deserialize_i32(false;),deserialize_i64(false;),deserialize_i128(false;),deserialize_u8(false;),deserialize_u16(false;),deserialize_u32(false;),deserialize_u64(false;),deserialize_u128(false;),deserialize_f32(false;),deserialize_f64(false;),deserialize_char(false;),deserialize_str(false;),deserialize_bytes(false;),deserialize_option(false;),deserialize_unit(false;),deserialize_unit_struct(true;name:&'static str),deserialize_seq(false;),deserialize_tuple(true;count:usize),deserialize_tuple_struct(true;name:&'static str,count:usize),deserialize_map(false;),deserialize_struct(true;name:&'static str,fields:&'static [&'static str]),deserialize_enum(true;name:&'static str,variants:&'static [&'static str]),deserialize_identifier(false;));
