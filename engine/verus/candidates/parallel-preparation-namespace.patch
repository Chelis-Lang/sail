+    // before bincode can allocate; admission occurs before the visitor owns bytes.
+    fn deserialize_string<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, Self::Error> {
+        self.deserialize_str(visitor)
+    }
+    fn deserialize_byte_buf<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, Self::Error> {
+        self.deserialize_bytes(visitor)
+    }
+    fn deserialize_newtype_struct<V: Visitor<'de>>(
+        self,
+        name: &'static str,
+        visitor: V,
+    ) -> Result<V::Value, Self::Error> {
+        if name == "SailBoundedFrames/v1" {
+            if !schema::frames(type_name::<V::Value>(), type_name::<V>()) {
+                return Err(de::Error::custom("unaudited prepared graph frame owner"));
+            }
+            // Sole audited exception: Frames already admits every allocation
+            // before reserve, with <=1 MiB frames and <=16 MiB total capacity.
+            self.inner.deserialize_newtype_struct(name, visitor)
+        } else {
+            // Custom/newtype transitions do not inherit the outer inline owner.
+            self.owner.budget.value::<V::Value, Self::Error>()?;
+            self.inner.deserialize_newtype_struct(
+                name,
+                Checked {
+                    inner: visitor,
+                    owner: self.owner.unowned(),
