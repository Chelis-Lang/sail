+#[cfg(test)]
+mod ownership_tests {
+    use super::*;
+    use serde::{Deserialize, Serialize};
+    use std::sync::Arc;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    #[derive(Clone, Debug, Serialize, Deserialize)]
+    pub(super) struct Fixed {
+        a: u64,
+        b: u64,
+        c: u64,
+        d: u64,
+    }
+    #[derive(Debug, Serialize, Deserialize)]
+    pub(super) enum Envelope {
+        Empty,
+        Fixed(Fixed),
+        Tuple(u64, u64),
+        Nested(Vec<Vec<Fixed>>),
+        Arc(Arc<super::tests::Large>),
+        Box(Box<super::tests::Large>),
+    }
+    fn bytes<T: Serialize>(value: &T) -> Vec<u8> {
+        bincode_next::serde::encode_to_vec(value, bincode_next::config::legacy()).unwrap()
+    }
+    fn cost<T: serde::de::DeserializeOwned>(value: &[u8]) -> usize {
+        let budget = Budget::new();
+        struct Root<'a, T>(&'a Budget, std::marker::PhantomData<T>);
+        impl<'de, T: serde::Deserialize<'de>> DeserializeSeed<'de> for Root<'_, T> {
+            type Value = T;
+            fn deserialize<D: Deserializer<'de>>(self, decoder: D) -> Result<T, D::Error> {
+                T::deserialize(Guard::new(decoder, self.0))
+            }
+        }
+        let (_value, used) = bincode_next::serde::seed_decode_from_slice(
+            Root::<T>(&budget, std::marker::PhantomData),
+            value,
+            bincode_next::config::legacy(),
+        )
+        .unwrap();
+        assert_eq!(used, value.len());
+        LIMIT - budget.remaining.get()
+    }
+    #[test]
+    fn fixed_fields_inherit_inline_storage_but_root_values_are_admitted() {
+        let value = Fixed {
+            a: 1,
+            b: 2,
+            c: 3,
+            d: 4,
+        };
+        assert_eq!(
+            cost::<Fixed>(&bytes(&value)),
+            size_of::<Fixed>() * GROWTH + OVERHEAD
+        );
+        assert_eq!(
+            cost::<u64>(&bytes(&9u64)),
+            size_of::<u64>() * GROWTH + OVERHEAD
+        );
+        assert!(
+            decode::<Fixed>(&bytes(&value), size_of::<Fixed>() * GROWTH + OVERHEAD - 1).is_err()
+        );
+    }
+    #[test]
+    fn transparent_arc_and_box_require_pointee_admission() {
+        let value = super::tests::Large::Inline([7; 32]);
+        let encoded = bytes(&value);
+        let pointer_budget = size_of::<Arc<super::tests::Large>>() * GROWTH + OVERHEAD;
+        assert!(decode::<Arc<super::tests::Large>>(&encoded, pointer_budget).is_err());
+        assert!(decode::<Box<super::tests::Large>>(&encoded, pointer_budget).is_err());
+        let full = size_of::<super::tests::Large>() * GROWTH + OVERHEAD;
+        assert!(decode::<Arc<super::tests::Large>>(&encoded, full + 4096).is_ok());
+        assert!(decode::<Box<super::tests::Large>>(&encoded, full + 4096).is_ok());
+        let enclosed = Envelope::Arc(Arc::new(super::tests::Large::Inline([7; 32])));
+        let parent = size_of::<Envelope>() * GROWTH + OVERHEAD;
+        assert!(decode::<Envelope>(&bytes(&enclosed), parent + pointer_budget).is_err());
+        assert_eq!(cost::<Envelope>(&bytes(&enclosed)), parent + full);
+        let enclosed = Envelope::Box(Box::new(super::tests::Large::Inline([7; 32])));
+        assert!(decode::<Envelope>(&bytes(&enclosed), parent + pointer_budget).is_err());
+        let shared = Arc::new(super::tests::Large::Inline([7; 32]));
+        let collection = vec![shared; 257];
+        assert!(
+            decode::<Vec<Arc<super::tests::Large>>>(
+                &bytes(&collection),
+                257 * (pointer_budget + full) - 1
+            )
+            .is_err()
+        );
+        assert!(
+            decode::<Arc<u64>>(&bytes(&9u64), size_of::<u64>() * GROWTH + OVERHEAD - 1).is_err()
+        );
+    }
+    #[test]
+    fn enum_inline_variant_is_paid_once_but_dynamic_payload_growth_is_not_free() {
+        // Enum's largest inline variant owns both discriminant and fixed fields.
+        let fixed = Envelope::Fixed(Fixed {
+            a: 1,
+            b: 2,
+            c: 3,
+            d: 4,
+        });
+        let admitted = cost::<Envelope>(&bytes(&fixed));
+        assert_eq!(admitted, size_of::<Envelope>() * GROWTH + OVERHEAD);
+        assert_eq!(cost::<Envelope>(&bytes(&Envelope::Tuple(1, 2))), admitted);
+        let nested = Envelope::Nested(vec![
+            vec![
+                Fixed {
+                    a: 1,
+                    b: 2,
+                    c: 3,
+                    d: 4
+                };
+                257
+            ];
+            2
+        ]);
+        let growth = 2 * 257 * (size_of::<Fixed>() * GROWTH + OVERHEAD);
+        let measured = cost::<Envelope>(&bytes(&nested));
+        assert!(measured >= growth, "every inner element remains admitted");
+        assert!(decode::<Envelope>(&bytes(&nested), growth - 1).is_err());
+        assert!(
+            decode::<Vec<super::tests::Large>>(
+                &bytes(&vec![super::tests::Large::Inline([7; 32])]),
+                size_of::<super::tests::Large>()
+            )
+            .is_err()
+        );
+    }
+    #[test]
+    fn option_and_custom_newtype_transitions_keep_separate_admission() {
+        let encoded = bytes(&Some(Box::new(super::tests::Large::Inline([7; 32]))));
+        assert!(decode::<Option<Box<super::tests::Large>>>(&encoded, 512).is_err());
+        assert!(decode::<Option<Box<super::tests::Large>>>(&encoded, 128 * 1024).is_ok());
+    }
+    static CUSTOM: AtomicUsize = AtomicUsize::new(0);
+    struct Opaque;
+    impl<'de> Deserialize<'de> for Opaque {
+        fn deserialize<D: Deserializer<'de>>(decoder: D) -> Result<Self, D::Error> {
+            struct FakeKnownVisitor;
+            impl<'de> Visitor<'de> for FakeKnownVisitor {
+                type Value = Fixed;
+                fn expecting(&self, f: &mut fmt::Formatter) -> fmt::Result {
+                    f.write_str("opaque known return")
+                }
+                fn visit_seq<A: SeqAccess<'de>>(self, mut seq: A) -> Result<Fixed, A::Error> {
+                    CUSTOM.fetch_add(1, Ordering::SeqCst);
+                    Ok(Fixed {
+                        a: seq.next_element()?.unwrap(),
+                        b: seq.next_element()?.unwrap(),
+                        c: seq.next_element()?.unwrap(),
+                        d: seq.next_element()?.unwrap(),
+                    })
+                }
+            }
+            decoder
+                .deserialize_tuple(4, FakeKnownVisitor)
+                .map(|_| Opaque)
+        }
+    }
+    #[test]
+    fn custom_visitor_cannot_inherit_known_return_type_or_forge_schema_ownership() {
+        CUSTOM.store(0, Ordering::SeqCst);
+        let encoded = bytes(&Fixed {
+            a: 1,
+            b: 2,
+            c: 3,
+            d: 4,
+        });
+        let full = size_of::<Fixed>() * GROWTH + OVERHEAD;
+        assert!(decode::<Opaque>(&encoded, full - 1).is_err());
+        assert_eq!(CUSTOM.load(Ordering::SeqCst), 0);
+        let budget = Budget::new();
+        let owner = Owner {
+            budget: &budget,
+            depth: 0,
+            paid: Some(type_name::<Fixed>()),
+            inline: true,
+        };
+        struct CustomSeed;
+        impl<'de> DeserializeSeed<'de> for CustomSeed {
+            type Value = u64;
+            fn deserialize<D: Deserializer<'de>>(self, d: D) -> Result<u64, D::Error> {
+                u64::deserialize(d)
+            }
+        }
+        let (_value, _) = bincode_next::serde::seed_decode_from_slice(
+            Seed {
+                inner: CustomSeed,
+                owner,
+            },
+            &bytes(&7u64),
+            bincode_next::config::legacy(),
+        )
+        .unwrap();
+        assert_eq!(
+            LIMIT - budget.remaining.get(),
+            2 * (size_of::<u64>() * GROWTH + OVERHEAD)
+        );
+    }
+    #[test]
+    fn graph_tag_alone_cannot_bypass_admission_for_a_custom_newtype() {
+        static ENTERED: AtomicUsize = AtomicUsize::new(0);
+        struct Forged;
+        impl<'de> Deserialize<'de> for Forged {
+            fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+                struct ForgedVisitor;
+                impl<'de> Visitor<'de> for ForgedVisitor {
+                    type Value = Forged;
+                    fn expecting(&self, f: &mut fmt::Formatter) -> fmt::Result {
+                        f.write_str("forged graph tag")
+                    }
+                    fn visit_newtype_struct<D: Deserializer<'de>>(
+                        self,
+                        _: D,
+                    ) -> Result<Forged, D::Error> {
+                        ENTERED.fetch_add(1, Ordering::SeqCst);
+                        Ok(Forged)
+                    }
+                }
+                d.deserialize_newtype_struct("SailBoundedFrames/v1", ForgedVisitor)
+            }
+        }
+        ENTERED.store(0, Ordering::SeqCst);
+        assert!(decode::<Forged>(&[], LIMIT).is_err());
+        assert_eq!(ENTERED.load(Ordering::SeqCst), 0);
+    }
+}
