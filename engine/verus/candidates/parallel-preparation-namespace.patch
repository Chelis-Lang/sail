+fn crate_id(cnum: CrateNum) -> u64 {
+    if cnum == CrateNum::new(2) { 7 } else { 8 }
+}
+fn packed(lo: u32, hi: u32) -> [u64; 2] {
+    [7, (u64::from(lo) << 32) | u64::from(hi)]
+}
+fn capture(
+    context: &SpanContextX,
+    metadata: &HashMap<u64, HashMap<Vec<u8>, FileStartEndPos>>,
