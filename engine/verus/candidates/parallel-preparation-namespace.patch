+#[test]
+fn failed_admitted_capture_is_in_peak_after_its_records_physically_drop() {
+    session(|| {
+        let map = SourceMap::new(FilePathMapping::empty());
+        let file = imported(&map, "dep.rs", "abcdefgh", 2);
+        let (context, mut metadata) = fixture(&file);
+        let original = metadata.get_mut(&7).unwrap();
+        let range = original.values().next().unwrap().clone();
+        original.clear();
+        original.insert(vec![0; 32], range);
+        assert!(matches!(
+            sail_capture_loaded_imports(&context.imported_crates, &metadata, &map, crate_id),
+            Err(CaptureFailure::HashMismatch)
+        ));
+        assert_eq!(capture::retained_bytes(), 0);
+        let (before, after) = crate::verifier::sail_test_import_peak();
+        assert!(before >= 8 * 1024 * 1024);
+        assert!(after >= 8 * 1024 * 1024);
+    });
+}
