+#[test]
+fn imported_provenance_rejects_unsupported_state_unknown_raw_and_changed_words() {
+    session(|| {
+        let map = SourceMap::new(FilePathMapping::empty());
+        let file = imported(&map, "dep.rs", "abcdefgh", 2);
+        let (context, metadata) = fixture(&file);
+        let span = |raw: vir::messages::RawSpan, data: Vec<u64>| vir::messages::Span {
+            raw_span: raw,
+            id: 563,
+            data,
+            as_string: "same binding".into(),
+        };
+        let observe = |span: &vir::messages::Span| {
+            let mut mapping =
+                sail_capture_loaded_imports(&context.imported_crates, &metadata, &map, crate_id)
+                    .unwrap();
+            mapping.revalidate(&context.imported_crates, &map);
+            crate::verifier::sail_test_import_provenance(span, mapping)
+        };
+        let original = observe(&span(Arc::new(()), packed(1002, 1006).to_vec())).unwrap();
+        assert_ne!(
+            observe(&span(Arc::new(()), packed(1003, 1006).to_vec())).unwrap(),
+            original
+        );
+        assert_ne!(
+            observe(&span(Arc::new(()), packed(1002, 1007).to_vec())).unwrap(),
+            original
+        );
+        assert_eq!(
+            observe(&span(Arc::new(1_u64), packed(1002, 1006).to_vec())),
+            None
+        );
+        assert_eq!(observe(&span(Arc::new(()), vec![7])), None);
+        assert_eq!(
+            observe(&span(Arc::new(()), packed(1002, 1009).to_vec())),
+            None
+        );
+        *context.imported_crates[&7].files[0].info.lock().unwrap() = ExternSourceInfo::Delayed {
+            filename: "not-read".into(),
+            hash: file.src_hash.hash_bytes().to_vec(),
+        };
+        assert_eq!(
+            observe(&span(Arc::new(()), packed(1002, 1006).to_vec())),
+            None
+        );
+        assert_eq!(map.files().len(), 1);
+    });
+}
