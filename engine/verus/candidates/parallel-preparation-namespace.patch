+struct Recorded<W:Write>{actual:W,wire:SailWire}
+impl<W:Write> Write for Recorded<W>{
+    fn write(&mut self,bytes:&[u8])->std::io::Result<usize>{
+        let n=self.actual.write(bytes)?;
+        if self.wire.output.write_all(&bytes[..n]).is_err(){self.wire.healthy.store(false,std::sync::atomic::Ordering::SeqCst);}
+        Ok(n)
+    }
+    fn flush(&mut self)->std::io::Result<()>{
+        self.actual.flush()?;
+        if self.wire.output.flush().is_err(){self.wire.healthy.store(false,std::sync::atomic::Ordering::SeqCst);}
+        Ok(())
+    }
+}
+fn writer_thread_recorded(requests:Receiver<Vec<u8>>,stdin:ChildStdin,wire:SailWire){
+    let mut writer=Recorded{actual:stdin,wire};
+    while let Ok(req)=requests.recv(){
+        if writer.write_all(&req).and_then(|_|writeln!(&mut writer)).and_then(|_|writeln!(&mut writer,"(echo \"{}\")",DONE)).and_then(|_|writer.flush()).is_err(){
+            writer.wire.healthy.store(false,std::sync::atomic::Ordering::SeqCst);break;
+        }
+    }
+}
