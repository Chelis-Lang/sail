+fn with_namespace<R>(map:Option<&SourceMap>,queue:Option<&std::sync::mpsc::Sender<ReporterMessage>>,sources:&Arc<Sources>,operation:impl FnOnce(&dyn Fn(&vir::messages::Span)->Option<()>)->R)->Option<R>{
