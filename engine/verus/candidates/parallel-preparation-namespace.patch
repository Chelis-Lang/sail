@@ -0,0 +1,831 @@
+//! Exact observed call-graph dependencies of one prepared lowering.
+use crate::ast::Fun;
+use crate::recursion::Node;
+use crate::scc::Graph;
+use std::collections::LinkedList;
+use std::io::Write;
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+const LIMIT: usize = 16 * 1024 * 1024;
+const FRAME_LIMIT: usize = 1024 * 1024;
+static OWNED: AtomicUsize = AtomicUsize::new(0);
+static ENCODE: Mutex<()> = Mutex::new(());
+pub fn retained_bytes() -> usize {
+    OWNED.load(Ordering::Relaxed)
+}
+fn charge(bytes: usize) -> bool {
+    OWNED
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |old| {
+            old.checked_add(bytes).filter(|next| *next <= LIMIT)
+        })
+        .is_ok()
+}
+#[derive(Clone, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+pub enum Query {
+    SccRep(Node, Node),
+    IsCycle(Node, bool),
+    SccNodes(Node, Vec<Node>),
+    ShortestCycle(Node, Vec<Node>),
+    FunctionOrder(Vec<Fun>, Vec<Vec<Fun>>),
+}
+// Same variant order and field representation; borrowing avoids retained IR clones.
+#[derive(serde::Serialize)]
+pub enum QueryRef<'a> {
+    SccRep(&'a Node, &'a Node),
+    IsCycle(&'a Node, bool),
+    SccNodes(&'a Node, &'a [Node]),
+    ShortestCycle(&'a Node, &'a [Node]),
+    FunctionOrder(&'a [Fun], &'a [Vec<Fun>]),
+}
+struct Writer(Vec<u8>);
+impl Write for Writer {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        let needed = self
+            .0
+            .len()
+            .checked_add(bytes.len())
+            .ok_or_else(|| std::io::Error::other("graph dependency budget"))?;
+        if needed > FRAME_LIMIT {
+            return Err(std::io::Error::other("graph dependency budget"));
+        }
+        if needed > self.0.capacity() {
+            let next = needed.max(self.0.capacity().saturating_mul(2)).clamp(64,FRAME_LIMIT);
+            self.0.try_reserve_exact(next - self.0.len()).map_err(std::io::Error::other)?;
+        }
+        if self.0.capacity() > FRAME_LIMIT {
+            return Err(std::io::Error::other("graph dependency allocation budget"));
+        }
+        self.0.extend_from_slice(bytes);
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+struct Recording {
+    frames: LinkedList<Vec<u8>>,
+    bytes: usize,
+}
+fn release_after_drop<T>(owned: T, release: impl FnOnce()) {
+    drop(owned);
+    release();
+}
+impl Drop for Recording {
+    fn drop(&mut self) {
+        release_after_drop(std::mem::take(&mut self.frames), || {
+            OWNED.fetch_sub(self.bytes, Ordering::Relaxed);
+        });
+    }
+}
+#[derive(Default)]
+struct State {
+    active: bool,
+    recording: Option<Recording>,
+    guard_epoch: u64,
+}
+const CAPTURE_CHARGE: usize = 128;
+const GUARD_CHARGE: usize = 128;
+const GUARD_DEPTH: usize = 64;
+// Ancestor ownership is only a small read epoch, never another ledger or
+// mutable compiler effect. The strong, bounded lineage survives an intermediate
+// clone being dropped before its ancestor starts capturing.
+struct GuardNode {
+    epoch: AtomicU64,
+    disabled: AtomicBool,
+    parent: Option<ReadGuard>,
+    depth: usize,
+}
+#[derive(Clone)]
+struct ReadGuard(Option<Arc<GuardNode>>);
+impl Drop for ReadGuard {
+    fn drop(&mut self) {
+        if let Some(inner) = self.0.take() {
+            if let Some(node) = Arc::into_inner(inner) {
+                // No weak owners: Arc allocation is gone. Drop every retained
+                // ancestor guard before admitting replacement quota.
+                release_after_drop(node, || { OWNED.fetch_sub(GUARD_CHARGE, Ordering::Relaxed); });
+            }
+        }
+    }
+}
+impl ReadGuard {
+    fn new(parent: Option<&Self>) -> Option<Self> {
+        Self::new_with_admission(parent, charge)
+    }
+    fn new_with_admission(parent: Option<&Self>, admit: impl FnOnce(usize)->bool) -> Option<Self> {
+        let depth = parent.and_then(|p|p.0.as_ref()).map_or(1, |p|p.depth + 1);
+        if depth > GUARD_DEPTH || !admit(GUARD_CHARGE) {
+            if let Some(parent) = parent {parent.disable();}
+            return None;
+        }
+        Some(Self(Some(Arc::new(GuardNode {
+            epoch: AtomicU64::new(0), disabled: AtomicBool::new(false),
+            parent: parent.cloned(), depth,
+        }))))
+    }
+    fn disable(&self) {
+        let mut node = self.0.as_deref();
+        while let Some(current) = node {
+            current.disabled.store(true, Ordering::SeqCst);
+            node = current.parent.as_ref().and_then(|p|p.0.as_deref());
+        }
+    }
+    fn notify(&self, include_self: bool) {
+        let mut node = self.0.as_deref();
+        if !include_self {node = node.and_then(|n|n.parent.as_ref()).and_then(|p|p.0.as_deref());}
+        while let Some(current) = node {
+            if current.epoch.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |old|old.checked_add(1)).is_err() {
+                current.disabled.store(true, Ordering::SeqCst);
+            }
+            node = current.parent.as_ref().and_then(|p|p.0.as_deref());
+        }
+    }
+    fn epoch(&self) -> Option<u64> {
+        let node = self.0.as_ref()?;
+        if node.disabled.load(Ordering::SeqCst) {None} else {Some(node.epoch.load(Ordering::SeqCst))}
+    }
+}
+#[derive(Clone)]
+pub struct Capture(Option<Arc<Mutex<State>>>, Option<ReadGuard>);
+impl Drop for Capture {
+    fn drop(&mut self) {
+        if let Some(inner) = self.0.take() {
+            // into_inner consumes and deallocates the final Arc before returning
+            // its value. Only the final clone releases the capture allocation.
+            if let Some(state) = Arc::into_inner(inner) {
+                release_after_drop(state, || {
+                    OWNED.fetch_sub(CAPTURE_CHARGE, Ordering::Relaxed);
+                });
+            }
+        }
+    }
+}
+impl Default for Capture {
+    fn default() -> Self {
+        Self::with_parent(None)
+    }
+}
+pub struct Ledger {
+    frames: Vec<Vec<u8>>,
+    bytes: usize,
+}
+impl Ledger {
+    pub fn frames(&self) -> &[Vec<u8>] {
+        &self.frames
+    }
+}
+impl Drop for Ledger {
+    fn drop(&mut self) {
+        release_after_drop(std::mem::take(&mut self.frames), || {
+            OWNED.fetch_sub(self.bytes, Ordering::Relaxed);
+        });
+    }
+}
+// Conversion admission precedes reserve; even a failed reserve/capacity check
+// physically drops the temporary vector before releasing its graph quota.
+struct Conversion {frames:Vec<Vec<u8>>,charged:usize}
+impl Conversion {
+    fn reserve(count:usize)->Option<Self> {
+        let metadata=count.checked_mul(std::mem::size_of::<Vec<u8>>())?.checked_mul(2)?.checked_add(128)?;
+        if !charge(metadata){return None;}
+        let mut conversion=Self {frames:Vec::new(),charged:metadata};
+        conversion.frames.try_reserve_exact(count).ok()?;
+        if conversion.frames.capacity().checked_mul(std::mem::size_of::<Vec<u8>>())?>metadata{return None;}
+        Some(conversion)
+    }
+}
+impl Drop for Conversion {
+    fn drop(&mut self){drop(std::mem::take(&mut self.frames));OWNED.fetch_sub(self.charged,Ordering::Relaxed);}
+}
+impl Capture {
+    fn with_parent(parent: Option<&ReadGuard>) -> Self {
+        Self::with_parent_admission(parent, charge)
+    }
+    fn with_parent_admission(parent: Option<&ReadGuard>, admit: impl FnOnce(usize)->bool) -> Self {
+        let Some(guard) = ReadGuard::new(parent) else {return Self(None, None);};
+        if !admit(CAPTURE_CHARGE) {
+            guard.disable();
+            return Self(None, None);
+        }
+        Self(Some(Arc::new(Mutex::new(State::default()))), Some(guard))
+    }
+    pub fn fork(&self) -> Self {
+        self.unsupported();
+        if self.0.is_none() {return Self(None, None);}
+        Self::with_parent(self.1.as_ref())
+    }
+    pub fn begin(&self) {
+        if let Some(inner) = &self.0 {
+            if let Ok(mut state) = inner.lock() {
+                state.active = true;
+                state.recording = self.1.as_ref().and_then(|guard|guard.epoch()).map(|epoch| {
+                    state.guard_epoch = epoch;
+                    Recording { frames: LinkedList::new(), bytes: 0 }
+                });
+            }
+        }
+    }
+    pub fn unsupported(&self) {
+        // Notify before returning the guarded input to the caller. A read
+        // before begin is harmless; a read during lowering changes its epoch.
+        if let Some(guard) = &self.1 {guard.notify(true);}
+        if let Some(inner) = &self.0 {
+            if let Ok(mut state) = inner.lock() {
+                if state.active {
+                    state.recording = None;
+                }
+            }
+        }
+    }
+    pub fn record(&self, query: QueryRef<'_>) {
+        // Independent child owners cannot silently supply graph reads to an
+        // ancestor capture, even when cloned before that capture started.
+        if let Some(guard) = &self.1 {guard.notify(false);}
+        let Some(inner) = &self.0 else {
+            return;
+        };
+        let Ok(mut state) = inner.lock() else {
+            return;
+        };
+        if !state.active {
+            return;
+        }
+        let Some(recording) = &mut state.recording else {
+            return;
+        };
+        let Ok(_gate) = ENCODE.lock() else {
+            state.recording = None;
+            return;
+        };
+        let mut writer = Writer(Vec::new());
+        if bincode_next::serde::encode_into_std_write(
+            &query,
+            &mut writer,
+            bincode_next::config::legacy(),
+        )
+        .is_err()
+        {
+            state.recording = None;
+            return;
+        }
+        let bytes = writer.0.capacity().saturating_add(64);
+        if !charge(bytes) {
+            state.recording = None;
+            return;
+        }
+        recording.bytes = recording.bytes.saturating_add(bytes);
+        recording.frames.push_back(writer.0);
+    }
+    pub fn finish(&self) -> Option<Ledger> {
+        let mut state = self.0.as_ref()?.lock().ok()?;
+        if !state.active {
+            return None;
+        }
+        state.active = false;
+        if self.1.as_ref().and_then(|guard|guard.epoch()) != Some(state.guard_epoch) {
+            state.recording = None;
+            return None;
+        }
+        let mut recording = state.recording.take()?;
+        // Conversion metadata cannot overlap another conversion or frame encoder.
+        let _gate = ENCODE.lock().ok()?;
+        let count=recording.frames.len();
+        let mut conversion=Conversion::reserve(count)?;
+        let bytes=recording.bytes.checked_add(conversion.charged)?;
+        while let Some(frame)=recording.frames.pop_front(){conversion.frames.push(frame);}
+        recording.bytes=0;
+        let frames=std::mem::take(&mut conversion.frames);conversion.charged=0;
+        Some(Ledger {frames,bytes})
+    }
+}
+// Decode the ledger under its own allocation cap before allocating an untrusted
+// frame vector. The surrounding portable SST decoder has a different budget.
+#[derive(serde::Serialize)]
+#[serde(transparent)]
+pub struct Frames(Vec<Vec<u8>>);
+impl Frames {
+    pub fn frames(&self) -> &[Vec<u8>] {
+        &self.0
+    }
+}
+impl<'de> serde::Deserialize<'de> for Frames {
+    fn deserialize<D: serde::Deserializer<'de>>(decoder: D) -> Result<Self, D::Error> {
+        struct FrameSeed(usize);
+        impl<'de> serde::de::DeserializeSeed<'de> for FrameSeed {
+            type Value = Vec<u8>;
+            fn deserialize<D: serde::Deserializer<'de>>(
+                self,
+                decoder: D,
+            ) -> Result<Vec<u8>, D::Error> {
+                struct FrameVisitor(usize);
+                impl<'de> serde::de::Visitor<'de> for FrameVisitor {
+                    type Value = Vec<u8>;
+                    fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+                        f.write_str("bounded graph frame")
+                    }
+                    fn visit_seq<S: serde::de::SeqAccess<'de>>(
+                        self,
+                        mut seq: S,
+                    ) -> Result<Vec<u8>, S::Error> {
+                        let count = seq
+                            .size_hint()
+                            .ok_or_else(|| serde::de::Error::custom("graph frame length"))?;
+                        if count > FRAME_LIMIT || count > self.0 {
+                            return Err(serde::de::Error::custom("graph frame limit"));
+                        }
+                        let mut frame = Vec::new();
+                        frame.try_reserve_exact(count).map_err(serde::de::Error::custom)?;
+                        if frame.capacity() > self.0 {
+                            return Err(serde::de::Error::custom("graph frame allocation"));
+                        }
+                        while let Some(byte) = seq.next_element::<u8>()? {
+                            if frame.len() >= count {
+                                return Err(serde::de::Error::custom("graph frame shape"));
+                            }
+                            frame.push(byte);
+                        }
+                        if frame.len() != count {
+                            return Err(serde::de::Error::custom("graph frame truncated"));
+                        }
+                        Ok(frame)
+                    }
+                }
+                decoder.deserialize_seq(FrameVisitor(self.0))
+            }
+        }
+        struct FramesVisitor;
+        impl<'de> serde::de::Visitor<'de> for FramesVisitor {
+            type Value = Frames;
+            fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+                f.write_str("bounded graph ledger")
+            }
+            fn visit_seq<S: serde::de::SeqAccess<'de>>(
+                self,
+                mut seq: S,
+            ) -> Result<Frames, S::Error> {
+                let count = seq
+                    .size_hint()
+                    .ok_or_else(|| serde::de::Error::custom("graph ledger length"))?;
+                if count > LIMIT / std::mem::size_of::<Vec<u8>>() {
+                    return Err(serde::de::Error::custom("graph ledger count"));
+                }
+                let mut frames = Vec::new();
+                frames.try_reserve_exact(count).map_err(serde::de::Error::custom)?;
+                let mut remaining = LIMIT
+                    .checked_sub(frames.capacity() * std::mem::size_of::<Vec<u8>>())
+                    .ok_or_else(|| serde::de::Error::custom("graph ledger allocation"))?;
+                while let Some(frame) = seq.next_element_seed(FrameSeed(remaining))? {
+                    if frames.len() >= count {
+                        return Err(serde::de::Error::custom("graph ledger shape"));
+                    }
+                    remaining = remaining
+                        .checked_sub(frame.capacity())
+                        .ok_or_else(|| serde::de::Error::custom("graph ledger limit"))?;
+                    frames.push(frame);
+                }
+                if frames.len() != count {
+                    return Err(serde::de::Error::custom("graph ledger truncated"));
+                }
+                Ok(Frames(frames))
+            }
+        }
+        struct OwnerVisitor;
+        impl<'de> serde::de::Visitor<'de> for OwnerVisitor {
+            type Value = Frames;
+            fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+                f.write_str("independently bounded graph frames")
+            }
+            fn visit_newtype_struct<D: serde::Deserializer<'de>>(
+                self, decoder: D,
+            ) -> Result<Frames, D::Error> {
+                decoder.deserialize_seq(FramesVisitor)
+            }
+        }
+        // Transparent under bincode; this exact private tag identifies the sole
+        // independently admitted schema to the enclosing allocation guard.
+        decoder.deserialize_newtype_struct("SailBoundedFrames/v1", OwnerVisitor)
+    }
+}
+
+// Full graph order is preserved. Empty components have no lowering effects.
+pub fn function_order(graph: &Graph<Node>, sccs: &[Node], functions: &[Fun]) -> Vec<Vec<Fun>> {
+    let mut groups = Vec::new();
+    for rep in sccs {
+        // Explicit push prevents collect's in-place optimization from retaining
+        // an entire unrelated Node allocation as the smaller Fun output buffer.
+        // The SCC visitation, predicate and emitted function order are unchanged.
+        let mut group = Vec::new();
+        for node in graph.get_scc_nodes(rep) {
+            match node {
+                Node::Fun(fun) if functions.contains(&fun) => group.push(fun),
+                _ => (),
+            }
+        }
+        if !group.is_empty() {
+            groups.push(group);
+        }
+    }
+    groups
+}
+pub fn validate(
+    frames: &[Vec<u8>],
+    graph: &Graph<Node>,
+    sccs: &[Node],
+) -> Result<(), &'static str> {
+    let mut bytes =
+        frames.len().checked_mul(std::mem::size_of::<Vec<u8>>()).ok_or("ledger-limit")?;
+    let mut order_queries = 0;
+    for frame in frames {
+        bytes = bytes.checked_add(frame.capacity()).ok_or("ledger-limit")?;
+        if bytes > LIMIT || frame.len() > FRAME_LIMIT {
+            return Err("ledger-limit");
+        }
+        // Independent bounded query owner; no untrusted size hint reaches
+        // derived Vec/Map/String allocation. It drops before the next frame.
+        let (query, used): (Query, usize) = crate::sail_decode::decode(frame,8*1024*1024)
+            .map_err(|_| "ledger-shape")?;
+        if used != frame.len() {
+            return Err("ledger-trailing");
+        }
+        // Scalar queries allocate no unrelated graph nodes. SCC output clones
+        // are scoped to the selected component; function_order retains one
+        // component buffer plus selected Fun/group output. Shortest-cycle keeps
+        // the existing whole-graph quadratic path/visited upper bound.
+        let extra = |node: &Node| Some(match node { Node::SpanInfo { text, .. } => text.len(), _ => 0 });
+        let scratch = match &query {
+            Query::IsCycle(..) => Some(4096),
+            Query::SccRep(input, _) => graph.sail_scc_clone_cost(input, true, extra),
+            Query::SccNodes(input, _) => graph.sail_scc_clone_cost(input, false, extra),
+            Query::ShortestCycle(..) => graph.sail_validation_cost(true, extra),
+            Query::FunctionOrder(input, _) => {
+                let element = std::mem::size_of::<Fun>().checked_add(std::mem::size_of::<Vec<Fun>>())
+                    .and_then(|bytes| bytes.checked_mul(8)).and_then(|bytes| bytes.checked_add(1024));
+                graph.sail_max_scc_clone_cost(extra).and_then(|bytes| {
+                    bytes.checked_add(input.len().checked_mul(element?)?)
+                })
+            }
+        }.ok_or("ledger-scratch-overflow")?;
+        if scratch > 8 * 1024 * 1024 { return Err("ledger-scratch-budget"); }
+        let matching = match query {
+            Query::SccRep(input, expected) => {
+                graph.contains_node(&input) && graph.get_scc_rep(&input) == expected
+            }
+            Query::IsCycle(input, expected) => {
+                graph.contains_node(&input) && graph.node_is_in_cycle(&input) == expected
+            }
+            Query::SccNodes(input, expected) => {
+                graph.contains_node(&input) && graph.get_scc_nodes(&input) == expected
+            }
+            Query::ShortestCycle(input, expected) => {
+                graph.contains_node(&input)
+                    && graph.node_is_in_cycle(&input)
+                    && graph.shortest_cycle_back_to_self(&input) == expected
+            }
+            Query::FunctionOrder(input, expected) => {
+                order_queries += 1;
+                function_order(graph, sccs, &input) == expected
+            }
+        };
+        if !matching {
+            return Err("graph-answer-changed");
+        }
+    }
+    if order_queries != 1 {
+        return Err("ledger-coverage");
+    }
+    Ok(())
+}
