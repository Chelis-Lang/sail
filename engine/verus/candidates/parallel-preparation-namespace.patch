+mod tests {
+    use super::*;
+    fn directory(name: &str) -> PathBuf {
+        let dir = std::env::temp_dir().join(format!(
+            "sail-oracle-{}-{}-{}",
+            std::process::id(),
+            name,
+            NEXT.fetch_add(1, Ordering::SeqCst)
+        ));
+        std::fs::create_dir(&dir).unwrap();
+        dir
+    }
+    #[test]
+    fn ordered_wire_comparison_detects_changed_byte_trailing_byte_and_session_swap() {
+        let root = directory("comparison");
+        let a = root.join("a");
+        let b = root.join("b");
+        std::fs::write(&a, b"(assert true)\n(check-sat)\n").unwrap();
+        std::fs::write(&b, b"(assert true)\n(check-sat)\n").unwrap();
+        assert!(same_file(&a, &b).unwrap());
+        std::fs::write(&b, b"(assert false)\n(check-sat)\n").unwrap();
+        assert!(!same_file(&a, &b).unwrap());
+        std::fs::write(&b, b"(assert true)\n(check-sat)\n ").unwrap();
+        assert!(!same_file(&a, &b).unwrap());
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn launch_order_and_physical_capture_completion_are_required() {
+        let root = directory("order");
+        let arm =
+            Arm::new(root.join("arm"), "unused".into(), Arc::new(AtomicUsize::new(0))).unwrap();
+        let a = arm.wire().unwrap();
+        let b = arm.wire().unwrap();
+        b.launch_index.store(b.launch_counter.fetch_add(1, Ordering::SeqCst), Ordering::SeqCst);
+        a.launch_index.store(a.launch_counter.fetch_add(1, Ordering::SeqCst), Ordering::SeqCst);
+        assert!(arm.complete().is_none());
+        drop(a);
+        assert!(arm.complete().is_none());
+        drop(b);
+        assert_eq!(
+            arm.complete().unwrap(),
+            vec![root.join("arm/0001.smt2"), root.join("arm/0000.smt2")]
+        );
+        arm.healthy.store(false, Ordering::SeqCst);
+        assert!(arm.complete().is_none());
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn zero_session_is_exact_empty_inventory_not_proof_evidence() {
+        let root = directory("empty");
+        let arm =
+            Arm::new(root.join("arm"), "unused".into(), Arc::new(AtomicUsize::new(0))).unwrap();
+        let pending = arm.wire().unwrap();
+        assert!(arm.complete().is_none());
+        drop(pending);
+        assert_eq!(arm.complete().unwrap(), Vec::<PathBuf>::new());
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
