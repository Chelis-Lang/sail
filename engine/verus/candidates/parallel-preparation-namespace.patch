 impl<T: std::cmp::Eq + std::hash::Hash + Clone> Graph<T> {
+    // Conservative requested-allocation upper bound for unchanged graph query
+    // algorithms. Each reached vertex is admitted once; shortest-cycle retains
+    // copied paths of at most N indices, hence a quadratic worst case. The
+    // closure accounts for owned node-clone payload (SpanInfo String); Arc
+    // references count only their new inline owner, not shared compiler data.
+    pub fn sail_validation_cost(&self,quadratic:bool,extra:impl Fn(&T)->Option<usize>)->Option<usize> {
+        let n=self.nodes.len();
+        let mut bytes=n.checked_mul(std::mem::size_of::<T>().checked_mul(8)?.checked_add(1024)?)?.checked_add(4096)?;
+        for node in &self.nodes {bytes=bytes.checked_add(extra(&node.t)?.checked_mul(8)?)?;}
+        if quadratic {bytes=bytes.checked_add(n.checked_mul(n)?.checked_mul(std::mem::size_of::<usize>())?.checked_mul(16)?)?;}
+        Some(bytes)
+    }
+    // Bound only the clone owners produced by one immutable SCC query.
+    // Index/representative discovery itself borrows existing compiler tables.
+    // The same 8x inline/payload and 1024-byte per-element allowance covers
+    // minimum capacity, growth, collection conversion and old/new overlap.
+    pub fn sail_scc_clone_cost(&self, input: &T, representative: bool,
+        extra: impl Fn(&T) -> Option<usize>) -> Option<usize> {
+        if !self.has_run { return None; }
+        let scc = self.sccs.get(*self.mapping.get(input)?)?;
+        let mut bytes = 4096usize;
+        let mut add = |index: usize| {
+            let node = self.nodes.get(index)?;
+            bytes = bytes.checked_add(std::mem::size_of::<T>().checked_mul(8)?.checked_add(1024)?)?
+                .checked_add(extra(&node.t)?.checked_mul(8)?)?;
+            Some(())
+        };
+        if representative { add(*scc.nodes.first()?)?; }
+        else { for index in &scc.nodes { add(*index)?; } }
+        Some(bytes)
+    }
+    // function_order drops one SCC clone buffer before processing the next.
+    // This scan performs no graph clone or temporary collection allocation.
+    pub fn sail_max_scc_clone_cost(&self, extra: impl Fn(&T) -> Option<usize>) -> Option<usize> {
+        if !self.has_run { return None; }
+        let mut maximum = 4096usize;
+        for scc in &self.sccs {
+            let mut bytes = 4096usize;
+            for index in &scc.nodes {
+                let node = self.nodes.get(*index)?;
+                bytes = bytes.checked_add(std::mem::size_of::<T>().checked_mul(8)?.checked_add(1024)?)?
+                    .checked_add(extra(&node.t)?.checked_mul(8)?)?;
+            }
+            maximum = maximum.max(bytes);
+        }
+        Some(maximum)
+    }
+    pub fn sail_encoding(&self)->Option<Vec<u8>> where T:serde::Serialize {
+        fn table<K:serde::Serialize,V:serde::Serialize>(map:&HashMap<K,V>,budget:&mut usize)->Option<Vec<(Vec<u8>,Vec<u8>)>> {
+            *budget=budget.checked_add(map.len().checked_mul(std::mem::size_of::<(Vec<u8>,Vec<u8>)>())?)?;
+            if *budget>32*1024*1024{return None;}
+            let mut items=Vec::new();items.try_reserve_exact(map.len()).ok()?;
+            for (key,value) in map {let key=crate::context::sail_encode(key)?;let value=crate::context::sail_encode(value)?;
+                *budget=budget.checked_add(key.capacity())?.checked_add(value.capacity())?;if *budget>32*1024*1024{return None;}items.push((key,value));}
+            items.sort();Some(items)
