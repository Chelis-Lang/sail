+//! Private batch session: all retained spans belong to the active compiler callback.
+use super::*;
+use std::cell::{Cell,RefCell};
+use std::io::Read;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use sha2::{Digest, Sha256};
+static FOCUS: AtomicBool = AtomicBool::new(false);
+static CACHING: AtomicBool = AtomicBool::new(false);
+const BUDGET: usize = 512 * 1024 * 1024;
