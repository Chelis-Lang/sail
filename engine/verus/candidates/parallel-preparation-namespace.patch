+const DIRECTORY_METADATA:usize=4*1024*1024;
+struct DiskInventory {paths:Vec<std::path::PathBuf>,charged:usize}
+impl DiskInventory {
+    fn new()->Option<Self> {
+        let charged=4097usize.checked_mul(std::mem::size_of::<std::path::PathBuf>())?.checked_mul(2)?.checked_add(512)?;
+        if charged>DIRECTORY_METADATA{return None;}
+        let mut paths=Vec::new();paths.try_reserve_exact(4097).ok()?;
+        if paths.capacity().checked_mul(std::mem::size_of::<std::path::PathBuf>())?>charged{return None;}
+        Some(Self {paths,charged})
+    }
+    fn push(&mut self,root:&std::path::Path,name:&std::ffi::OsStr)->Option<()> {
+        // The iterator supplies one native basename; never join arbitrary paths.
+        if root.as_os_str().len()>32768 || name.len()>32768 || self.paths.len()>=4096{return None;}
+        let mut components=std::path::Path::new(name).components();
+        if !matches!(components.next(),Some(std::path::Component::Normal(_))) || components.next().is_some(){return None;}
+        let bytes=root.as_os_str().len().checked_add(name.len())?.checked_add(2)?;
+        let charge=bytes.checked_mul(8)?.checked_add(128)?;
+        let total=self.charged.checked_add(charge)?;if total>DIRECTORY_METADATA{return None;}
+        // This admitted bound includes clone/join growth and any old/new path
+        // buffer overlap. No inventory vector growth is needed after new().
+        let path=root.join(name);let os=path.into_os_string();
+        if os.capacity()>bytes.checked_mul(2)?{return None;}
+        self.paths.push(std::path::PathBuf::from(os));self.charged=total;Some(())
+    }
+}
+fn disk_inventory(root:&std::path::Path)->Option<DiskInventory> {
+    if root.as_os_str().len()>32768{return None;}
+    let mut inventory=DiskInventory::new()?;
+    for entry in std::fs::read_dir(root).ok()? {let entry=entry.ok()?;let name=entry.file_name();if name=="cache.lock"{continue;}inventory.push(root,&name)?;}
+    Some(inventory)
+}
+fn write_disk(key:&str,bytes:&[u8]) {
+    let Some(root)=disk_root() else{return;};
+    if std::fs::create_dir_all(&root).is_err(){return;}
+    let Ok(lock)=std::fs::OpenOptions::new().create(true).read(true).write(true).truncate(false).open(root.join("cache.lock")) else{return;};
+    if lock.lock().is_err(){return;}
+    // Reserve temporary bytes under the same lock; count both committed and abandoned
+    // temporary buffers. Never retain a per-entry independent 512 MiB allowance.
+    let Some(files)=disk_inventory(&root)else{return;};
+    let total=files.paths.iter().filter_map(|entry|entry.symlink_metadata().ok().map(|metadata|metadata.len())).fold(0u64,u64::saturating_add);
+    if total.saturating_add(bytes.len() as u64+64)>BUDGET as u64 {for entry in &files.paths {let _=std::fs::remove_file(entry);}}
+    drop(files);
+    let Some(files)=disk_inventory(&root)else{return;};
+    let remaining=files.paths.iter().filter_map(|entry|entry.symlink_metadata().ok().map(|metadata|metadata.len())).fold(0u64,u64::saturating_add);
+    drop(files);
+    if remaining.saturating_add(bytes.len() as u64+64)>BUDGET as u64 {return;}
+    let digest=Sha256::digest(bytes).iter().map(|byte|format!("{byte:02x}")).collect::<String>();
+    let temporary=root.join(format!("{key}.{}.tmp",std::process::id()));
+    if let Ok(mut file)=std::fs::File::create(&temporary) {if file.write_all(digest.as_bytes()).and_then(|()|file.write_all(bytes)).is_ok(){let _=std::fs::rename(&temporary,root.join(format!("{key}.prepared")));}}
