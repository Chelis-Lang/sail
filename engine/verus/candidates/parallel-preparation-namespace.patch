+//! Opt-in diagnostic oracle: two independent owners inside one compiler callback.
+//! Raw bytes are captured at the actual solver writer, never normalized or hashed
+//! in place of comparison. This mode is not a production verification speed path.
+use super::*;
+use std::cell::{Cell, RefCell};
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+const RAW_BUDGET: usize = 256 * 1024 * 1024;
+const DIAGNOSTIC_BUDGET: usize = 16 * 1024 * 1024;
+static GATE: std::sync::Mutex<()> = std::sync::Mutex::new(());
+static NEXT: AtomicUsize = AtomicUsize::new(0);
+fn raw_budget() -> Arc<AtomicUsize> {
+    static USED: std::sync::OnceLock<Arc<AtomicUsize>> = std::sync::OnceLock::new();
+    USED.get_or_init(|| Arc::new(AtomicUsize::new(0))).clone()
+}
+
+pub(super) struct Arm {
+    root: PathBuf,
+    solver: PathBuf,
+    used: Arc<AtomicUsize>,
+    healthy: Arc<AtomicBool>,
+    closed: Arc<AtomicUsize>,
+    launches: Arc<AtomicUsize>,
+    sessions: std::sync::Mutex<Vec<(PathBuf, Arc<AtomicUsize>)>>,
+}
+struct RawWriter {
+    file: Option<File>,
+    used: Arc<AtomicUsize>,
+    closed: Arc<AtomicUsize>,
+    healthy: Arc<AtomicBool>,
+}
+impl Write for RawWriter {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        self.used
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |used| {
+                used.checked_add(bytes.len()).filter(|size| *size <= RAW_BUDGET)
+            })
+            .map_err(|_| std::io::Error::other("oracle raw byte limit"))?;
+        self.file.as_mut().ok_or_else(|| std::io::Error::other("closed oracle wire"))?.write(bytes)
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        self.file.as_mut().ok_or_else(|| std::io::Error::other("closed oracle wire"))?.flush()
+    }
+}
+impl Drop for RawWriter {
+    fn drop(&mut self) {
+        if self.file.as_mut().is_some_and(|file| file.flush().is_err()) {
+            self.healthy.store(false, Ordering::SeqCst);
+        }
+        drop(self.file.take());
+        self.closed.fetch_add(1, Ordering::SeqCst);
+    }
+}
+impl Arm {
+    fn new(root: PathBuf, solver: PathBuf, used: Arc<AtomicUsize>) -> std::io::Result<Self> {
+        std::fs::create_dir(&root)?;
+        Ok(Self {
+            root,
+            solver,
+            used,
+            healthy: Arc::new(AtomicBool::new(true)),
+            closed: Arc::new(AtomicUsize::new(0)),
+            launches: Arc::new(AtomicUsize::new(0)),
+            sessions: std::sync::Mutex::new(Vec::new()),
+        })
+    }
+    pub fn wire(&self) -> std::io::Result<air::smt_process::SailWire> {
+        let mut sessions =
+            self.sessions.lock().map_err(|_| std::io::Error::other("oracle session lock"))?;
+        if sessions.len() >= 4096 {
+            return Err(std::io::Error::other("oracle session limit"));
+        }
+        let path = self.root.join(format!("{:04}.smt2", sessions.len()));
+        let file = std::fs::OpenOptions::new().write(true).create_new(true).open(&path)?;
+        let launch_index = Arc::new(AtomicUsize::new(usize::MAX));
+        sessions.push((path, launch_index.clone()));
+        Ok(air::smt_process::SailWire {
+            solver: self.solver.clone(),
+            output: Box::new(RawWriter {
+                file: Some(file),
+                used: self.used.clone(),
+                closed: self.closed.clone(),
+                healthy: self.healthy.clone(),
+            }),
+            healthy: self.healthy.clone(),
+            launch_counter: self.launches.clone(),
+            launch_index,
+        })
+    }
+    fn complete(&self) -> Option<Vec<PathBuf>> {
+        let sessions = self.sessions.lock().ok()?;
+        if !self.healthy.load(Ordering::SeqCst)
+            || self.closed.load(Ordering::SeqCst) != sessions.len()
+        {
+            return None;
+        }
+        let mut ordered = Vec::new();
+        for ordinal in 0..self.launches.load(Ordering::SeqCst) {
+            let matches = sessions
+                .iter()
+                .filter(|(_, index)| index.load(Ordering::SeqCst) == ordinal)
+                .collect::<Vec<_>>();
+            if matches.len() != 1 {
+                return None;
+            }
+            ordered.push(matches[0].0.clone());
+        }
+        Some(ordered)
+    }
+}
+struct Collector {
+    file: RefCell<File>,
+    bytes: Cell<usize>,
+    valid: Cell<bool>,
+}
+impl Collector {
+    fn new(path: &Path) -> std::io::Result<Self> {
+        Ok(Self {
+            file: RefCell::new(
+                std::fs::OpenOptions::new().write(true).create_new(true).open(path)?,
+            ),
+            bytes: Cell::new(0),
+            valid: Cell::new(true),
+        })
+    }
+    fn record(&self, kind: &str, messages: &[(ArcDynMessage, MessageLevel)]) {
+        struct Limit<'a> {
+            file: std::cell::RefMut<'a, File>,
+            bytes: &'a Cell<usize>,
+        }
+        impl Write for Limit<'_> {
+            fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+                let size = self
+                    .bytes
+                    .get()
+                    .checked_add(bytes.len())
+                    .filter(|size| *size <= DIAGNOSTIC_BUDGET)
+                    .ok_or_else(|| std::io::Error::other("oracle diagnostic byte limit"))?;
+                raw_budget()
+                    .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |used| {
+                        used.checked_add(bytes.len()).filter(|used| *used <= RAW_BUDGET)
+                    })
+                    .map_err(|_| std::io::Error::other("oracle artifact byte limit"))?;
+                let n = self.file.write(bytes)?;
+                self.bytes.set(size - bytes.len() + n);
+                Ok(n)
+            }
+            fn flush(&mut self) -> std::io::Result<()> {
+                self.file.flush()
+            }
+        }
+        if !self.valid.get() {
+            return;
+        }
+        let mut out = Limit { file: self.file.borrow_mut(), bytes: &self.bytes };
+        let result = (|| -> std::io::Result<()> {
+            serde_json::to_writer(&mut out, kind)?;
+            out.write_all(b" [")?;
+            for (index, (message, level)) in messages.iter().enumerate() {
+                let msg = message
+                    .downcast_ref::<MessageX>()
+                    .ok_or_else(|| std::io::Error::other("unknown oracle diagnostic"))?;
+                if index > 0 {
+                    out.write_all(b",")?;
+                }
+                serde_json::to_writer(&mut out, &(level, msg))?;
+            }
+            out.write_all(b"]\n")?;
+            out.flush()
+        })(); // Group and exact immediate emission remain observable.
+        if result.is_err() {
+            self.valid.set(false);
+        }
+    }
+    fn replay(&self, messages: &[(ArcDynMessage, MessageLevel, sail_engine::Emission)]) {
+        for (message, level, emission) in messages {
+            match emission {
+                sail_engine::Emission::Report => self.report(message),
+                sail_engine::Emission::ReportAs => self.report_as(message, *level),
+                sail_engine::Emission::ReportNow => self.report_now(message),
+                sail_engine::Emission::ReportAsNow => self.report_as_now(message, *level),
+            }
+        }
+    }
+}
+impl super::Diagnostics for Collector {
+    fn use_progress_bars(&self) -> bool {
+        false
+    }
+    fn add_progress_bar(&self, _: CommandContext) {}
+    fn complete_progress_bar(&self, _: CommandContext) {}
+}
+impl air::messages::Diagnostics for Collector {
+    fn report(&self, msg: &ArcDynMessage) {
+        if let Some(message) = msg.downcast_ref::<MessageX>() {
+            self.record("report", &[(msg.clone(), message.level)])
+        } else {
+            self.valid.set(false)
+        }
+    }
+    fn report_now(&self, msg: &ArcDynMessage) {
+        if let Some(message) = msg.downcast_ref::<MessageX>() {
+            self.record("report_now", &[(msg.clone(), message.level)])
+        } else {
+            self.valid.set(false)
+        }
+    }
+    fn report_as(&self, msg: &ArcDynMessage, level: MessageLevel) {
+        self.record("report_as", &[(msg.clone(), level)])
+    }
+    fn report_as_now(&self, msg: &ArcDynMessage, level: MessageLevel) {
+        self.record("report_as_now", &[(msg.clone(), level)])
+    }
+    fn report_as_multi(&self, msgs: Vec<(ArcDynMessage, MessageLevel)>) {
+        self.record("report_as_multi", &msgs)
+    }
+}
+fn same_file(left: &Path, right: &Path) -> std::io::Result<bool> {
+    let mut a = std::io::BufReader::new(File::open(left)?);
+    let mut b = std::io::BufReader::new(File::open(right)?);
+    let mut x = [0u8; 8192];
+    let mut y = [0u8; 8192];
+    fn fill(reader: &mut impl Read, bytes: &mut [u8]) -> std::io::Result<usize> {
+        let mut n = 0;
+        while n < bytes.len() {
+            match reader.read(&mut bytes[n..]) {
+                Ok(0) => break,
+                Ok(read) => n += read,
+                Err(error) if error.kind() == std::io::ErrorKind::Interrupted => continue,
+                Err(error) => return Err(error),
+            }
+        }
+        Ok(n)
+    }
+    loop {
+        let xn = fill(&mut a, &mut x)?;
+        let yn = fill(&mut b, &mut y)?;
+        if xn != yn || x[..xn] != y[..yn] {
+            return Ok(false);
+        }
+        if xn == 0 {
+            return Ok(true);
+        }
+    }
+}
+fn same_outcomes(a: &Verifier, b: &Verifier) -> bool {
+    a.count_verified == b.count_verified
+        && a.count_errors == b.count_errors
+        && a.encountered_error == b.encountered_error
+        && a.encountered_vir_error == b.encountered_vir_error
+        && a.func_fails == b.func_fails
+        && a.func_details.len() == b.func_details.len()
+        && a.func_details.iter().all(|(fun, details)| {
+            b.func_details.get(fun).is_some_and(|other| {
+                details.obligation_proof_notes == other.obligation_proof_notes
+                    && details.failed_proof_notes == other.failed_proof_notes
+            })
+        })
+}
+fn shadow(v: &Verifier, root: PathBuf, arm: Arc<Arm>, bucket: &BucketId) -> Verifier {
+    let mut shadow = v.from_self();
+    shadow.created_log_dir = Arc::new(std::sync::Mutex::new(Some(root.clone())));
+    shadow.created_solver_log_dir = Arc::new(std::sync::Mutex::new(Some(root)));
+    shadow.bucket_stats.insert(bucket.clone(), Default::default());
+    shadow.sail_oracle_arm = Some(arm);
+    shadow
+}
+fn io_error(error: std::io::Error) -> VirErr {
+    super::io_vir_err("same-callback lowering oracle unavailable".into(), error)
+}
+
+pub(super) fn verify(
+    v: &Verifier,
+    krate: &Krate,
+    source_map: Option<&SourceMap>,
+    bucket: &BucketId,
+    mut fresh: vir::context::Ctx,
+    restored: &vir::context::Ctx,
+    sst: &vir::sst::KrateSst,
+    messages: &[(ArcDynMessage, MessageLevel, sail_engine::Emission)],
+) -> Result<(), VirErr> {
+    let _gate = GATE.lock().map_err(|_| io_error(std::io::Error::other("oracle lock")))?;
+    let directory = std::env::var_os("SAIL_ENGINE_ORACLE_DIR")
+        .ok_or_else(|| io_error(std::io::Error::other("missing oracle directory")))?;
+    let solver =
+        PathBuf::from(std::env::var_os("SAIL_ENGINE_ORACLE_Z3").ok_or_else(|| {
+            io_error(std::io::Error::other("explicit real oracle solver required"))
+        })?);
+    if !solver.is_absolute()
+        || !solver.is_file()
+        || !matches!(v.args.solver, SmtSolver::Z3)
+        || v.args.profile
+        || v.args.profile_all
+        || v.args.capture_profiles
+    {
+        return Err(io_error(std::io::Error::other("unsupported oracle solver/profile")));
+    }
+    let root = PathBuf::from(directory).join(format!(
+        "{}-{:04}",
+        std::process::id(),
+        NEXT.fetch_add(1, Ordering::SeqCst)
+    ));
+    std::fs::create_dir_all(&root).map_err(io_error)?;
+    let used = raw_budget();
+    let fresh_arm =
+        Arc::new(Arm::new(root.join("fresh"), solver.clone(), used.clone()).map_err(io_error)?);
+    let restored_arm = Arc::new(Arm::new(root.join("restored"), solver, used).map_err(io_error)?);
+    let mut restored_ctx = fresh
+        .sail_oracle_fork(krate)
+        .ok_or_else(|| io_error(std::io::Error::other("independent restored owner")))?;
+    if !sail_engine::oracle_equal_baselines(&fresh, &restored_ctx) {
+        return Err(io_error(std::io::Error::other("initial independent baseline differs")));
+    }
+    restored_ctx.sail_restore_effects(
+        restored
+            .sail_effects()
+            .ok_or_else(|| io_error(std::io::Error::other("unknown restored effects")))?,
+    );
+    let fresh_reporter = Collector::new(&root.join("fresh/diagnostics.jsonl")).map_err(io_error)?;
+    let restored_reporter =
+        Collector::new(&root.join("restored/diagnostics.jsonl")).map_err(io_error)?;
+    let mut fresh_verifier = shadow(v, root.join("fresh"), fresh_arm.clone(), bucket);
+    let mut restored_verifier = shadow(v, root.join("restored"), restored_arm.clone(), bucket);
+    let _scope = sail_engine::ShadowScope::begin(); // No ORDINALS/cache counters/source event writes.
+    let lowered = vir::ast_to_sst_crate::ast_to_sst_krate(
+        &mut fresh,
+        &fresh_reporter,
+        &v.get_bucket(bucket).funs,
+        krate,
+    )?;
+    let lowered = vir::poly::poly_krate_for_module(&mut fresh, &lowered);
+    restored_reporter.replay(messages);
+    let mut restored_sst = Arc::new(vir::sst::KrateSstX {
+        functions: sst.functions.clone(),
+        datatypes: sst.datatypes.clone(),
+        opaque_types: sst.opaque_types.clone(),
+        traits: sst.traits.clone(),
+        trait_impls: sst.trait_impls.clone(),
+        assoc_type_impls: sst.assoc_type_impls.clone(),
+        reveal_groups: sst.reveal_groups.clone(),
+    });
+    let fault = std::env::var("SAIL_ENGINE_ORACLE_FAULT").unwrap_or_default();
+    let injected = match fault.as_str() {
+        "" => true,
+        "order" => {
+            if restored_sst.functions.len() > 1 {
+                Arc::get_mut(&mut restored_sst).unwrap().functions.swap(0, 1);
+                true
+            } else {
+                false
+            }
+        }
+        "effects" => {
+            restored_ctx.sail_oracle_effect_fault();
+            true
+        }
+        "body" => {
+            let mut changed = false;
+            for function in &mut Arc::get_mut(&mut restored_sst).unwrap().functions {
+                if let Some(body) = function.x.axioms.spec_axioms.as_ref() {
+                    if let vir::sst::ExpX::Const(vir::ast::Constant::Bool(value)) = &body.body_exp.x
+                    {
+                        let replacement = !value;
+                        let function_mut = Arc::make_mut(function);
+                        let body =
+                            Arc::make_mut(&mut function_mut.x.axioms).spec_axioms.as_mut().unwrap();
+                        Arc::make_mut(&mut body.body_exp).x =
+                            vir::sst::ExpX::Const(vir::ast::Constant::Bool(replacement));
+                        restored_ctx.sail_oracle_replace_function(function.clone());
+                        changed = true;
+                        break;
+                    }
+                }
+            }
+            changed
+        }
+        _ => false,
+    };
+    if !injected {
+        return Err(io_error(std::io::Error::other("unsupported oracle fault/no matching body")));
+    }
+    let lowering_effects_same = sail_engine::oracle_equal_baselines(&fresh, &restored_ctx);
+    fresh_verifier.verify_bucket(&fresh_reporter, &lowered, source_map, bucket, &mut fresh)?;
+    restored_verifier.verify_bucket(
+        &restored_reporter,
+        &restored_sst,
+        source_map,
+        bucket,
+        &mut restored_ctx,
+    )?;
+    if fresh_verifier.deferred_errors.len() > 4096 || restored_verifier.deferred_errors.len() > 4096
+    {
+        return Err(io_error(std::io::Error::other("oracle deferred diagnostic count")));
+    }
+    fresh_reporter.record(
+        "deferred_errors",
+        &fresh_verifier
+            .deferred_errors
+            .iter()
+            .map(|message| (message.clone() as ArcDynMessage, message.level))
+            .collect::<Vec<_>>(),
+    );
+    restored_reporter.record(
+        "deferred_errors",
+        &restored_verifier
+            .deferred_errors
+            .iter()
+            .map(|message| (message.clone() as ArcDynMessage, message.level))
+            .collect::<Vec<_>>(),
+    );
+    let a = fresh_arm
+        .complete()
+        .ok_or_else(|| io_error(std::io::Error::other("incomplete fresh wire")))?;
+    let b = restored_arm
+        .complete()
+        .ok_or_else(|| io_error(std::io::Error::other("incomplete restored wire")))?;
+    let wire_same =
+        a.len() == b.len() && a.iter().zip(&b).all(|(a, b)| same_file(a, b).unwrap_or(false));
+    let diagnostic_same = fresh_reporter.valid.get()
+        && restored_reporter.valid.get()
+        && same_file(
+            &root.join("fresh/diagnostics.jsonl"),
+            &root.join("restored/diagnostics.jsonl"),
+        )
+        .map_err(io_error)?;
+    let full_same = same_outcomes(&fresh_verifier, &restored_verifier);
+    let final_effects_same = sail_engine::oracle_equal_baselines(&fresh, &restored_ctx);
+    let passed =
+        wire_same && diagnostic_same && full_same && lowering_effects_same && final_effects_same;
+    let summary = serde_json::json!({"version":1,"same_callback":true,"restored_hit":true,"passed":passed,"ordered_wire_equal":wire_same,"diagnostics_equal":diagnostic_same,"outcomes_equal":full_same,"lowering_effects_equal":lowering_effects_same,"final_effects_equal":final_effects_same,"fresh_sessions":a.len(),"restored_sessions":b.len(),"fresh_verified":fresh_verifier.count_verified,"fresh_errors":fresh_verifier.count_errors,"restored_verified":restored_verifier.count_verified,"restored_errors":restored_verifier.count_errors,"fault":fault,"bucket":format!("{:?}",bucket)});
+    // The small summary contains counts/booleans, not cloned diagnostic or
+    // outcome graphs. Bound both its allocation and the global artifact quota.
+    let bytes =
+        serde_json::to_vec_pretty(&summary).map_err(|err| io_error(std::io::Error::other(err)))?;
+    if bytes.len() > 64 * 1024 {
+        return Err(io_error(std::io::Error::other("oracle summary limit")));
+    }
+    raw_budget()
+        .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |used| {
+            used.checked_add(bytes.len()).filter(|used| *used <= RAW_BUDGET)
+        })
+        .map_err(|_| io_error(std::io::Error::other("oracle artifact byte limit")))?;
+    std::fs::write(root.join("summary.json"), bytes).map_err(io_error)?;
+    if !passed {
+        return Err(io_error(std::io::Error::other("fresh/restored raw evidence differs")));
+    }
+    Ok(())
+}
