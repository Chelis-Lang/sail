+    }
+    fn deserialize_ignored_any<V: Visitor<'de>>(
+        self,
+        _visitor: V,
+    ) -> Result<V::Value, Self::Error> {
+        Err(de::Error::custom("unsupported prepared ignored schema"))
+    }
+    fn is_human_readable(&self) -> bool {
+        false
+    }
+}
