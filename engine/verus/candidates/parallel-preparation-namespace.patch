+        let files=map.files();
+        return Some(operation(&|span|validate_used_namespace(span,sources,&files)));
+    }
+    let queue=queue?;
+    // PREPARATION_GATE must already be held: at most one rendezvous exists.
+    // Receiver-side files remain borrowed through Ready, all validations, and
+    // the worker's complete decode/restore or cache publication. Lease disposal
+    // disconnects even on unwind: no Drop sends or waits for an acknowledgement.
+    let (lease,bridge)=sail_namespace::Lease::pair()?;
+    retained_charge();
+    queue.send(ReporterMessage::PreparationNamespace(Box::new(NamespaceRequest{bridge,sources:Arc::clone(sources)}))).ok()?;
+    if !lease.ready(){return None;}
+    Some(operation(&|span|match provenance_key(span)?{
+        ProvenanceKey::Imported(words)=>lease.validate(words).then_some(()),
+        ProvenanceKey::Local(..)=>Some(()),
+    }))
