+}
+
+#[test]
+fn actual_typed_import_hash_kind_stable_id_and_unnormalized_length_are_bound() {
+    session(|| {
+        fn fingerprint(
+            kind: SourceFileHashAlgorithm,
+            changed_id: bool,
+            unnormalized: u32,
+        ) -> String {
+            let map = SourceMap::new(FilePathMapping::empty());
+            let name = FileName::Custom("dep.rs".into());
+            let stable_crate = rustc_span::def_id::StableCrateId::new(
+                Symbol::intern("dep"),
+                false,
+                Vec::new(),
+                "1.98.1",
+            );
+            let mut hash =
+                SourceFileHash::new_in_memory(SourceFileHashAlgorithm::Sha256, "abcdefgh");
+            // Pinned real-type adversarial input: same32 raw bytes, different
+            // typed algorithm. Original metadata cannot distinguish these tags.
+            hash.kind = kind;
+            let stable = if changed_id {
+                StableSourceFileId::default()
+            } else {
+                StableSourceFileId::from_filename_for_export(&name, stable_crate)
+            };
+            let file = map.new_imported_source_file(
+                name,
+                hash,
+                None,
+                stable,
+                8,
+                unnormalized,
+                CrateNum::new(2),
+                FreezeLock::new(SourceFileLines::Lines(vec![RelativeBytePos::from_u32(0)])),
+                Vec::new(),
+                Vec::new(),
+                0,
+            );
+            let (context, metadata) = fixture(&file);
+            let mut mapping =
+                sail_capture_loaded_imports(&context.imported_crates, &metadata, &map, crate_id)
+                    .unwrap();
+            mapping.revalidate(&context.imported_crates, &map);
+            let span = vir::messages::Span {
+                raw_span: Arc::new(()),
+                id: 563,
+                data: packed(1002, 1006).to_vec(),
+                as_string: "same exact current binding".into(),
+            };
+            crate::verifier::sail_test_import_provenance(&span, mapping).unwrap()
+        }
+        let original = fingerprint(SourceFileHashAlgorithm::Sha256, false, 8);
+        assert_ne!(
+            fingerprint(SourceFileHashAlgorithm::Blake3, false, 8),
+            original
+        );
+        assert_ne!(
+            fingerprint(SourceFileHashAlgorithm::Sha256, true, 8),
+            original
+        );
+        assert_ne!(
+            fingerprint(SourceFileHashAlgorithm::Sha256, false, 9),
+            original
+        );
+    });
+}
