+        assert!(aliased_fresh.fun_to_string(&foreign).starts_with("same!!2!"));
+        assert_eq!(renamed.prefix_fndef_type_id(&f.x.name).as_str(), format!("FNDEF%{selected}"));
+        let stem = Arc::new(renamed.fun_to_string(&f.x.name));
