+//! Opt-in observations from Cargo's ordinary native Rust compiler path.
+//!
+//! This is a single genuine compiler phase, not a verification record. The
+//! consumer must bind the actual child PID, require its successful exit and
+//! separately account for native dependencies and extra tracked inputs.
+
+use rustc_middle::ty::TyCtxt;
+use serde_json::{Value, json};
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::path::PathBuf;
+use std::sync::Mutex;
+
+#[derive(PartialEq, Eq)]
+struct Request {
+    directory: PathBuf,
+    binding: String,
+}
+
+struct Pending {
+    request: Request,
+    inputs: Option<Value>,
+    failed: bool,
+}
+
+static PENDING: Mutex<Option<Pending>> = Mutex::new(None);
+
+pub(crate) fn requested() -> bool {
+    request().is_some()
+}
+
+fn request() -> Option<Request> {
+    let directory = PathBuf::from(std::env::var_os("SAIL_NATIVE_COMPILER_INPUTS")?);
+    let binding = std::env::var("SAIL_NATIVE_COMPILER_INPUTS_BINDING").ok()?;
+    if !directory.is_absolute()
+        || binding.len() != 64
+        || !binding.bytes().all(|b| b.is_ascii_hexdigit())
+    {
+        return None;
+    }
+    Some(Request { directory, binding })
+}
+
+impl Pending {
+    fn insert(&mut self, request: &Request, inputs: Option<Value>) {
+        // A second callback or a changed request cannot replace the earlier
+        // compiler observation, even if a later one looks admissible.
+        if self.request != *request || self.inputs.is_some() || inputs.is_none() {
+            self.failed = true;
+        } else {
+            self.inputs = inputs;
+        }
+    }
+
+    fn document(&self, request: &Request, pid: u32) -> Option<Value> {
+        if self.failed || self.request != *request || pid == 0 {
+            return None;
+        }
+        Some(json!({
+            "kind": "sail-native-compiler-read-inputs",
+            "schema": 1,
+            "binding": request.binding,
+            "pid": pid,
+            "complete": true,
+            "inputs": self.inputs.as_ref()?,
+        }))
+    }
+}
+
+/// Capture the actual source map after native Rust analysis. The callback
+/// always continues normal compilation; observation failure changes no output.
+pub(crate) fn record(tcx: TyCtxt<'_>) {
+    let Some(request) = request() else {
+        return;
+    };
+    let inputs = crate::sail_compiler_inputs::phase_record(tcx);
+    let Ok(mut pending) = PENDING.lock() else {
+        return;
+    };
+    if let Some(pending) = pending.as_mut() {
+        pending.insert(&request, inputs);
+    } else {
+        let mut state = Pending { request, inputs: None, failed: false };
+        let same_request = Request {
+            directory: state.request.directory.clone(),
+            binding: state.request.binding.clone(),
+        };
+        state.insert(&same_request, inputs);
+        *pending = Some(state);
+    }
+}
+
+/// Only a normal return from the genuine native compiler can write this
+/// completion record. The consumer must additionally check the child's exit.
+pub(crate) fn finish() {
+    let Some(request) = request() else {
+        return;
+    };
+    let Ok(pending) = PENDING.lock() else {
+        return;
+    };
+    let Some(document) =
+        pending.as_ref().and_then(|pending| pending.document(&request, std::process::id()))
+    else {
+        return;
+    };
+    let Ok(bytes) = serde_json::to_vec(&document) else {
+        return;
+    };
+    if bytes.len() > 8 * 1024 * 1024 {
+        return;
+    }
+    if let Ok(mut file) =
+        OpenOptions::new().write(true).create_new(true).open(request.directory.join("inputs.json"))
+    {
+        let _ = file.write_all(&bytes);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{Pending, Request};
+    use serde_json::json;
+
+    fn request() -> Request {
+        Request { directory: "/sail/native-inputs".into(), binding: "a".repeat(64) }
+    }
+
+    #[test]
+    fn native_observation_is_distinct_complete_and_bound() {
+        let mut pending = Pending { request: request(), inputs: None, failed: false };
+        assert!(pending.document(&request(), 42).is_none());
+        pending.insert(
+            &request(),
+            Some(json!({"sources":{"lib.rs":{"checksum":"blake3=abc","size":3}}})),
+        );
+        let document = pending.document(&request(), 42).unwrap();
+        assert_eq!(document["kind"], "sail-native-compiler-read-inputs");
+        assert_eq!(document["pid"], 42);
+        assert!(pending.document(&request(), 0).is_none());
+        let mut other = request();
+        other.binding = "b".repeat(64);
+        assert!(pending.document(&other, 42).is_none());
+        other = request();
+        other.directory = "/sail/other".into();
+        assert!(pending.document(&other, 42).is_none());
+        pending.insert(&request(), Some(json!({"sources":{}})));
+        assert!(pending.document(&request(), 42).is_none());
+    }
+
+    #[test]
+    fn failed_or_changed_native_observations_never_recover() {
+        let mut pending = Pending { request: request(), inputs: None, failed: false };
+        pending.insert(&request(), None);
+        pending.insert(&request(), Some(json!({"sources":{}})));
+        assert!(pending.document(&request(), 42).is_none());
+        let mut pending = Pending { request: request(), inputs: None, failed: false };
+        let mut other = request();
+        other.binding = "b".repeat(64);
+        pending.insert(&other, Some(json!({"sources":{}})));
+        assert!(pending.document(&request(), 42).is_none());
+    }
+}
diff --git a/source/rust_verify/src/sail_source_base.rs b/source/rust_verify/src/sail_source_base.rs
new file mode 100644
index 00000000..c7b80475
--- /dev/null
+++ b/source/rust_verify/src/sail_source_base.rs
@@ -0,0 +1,130 @@
+//! Sail: registry sources that a prebuilt crate names by rustc's virtual
+//! rustc-dev source base.
+//!
+//! Sail ships vstd and its dependency closure prebuilt (Sail ADR 0048). The
+//! release compiles them with `--remap-path-prefix <registry source
+//! directory>=<virtual>`, where `<virtual>` is the virtual rustc-dev source
+//! base this rustc was built with (`/rustc-dev/<rustc commit hash>`). When a
+//! later compilation imports such a crate, rustc translates every file name
+//! under that base to `real_rustc_dev_source_base_dir` joined with the rest of
+//! the name (`rustc_metadata` `imported_source_file`) and reads the source
+//! from there. Pointing that option at the user's own registry source
+//! directory therefore makes diagnostics name and quote the user's real file,
+//! exactly as for a crate compiled on the user's machine.
+//!
+//! `SAIL_RUSTC_DEV_SOURCE_BASE=<virtual>=<real>` selects this. Without the
+//! variable nothing changes. Verus's exported VIR also records each source
+//! file's canonical path for files rustc did not import (`FileStartEndPos`);
+//! [`exported_name`] records those under `<virtual>` and [`imported_name`]
+//! maps them back to `<real>`.
+
+use std::path::PathBuf;
+
+/// The variable naming the virtual base and the real registry source
+/// directory, as `<virtual>=<real>`.
+pub const ENV: &str = "SAIL_RUSTC_DEV_SOURCE_BASE";
+
+struct Mapping {
+    virtual_base: PathBuf,
+    real_base: PathBuf,
+}
+
+fn mapping() -> Option<Mapping> {
+    let value = std::env::var_os(ENV)?;
+    let (virtual_base, real_base) = value.to_str()?.split_once('=')?;
+    let mapping =
+        Mapping { virtual_base: PathBuf::from(virtual_base), real_base: PathBuf::from(real_base) };
+    (mapping.virtual_base.is_absolute() && mapping.real_base.is_absolute()).then_some(mapping)
+}
+
+/// Points rustc's rustc-dev source translation at the real registry source
+/// directory. Every compilation the driver runs calls this from its
+/// `Callbacks::config`.
+pub fn configure(config: &mut rustc_interface::interface::Config) {
+    if let Some(mapping) = mapping() {
+        config.opts.real_rustc_dev_source_base_dir = Some(mapping.real_base);
+    }
+}
+
+/// The canonical form of the real base, as Verus records exported file names
+/// canonically.
+fn canonical_real(mapping: &Mapping) -> PathBuf {
+    mapping.real_base.canonicalize().unwrap_or_else(|_| mapping.real_base.clone())
+}
+
+/// The name an exported VIR crate records for a local source file: under the
+/// virtual base when the file lies in the real registry source directory.
+pub(crate) fn exported_name(path: PathBuf) -> PathBuf {
+    let Some(mapping) = mapping() else {
+        return path;
+    };
+    match path.strip_prefix(canonical_real(&mapping)) {
+        Ok(rest) => mapping.virtual_base.join(rest),
+        Err(_) => path,
+    }
+}
+
+/// The file an imported VIR crate's recorded name refers to on this machine:
+/// the canonical real registry source directory for a name under the virtual
+/// base, as Verus would have recorded it had the crate been compiled here.
+pub(crate) fn imported_name(path: PathBuf) -> PathBuf {
+    let Some(mapping) = mapping() else {
+        return path;
+    };
+    match path.strip_prefix(&mapping.virtual_base) {
+        Ok(rest) => canonical_real(&mapping).join(rest),
+        Err(_) => path,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::Path;
+
+    fn with_env<T>(value: Option<&str>, f: impl FnOnce() -> T) -> T {
+        // SAFETY: library tests that touch this variable run in this one test.
+        unsafe {
+            match value {
+                Some(value) => std::env::set_var(ENV, value),
+                None => std::env::remove_var(ENV),
+            }
+        }
+        let result = f();
+        unsafe { std::env::remove_var(ENV) };
+        result
+    }
+
+    #[test]
+    fn names_map_between_virtual_and_real_bases_only_when_selected() {
+        let dir = std::env::temp_dir().join(format!("sail-source-base-{}", std::process::id()));
+        let real = dir.join("registry/src/index");
+        std::fs::create_dir_all(&real).unwrap();
+        let canonical = real.canonicalize().unwrap();
+        let file = canonical.join("vstd-0.1.0/src/seq.rs");
+        let virtual_file = Path::new("/rustc-dev/0123/vstd-0.1.0/src/seq.rs");
+        let value = format!("/rustc-dev/0123={}", real.display());
+        with_env(Some(&value), || {
+            assert_eq!(exported_name(file.clone()), virtual_file);
+            assert_eq!(imported_name(virtual_file.to_path_buf()), file);
+            // Names elsewhere are unchanged in both directions.
+            assert_eq!(
+                exported_name(PathBuf::from("/elsewhere/a.rs")),
+                Path::new("/elsewhere/a.rs")
+            );
+            assert_eq!(
+                imported_name(PathBuf::from("/rustc/0123/a.rs")),
+                Path::new("/rustc/0123/a.rs")
+            );
+        });
+        with_env(None, || {
+            assert_eq!(exported_name(file.clone()), file);
+            assert_eq!(imported_name(virtual_file.to_path_buf()), virtual_file);
+        });
+        // A relative base is ignored.
+        with_env(Some("rustc-dev/0123=registry"), || {
+            assert_eq!(imported_name(virtual_file.to_path_buf()), virtual_file);
+        });
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+}
diff --git a/source/rust_verify/src/sail_vir_span_remap.rs b/source/rust_verify/src/sail_vir_span_remap.rs
new file mode 100644
index 00000000..124e91d0
--- /dev/null
+++ b/source/rust_verify/src/sail_vir_span_remap.rs
@@ -0,0 +1,111 @@
+//! Sail: span strings of a prebuilt crate's VIR as a local build records them.
+//!
+//! Verus records each span's text (`Span::as_string`) in the VIR it exports.
+//! A standard library span reads `/rustc/<rustc commit>/library/...` when the
+//! exporting toolchain has no `rust-src` component, and
+//! `<sysroot>/lib/rustlib/src/rust/library/...` when it has one, because rustc
+//! then translates the virtual path to the local copy. Verus prints the stored
+//! text where it cannot resolve an imported span. Sail ships vstd prebuilt
+//! with the virtual names (Sail VI-0031); for a user whose toolchain has
+//! `rust-src`, a vstd compiled on that machine would hold the local names.
+//!
+//! The same holds for the prebuilt crates' own registry sources, which Sail
+//! records under rustc's virtual rustc-dev base (Sail ADR 0048) where a local
+//! build names the user's registry directory.
+//!
+//! `SAIL_VIR_SPAN_REMAP` holds one `<from>=<to>` pair per line. The import
+//! rewrites every span string of imported VIR that starts with a pair's
+//! `<from>` to start with its `<to>` instead; pairs are tried in order and the
+//! first match wins. Sail sets the pairs only when it serves prebuilt VIR:
+//! `/rustc/<rustc commit>/=<sysroot>/lib/rustlib/src/rust/` (rustc's own
+//! translation) when the toolchain has `rust-src`, and the rustc-dev base of
+//! the registry sources to the user's registry directory. Each prefix must be
+//! an absolute path; a malformed line selects nothing at all. Without the
+//! variable nothing changes.
+
+/// The variable naming the recorded prefixes and their replacements, one
+/// `<from>=<to>` pair per line.
+pub const ENV: &str = "SAIL_VIR_SPAN_REMAP";
+
+/// The selected pairs, in order: each split at its first `=`, both prefixes
+/// absolute paths. Any malformed line, or a non-UTF-8 value, selects none.
+pub(crate) fn remap() -> Vec<(String, String)> {
+    let Some(value) = std::env::var_os(ENV) else {
+        return Vec::new();
+    };
+    let Some(value) = value.to_str() else {
+        return Vec::new();
+    };
+    let mut pairs = Vec::new();
+    for line in value.lines() {
+        match line.split_once('=') {
+            Some((from, to)) if from.starts_with('/') && to.starts_with('/') => {
+                pairs.push((from.to_owned(), to.to_owned()))
+            }
+            _ => return Vec::new(),
+        }
+    }
+    pairs
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn with_env<T>(value: Option<&str>, f: impl FnOnce() -> T) -> T {
+        // SAFETY: library tests that touch this variable run in this one test.
+        unsafe {
+            match value {
+                Some(value) => std::env::set_var(ENV, value),
+                None => std::env::remove_var(ENV),
+            }
+        }
+        let result = f();
+        unsafe { std::env::remove_var(ENV) };
+        result
+    }
+
+    fn imported(span: &str) -> String {
+        let original = vir::messages::Span {
+            raw_span: std::sync::Arc::new(()),
+            id: 0,
+            data: vec![1, 2],
+            as_string: span.to_owned(),
+        };
+        let config = bincode_next::config::legacy();
+        let bytes = bincode_next::serde::encode_to_vec(&original, config).unwrap();
+        let decoded: vir::messages::Span = vir::messages::with_imported_span_remap(remap(), || {
+            bincode_next::serde::decode_from_slice(&bytes, config).unwrap().0
+        });
+        assert_eq!(decoded.data, vec![1, 2]);
+        decoded.as_string
+    }
+
+    #[test]
+    fn imported_span_strings_change_prefix_only_when_selected() {
+        let std_span = "/rustc/0123/library/core/src/marker.rs:1025:10: 1025:17 (#0)";
+        let local = "/sysroot/lib/rustlib/src/rust/library/core/src/marker.rs:1025:10: 1025:17 (#0)";
+        let other = "/home/user/src/lib.rs:3:1: 3:9 (#0)";
+        with_env(Some("/rustc/0123/=/sysroot/lib/rustlib/src/rust/"), || {
+            assert_eq!(imported(std_span), local);
+            assert_eq!(imported(other), other);
+        });
+        with_env(None, || assert_eq!(imported(std_span), std_span));
+        // Several pairs: each applies to its own prefix, the first match wins.
+        let registry = "/rustc-dev/0123/vstd-1/src/seq.rs:5:1: 5:9 (#0)";
+        let pairs = "/rustc/0123/=/sysroot/lib/rustlib/src/rust/\n\
+                     /rustc-dev/0123/=/home/user/.cargo/registry/src/index/\n\
+                     /rustc/=/never/";
+        with_env(Some(pairs), || {
+            assert_eq!(imported(std_span), local);
+            assert_eq!(imported(registry), "/home/user/.cargo/registry/src/index/vstd-1/src/seq.rs:5:1: 5:9 (#0)");
+            assert_eq!(imported(other), other);
+        });
+        // Malformed or relative values select nothing.
+        with_env(Some("rustc/0123/=/sysroot/"), || assert_eq!(imported(std_span), std_span));
+        with_env(Some("/rustc/0123/"), || assert_eq!(imported(std_span), std_span));
+        with_env(Some("/rustc/0123/=/sysroot/\nrelative=/x/"), || {
+            assert_eq!(imported(std_span), std_span)
+        });
+    }
+}
