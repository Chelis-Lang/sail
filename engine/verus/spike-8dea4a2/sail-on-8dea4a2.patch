diff --git a/.github/sail/check-dbg-locations.py b/.github/sail/check-dbg-locations.py
new file mode 100755
index 00000000..2247b86d
--- /dev/null
+++ b/.github/sail/check-dbg-locations.py
@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""Every `dbg!` in upstream's verifier sources must sit at the same file:line
+in the fork (SAIL.md, "Divergences from upstream").
+
+`dbg!` prints `[file:line:column]`, and Verus reaches some of them in ordinary
+diagnostics (Reporter::report_as prints an unresolvable label span with one),
+so a fork edit that shifts such a line changes stderr against stock.
+
+    check-dbg-locations.py [--base REV]
+
+REV defaults to the newest `upstream/*` branch (local, or `origin/upstream/*`)
+that is an ancestor of HEAD, the fork's upstream base. Exit 1 lists every moved
+or changed `dbg!` line.
+"""
+import argparse
+import subprocess
+import sys
+
+
+def git(*args):
+    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout
+
+
+def base():
+    refs = git("for-each-ref", "--sort=-committerdate", "--format=%(refname)",
+               "refs/heads/upstream/", "refs/remotes/origin/upstream/").split()
+    for ref in refs:
+        if subprocess.run(["git", "merge-base", "--is-ancestor", ref, "HEAD"]).returncode == 0:
+            return ref
+    sys.exit("no upstream/* branch is an ancestor of HEAD; pass --base")
+
+
+def dbg_lines(text):
+    return [(n, line) for n, line in enumerate(text.splitlines(), 1)
+            if "dbg!(" in line and not line.lstrip().startswith("//")]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--base")
+    rev = parser.parse_args().base or base()
+    files = [f for f in git("ls-tree", "-r", "--name-only", rev, "source").split()
+             if f.endswith(".rs") and "/tests/" not in f]
+    problems, checked = [], 0
+    for path in files:
+        expected = dbg_lines(git("show", f"{rev}:{path}"))
+        if not expected:
+            continue
+        try:
+            with open(path) as f:
+                actual = f.read().splitlines()
+        except FileNotFoundError:
+            problems.append(f"{path}: missing in the fork")
+            continue
+        for number, line in expected:
+            checked += 1
+            if number > len(actual) or actual[number - 1] != line:
+                problems.append(f"{path}:{number}: expected {line.strip()!r}")
+    for problem in problems:
+        print(problem)
+    print(f"{checked - len(problems)} of {checked} dbg! lines at upstream's location ({rev})")
+    return 1 if problems else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/.github/workflows/sail-fork.yml b/.github/workflows/sail-fork.yml
new file mode 100644
index 00000000..a067f100
--- /dev/null
+++ b/.github/workflows/sail-fork.yml
@@ -0,0 +1,103 @@
+# The fork's own CI (see SAIL.md). Upstream's workflows are disabled in this
+# repository. Linux x86-64 only: macOS runtimes are built and qualified locally
+# by Sail's release tooling.
+name: sail-fork
+
+on:
+  push:
+    branches: [sail]
+  pull_request:
+    branches: [sail]
+  workflow_dispatch:
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read
+
+jobs:
+  build-and-test:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 60
+    defaults:
+      run:
+        shell: bash
+    env:
+      CARGO_TERM_COLOR: always
+    steps:
+      - name: checkout
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+          fetch-depth: 0
+
+      # dbg! prints its file:line, and Verus reaches some in diagnostics, so
+      # the fork must not move upstream's (SAIL.md).
+      - name: dbg! locations match the upstream base
+        run: |
+          git fetch --no-tags origin '+refs/heads/upstream/*:refs/remotes/origin/upstream/*'
+          python3 .github/sail/check-dbg-locations.py
+
+      # Installs exactly what rust-toolchain.toml lists (including rustc-dev).
+      - name: install the pinned Rust toolchain
+        run: |
+          rustup --version
+          rustup toolchain install
+          rustc --version
+
+      # Caches only vargo's and cargo's own target directories. Verus's
+      # build (target-verus) is rebuilt from the checked-out source each run.
+      - name: cache
+        uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2
+        with:
+          workspaces: |
+            tools/vargo -> target
+            source -> target
+
+      - name: get z3
+        working-directory: ./source
+        run: |
+          ./tools/get-z3.sh
+          # The Linux x86-64 Z3 Sail pins (engine/verus/artifact-linux.json).
+          echo "e583c4186a45e72411fa2cb2048401eed03f0f8e5f24694676a8f6271a50b765  z3" | sha256sum -c
+          ./z3 --version
+          echo "VERUS_Z3_PATH=$PWD/z3" >> "$GITHUB_ENV"
+
+      - name: build vargo
+        working-directory: ./tools/vargo
+        run: |
+          cargo build --release
+          echo "$PWD/target/release" >> "$GITHUB_PATH"
+
+      # Builds Verus and builds and verifies vstd.
+      - name: build Verus and verify vstd
+        working-directory: ./source
+        run: vargo build --release
+
+      # Library tests of the crates the engine commit changes. vargo test
+      # only takes rust_verify_test, so these use cargo directly (as Sail's
+      # engine qualification does).
+      - name: rust_verify, vir and air library tests
+        working-directory: ./source
+        run: |
+          cargo test --release -p rust_verify --lib
+          cargo test --release -p vir --lib
+          cargo test --release -p air --lib
+
+      - name: fork regression tests and basic tests
+        working-directory: ./source
+        run: |
+          tests=()
+          for f in rust_verify_test/tests/sail_vi*.rs; do
+            tests+=(--test "$(basename "$f" .rs)")
+          done
+          echo "running: ${tests[*]} --test basic"
+          vargo test --release -p rust_verify_test "${tests[@]}" --test basic
+
+      # The release-style vstd build Sail's engine runtime uses (as upstream's
+      # release workflow does): verifies vstd from source/vstd with cargo-verus.
+      - name: release-style vstd build
+        working-directory: ./source
+        run: ./target-verus/release/cargo-verus build --release --manifest-path vstd/Cargo.toml
