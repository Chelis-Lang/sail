+    #[test]
+    fn fixed_table_and_dynamic_ownership_refuse_growth_without_changing_hash(){
+        assert!(std::mem::size_of::<(ProvenanceKey,String)>()<=96);
+        let mut memo=ProvenanceMemo::default();
+        for n in 0..20000{memo.insert(ProvenanceKey::Imported([n,n+1]),"0123456789012345678901234567890123456789012345678901234567890123");}
+        assert!(memo.values.len()<20000);
+        let capacity=memo.values.capacity();assert!(capacity>=4096 && capacity<=8192);
+        assert!(memo.charge()+PROVENANCE_TRANSIENT<=PROVENANCE_BUDGET);
+        memo.insert(ProvenanceKey::Local(0,0,"x".repeat(PROVENANCE_BUDGET),None),"oversized");
+        assert_eq!(memo.values.capacity(),capacity);
+        assert!(memo.charge()+PROVENANCE_TRANSIENT<=PROVENANCE_BUDGET);
+        let mut dynamic=ProvenanceMemo::default();
+        for n in 0..10000{dynamic.insert(ProvenanceKey::Local(0,0,format!("{n:01024}"),None),"0123456789012345678901234567890123456789012345678901234567890123");}
+        assert!(dynamic.values.len()<dynamic.values.capacity(),"dynamic key ownership must refuse before table fills");
+        assert!(dynamic.charge()+PROVENANCE_TRANSIENT<=PROVENANCE_BUDGET);
+        let mut text=SpanDebug(String::new());
+        assert!(std::fmt::Write::write_str(&mut text,&"x".repeat(1024)).is_ok());
+        assert!(std::fmt::Write::write_str(&mut text,"x").is_err());
+        assert!(text.0.capacity()<=1024);
+        let sources=inventory("fresh");
+        for n in 0..20000{let _=provenance(&imported(vec![n,n+1]),&sources);}
+        assert!(sources.2.lock().unwrap().values.len()<20000);
+        let span=imported(vec![90000,90001]);
+        assert_eq!(provenance(&span,&sources),provenance_uncached(&span,&sources));
+        assert!(!sources.2.lock().unwrap().values.contains_key(&ProvenanceKey::Imported([90000,90001])));
+    }
