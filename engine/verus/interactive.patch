+thread_local! {
+    static SAIL_COLLECT: std::cell::RefCell<Option<SailCollected>> = const { std::cell::RefCell::new(None) };
+    static SAIL_RESOLVE: std::cell::RefCell<Option<SailSpanBindings>> = const { std::cell::RefCell::new(None) };
+}
+enum SailSpanScope { Collect(Option<SailCollected>), Resolve(Option<SailSpanBindings>) }
+impl Drop for SailSpanScope {
+    fn drop(&mut self) {
+        match self {
+            Self::Collect(previous)=>SAIL_COLLECT.with(|state| *state.borrow_mut()=previous.take()),
+            Self::Resolve(previous)=>SAIL_RESOLVE.with(|state| *state.borrow_mut()=previous.take()),
+        }
+    }
+}
+pub fn sail_collect_spans<T>(f:impl FnOnce()->T)->(T,Option<SailSpanBindings>) {
+    let previous=SAIL_COLLECT.with(|state|state.replace(Some(SailCollected::default())));
+    let _scope=SailSpanScope::Collect(previous);
+    let result=f();
+    let bindings=SAIL_COLLECT.with(|state|{let state=state.borrow_mut().take().unwrap_or_default();if state.valid {state.bindings.into_iter().map(|(key,span)|span.map(|span|(key,span))).collect()}else{None}});
+    (result,bindings)
+}
+pub fn sail_resolve_spans<T>(bindings:&SailSpanBindings,f:impl FnOnce()->T)->T {
+    let previous=SAIL_RESOLVE.with(|state|state.replace(Some(bindings.clone())));
+    let _scope=SailSpanScope::Resolve(previous);f()
+}
+impl Serialize for Span {
+    fn serialize<S:serde::Serializer>(&self,serializer:S)->Result<S::Ok,S::Error> {
+        SAIL_COLLECT.with(|state| {if let Some(state)=state.borrow_mut().as_mut(){
+            if !state.valid{return;}
+            let charge=self.data.len().saturating_mul(16).saturating_add(self.as_string.len().saturating_mul(2)).saturating_add(1024);
+            if state.charge.saturating_add(charge)>16*1024*1024 {state.valid=false;return;}
+            let bindings=&mut state.bindings;
+            use std::collections::hash_map::Entry;
+            match bindings.entry((self.id,self.data.clone(),self.as_string.clone())) {
+                Entry::Vacant(entry)=>{entry.insert(Some(self.clone()));state.charge+=charge;},
+                Entry::Occupied(mut entry)=>{if entry.get().as_ref().is_some_and(|span|!Arc::ptr_eq(&span.raw_span,&self.raw_span) && !(((&*span.raw_span) as &dyn std::any::Any).is::<()>() && ((&*self.raw_span) as &dyn std::any::Any).is::<()>())){entry.insert(None);}},
+            }
+        }});
+        use serde::ser::SerializeStruct;
+        let mut encoded=serializer.serialize_struct("Span",3)?;
+        encoded.serialize_field("id",&self.id)?;
+        encoded.serialize_field("data",&self.data)?;
+        encoded.serialize_field("as_string",&self.as_string)?;
+        encoded.end()
+    }
+}
+impl<'de> Deserialize<'de> for Span {
+    fn deserialize<D:serde::Deserializer<'de>>(deserializer:D)->Result<Self,D::Error> {
+        #[derive(Deserialize)] struct Encoded {id:AstId,data:Vec<u64>,as_string:String}
+        let encoded=Encoded::deserialize(deserializer)?;
+        let raw_span=SAIL_RESOLVE.with(|state| {
+            let bindings=state.borrow();
+            match bindings.as_ref() {
+                None=>Ok(empty_raw_span()),
+                Some(bindings)=>bindings.get(&(encoded.id,encoded.data.clone(),encoded.as_string.clone()))
+                    .map(|span|span.raw_span.clone()).ok_or_else(||serde::de::Error::custom("prepared span has no exact current callback binding")),
+            }
+        })?;
+        Ok(Self {raw_span,id:encoded.id,data:encoded.data,as_string:encoded.as_string})
+    }
+}
