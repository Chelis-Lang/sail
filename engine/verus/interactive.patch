+            let wrap=|raw|vir::messages::Span{raw_span:Arc::new(raw),id:2,data:vec![10,100000],as_string:"same diagnostic".into()};
+            let original=provenance(&wrap(span),&sources).unwrap();
+            assert_eq!(provenance_uncached(&wrap(span),&sources).unwrap(),original);
+            for changed in [rustc_span::SpanData{lo:rustc_span::BytePos(11),..span},rustc_span::SpanData{hi:rustc_span::BytePos(99999),..span},rustc_span::SpanData{ctxt:rustc_span::SyntaxContext::root(),..span},rustc_span::SpanData{parent:None,..span},rustc_span::SpanData{parent:Some(rustc_span::def_id::LocalDefId{local_def_index:rustc_span::def_id::DefIndex::from_u32(4)}),..span}]{
