+    fn imported(data:Vec<u64>)->vir::messages::Span{vir::messages::Span{raw_span:Arc::new(()),id:1,data,as_string:"same diagnostic".into()}}
+    fn local()->vir::messages::Span{
+        vir::messages::Span{raw_span:Arc::new(rustc_span::SpanData{lo:rustc_span::BytePos(10),hi:rustc_span::BytePos(20),ctxt:rustc_span::SyntaxContext::root(),parent:None}),id:2,data:vec![10,20],as_string:"local diagnostic".into()}
+    }
+    #[test]
+    fn memo_preserves_complete_original_hash_and_owner_binding(){
+        let sources=inventory("one");
+        for span in [local(),imported(vec![1,2])]{
+            let original=provenance_uncached(&span,&sources).unwrap();
+            assert_eq!(provenance(&span,&sources).unwrap(),original);
+            assert_eq!(provenance(&span,&sources).unwrap(),original);
+        }
+        assert_eq!(sources.2.lock().unwrap().values.len(),2);
+        let changed=imported(vec![1,3]);
+        assert_ne!(provenance(&changed,&sources),provenance(&imported(vec![1,2]),&sources));
+        let other=inventory("two");
+        assert_ne!(provenance(&imported(vec![1,2]),&other),provenance(&imported(vec![1,2]),&sources));
+        let mut changed_local_owner=inventory("one");changed_local_owner.0[0].hash="changed-local-file".into();
+        assert_ne!(provenance(&local(),&changed_local_owner),provenance(&local(),&sources));
+        let mut altered=local();altered.raw_span=Arc::new(rustc_span::SpanData{lo:rustc_span::BytePos(11),hi:rustc_span::BytePos(21),ctxt:rustc_span::SyntaxContext::root(),parent:None});
+        assert_ne!(provenance(&altered,&sources),provenance(&local(),&sources));
+        assert_eq!(provenance(&imported(vec![1]),&sources),None);
+    }
+
