+struct FocusReporter { messages: RefCell<Messages>,charge:Cell<u64>,incomplete:Cell<bool> }
+impl Drop for FocusReporter{fn drop(&mut self){REPORT_BYTES.fetch_sub(self.charge.get(),Ordering::Relaxed);}}
