+//! Private batch session: all retained spans belong to the active compiler callback.
+use super::*;
+use std::cell::RefCell;
+use std::sync::atomic::{AtomicBool, Ordering};
+use sha2::{Digest, Sha256};
+static FOCUS: AtomicBool = AtomicBool::new(false);
+static CACHING: AtomicBool = AtomicBool::new(false);
+const BUDGET: usize = 512 * 1024 * 1024;
+type Messages = Vec<(ArcDynMessage, MessageLevel)>;
+struct Entry { sst: vir::sst::KrateSst, ctx: vir::context::Ctx, messages: Messages, charge: usize }
+#[derive(Default)]
+struct Cache {
+    common: Option<(usize, usize, GlobalCtx, Krate)>,
+    buckets: HashMap<String, Entry>,
+    charged: usize,
+}
+struct CacheCell(std::sync::Mutex<Cache>);
+impl CacheCell {
+    fn borrow(&self) -> std::sync::MutexGuard<'_, Cache> { self.0.lock().unwrap() }
+    fn borrow_mut(&self) -> std::sync::MutexGuard<'_, Cache> { self.0.lock().unwrap() }
+}
+fn with_cache<T>(f: impl FnOnce(&CacheCell)->T)->T {
+    static CACHE: std::sync::OnceLock<CacheCell> = std::sync::OnceLock::new();
+    f(CACHE.get_or_init(||CacheCell(std::sync::Mutex::new(Cache::default()))))
+}
+fn active() -> bool { std::env::var("SAIL_ENGINE").as_deref() == Ok("interactive") }
+pub(super) fn emit(kind: &str, payload: serde_json::Value) {
+    if !active() { return; }
+    let Some(path) = std::env::var_os("SAIL_ENGINE_EVENTS") else { return; };
+    let value = serde_json::json!({"version":1,"phase":if FOCUS.load(Ordering::Relaxed) {"focus"} else {"full"}, "event":kind,"payload":payload});
+    if let Ok(mut out) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(out, "{}", value);
+    }
+}
+pub(super) fn diagnostic(message: &ArcDynMessage, level: MessageLevel) {
+    if let Some(msg) = message.downcast_ref::<MessageX>() {
+        emit("diagnostic", serde_json::json!({"message":msg,"level":level}));
+    }
+}
+pub(super) fn clear() { CACHING.store(false,Ordering::Relaxed); with_cache(|cache| *cache.borrow_mut() = Cache::default()); }
+pub(super) fn take_common(v: &Verifier) -> Option<(GlobalCtx, Krate)> {
+    if !active() || !CACHING.load(Ordering::Relaxed) { return None; }
+    with_cache(|cache| {
+        let cache=cache.borrow();
+        let (krate,args,global,simplified)=cache.common.as_ref()?;
+        if *krate != Arc::as_ptr(v.vir_crate.as_ref()?) as usize || *args != Arc::as_ptr(&v.args) as usize { return None; }
+        // No mutations from SMT are shared back into this immutable baseline.
+        Some((global.clone(), simplified.clone()))
+    })
+}
+pub(super) fn store_common(v: &Verifier, global: &GlobalCtx, simplified: &Krate) {
+    if !active() || !CACHING.load(Ordering::Relaxed) { return; }
+    with_cache(|cache| cache.borrow_mut().common=Some((Arc::as_ptr(v.vir_crate.as_ref().unwrap()) as usize, Arc::as_ptr(&v.args) as usize, global.clone(), simplified.clone())));
+}
+pub(super) fn bucket_key(v: &Verifier, bucket: &BucketId, krate: &Krate, ctx: &vir::context::Ctx) -> String {
+    if !CACHING.load(Ordering::Relaxed) || v.args.log_all || v.args.log_args.log_vir_sst || v.args.log_args.log_interpreter || v.args.log_args.log_call_graph { return String::new(); }
+    // The shared baseline supplies the *same* exact globals, graph order and options.
+    // Cache lifetime is shorter than the live compiler callback; no cross-revision spans.
+    let bytes = format!("{:p}:{:p}:{:?}:{:?}:{:?}", Arc::as_ptr(v.vir_crate.as_ref().unwrap()),Arc::as_ptr(&v.args),bucket, { let mut funs=v.get_bucket(bucket).funs.iter().map(fun_as_friendly_rust_name).collect::<Vec<_>>();funs.sort();funs }, krate);
+    let bytes=format!("{bytes}:{}",ctx.sail_baseline());
+    format!("{:x}", Sha256::digest(bytes.as_bytes()))
+}
+pub(super) fn take_bucket(key: &str) -> Option<(vir::sst::KrateSst,vir::context::Ctx)> {
+    if key.is_empty() || !active() || !CACHING.load(Ordering::Relaxed) { return None; }
+    with_cache(|cache| cache.borrow().buckets.get(key).map(|e|(e.sst.clone(),e.ctx.clone())))
+}
+pub(super) fn store_bucket(key: String, sst: &vir::sst::KrateSst, ctx: &vir::context::Ctx, messages: Messages) {
+    if key.is_empty() || !active() || !CACHING.load(Ordering::Relaxed) { return; }
+    // Conservative charge includes expanded debug representation; saturation avoids overflow.
+    let charge=format!("{:?}",sst).len().saturating_mul(8).saturating_add(1024*1024);
+    if charge>BUDGET { return; }
+    with_cache(|cache| {
+        let mut cache=cache.borrow_mut();
+        if cache.charged.saturating_add(charge)>BUDGET { cache.buckets.clear();cache.charged=0; }
+        if let Some(previous)=cache.buckets.insert(key,Entry{sst:sst.clone(),ctx:ctx.clone(),messages,charge}) { cache.charged=cache.charged.saturating_sub(previous.charge); }
+        cache.charged+=charge;
+    });
+}
+pub(super) fn replay_bucket_diagnostics(key: &str, reporter: &impl Diagnostics) {
+    with_cache(|cache| {
+        if let Some(entry)=cache.borrow().buckets.get(key) {
+            for (message,level) in &entry.messages { reporter.report_as(message,*level); }
+        }
+    });
+}
+pub(super) struct RecordingReporter<'a,T> { reporter: &'a T, messages: RefCell<Messages> }
+impl<'a,T:Diagnostics> RecordingReporter<'a,T> {
+    pub fn new(reporter:&'a T)->Self{Self{reporter,messages:RefCell::new(Vec::new())}}
+    pub fn messages(&self)->Messages{self.messages.borrow().clone()}
+}
+impl<T:Diagnostics> air::messages::Diagnostics for RecordingReporter<'_,T> {
+    fn report_as(&self,msg:&ArcDynMessage,level:MessageLevel){self.messages.borrow_mut().push((msg.clone(),level));self.reporter.report_as(msg,level);}
+    fn report(&self,msg:&ArcDynMessage){self.report_as(msg,msg.downcast_ref::<MessageX>().unwrap().level);}
+    fn report_now(&self,msg:&ArcDynMessage){self.report(msg);}
+    fn report_as_now(&self,msg:&ArcDynMessage,level:MessageLevel){self.report_as(msg,level);}
+}
+impl<T:Diagnostics> Diagnostics for RecordingReporter<'_,T> {
+    fn use_progress_bars(&self)->bool{false}
+    fn add_progress_bar(&self,_:CommandContext){}
+    fn complete_progress_bar(&self,_:CommandContext){}
+}
+#[derive(Default)]
+struct FocusReporter { messages: RefCell<Messages> }
+impl air::messages::Diagnostics for FocusReporter {
+    fn report_as(&self,msg:&ArcDynMessage,level:MessageLevel){ self.messages.borrow_mut().push((msg.clone(),level));diagnostic(msg,level); }
+    fn report(&self,msg:&ArcDynMessage){self.report_as(msg,msg.downcast_ref::<MessageX>().unwrap().level);}
+    fn report_now(&self,msg:&ArcDynMessage){self.report(msg);}
+    fn report_as_now(&self,msg:&ArcDynMessage,level:MessageLevel){self.report_as(msg,level);}
+}
+impl Diagnostics for FocusReporter {
+    fn use_progress_bars(&self)->bool{false}
+    fn add_progress_bar(&self,_:CommandContext){}
+    fn complete_progress_bar(&self,_:CommandContext){}
+}
+impl Verifier {
+    pub(super) fn sail_focus(&mut self, compiler: &Compiler, spans:&SpanContext) {
+        if !active() { return; }
+        clear();
+        let Ok(name)=std::env::var("SAIL_ENGINE_FUNCTION") else { return; };
+        let krate=self.vir_crate.as_ref().unwrap();
+        let matches=krate.functions.iter().filter(|f| fun_as_friendly_rust_name(&f.x.name)==name).collect::<Vec<_>>();
+        if matches.len()!=1 { emit("focus-unavailable",serde_json::json!({"function":name,"matches":matches.len()}));return; }
+        CACHING.store(true,Ordering::Relaxed);
+        let selected=matches[0];
+        let module=selected.x.owning_module.clone().unwrap();
+        let mut focus=self.from_self();
+        focus.num_threads=1;
+        focus.user_filter=Some(UserFilter::Function(module.segments.clone(),name.clone(),HashSet::from([selected.x.name.clone()])));
+        let log=self.args.log_dir.as_ref().map(|p|std::path::PathBuf::from(p).join("focus"));
+        if let Some(path)=log { let _=std::fs::create_dir_all(&path);focus.created_log_dir=Arc::new(std::sync::Mutex::new(Some(path.clone())));focus.created_solver_log_dir=Arc::new(std::sync::Mutex::new(Some(path))); }
+        FOCUS.store(true,Ordering::Relaxed);
+        emit("phase-started",serde_json::json!({"function":name}));
+        let reporter=FocusReporter::default();
+        let status=focus.verify_crate_inner(compiler,spans,&reporter);
+        let mut functions=serde_json::Map::new();
+        for (fun,details) in &focus.func_details { functions.insert(fun_as_friendly_rust_name(fun),details.to_json()); }
+        let mut times=Vec::new();
+        for (bucket, stats) in &focus.func_times { let mut fns=Vec::new(); for (fun,stats) in stats { fns.push(serde_json::json!({"function":fun_as_friendly_rust_name(fun),"mode:":focus.get_function_mode(fun).map(|m|m.to_string()),"time-micros":stats.smt_time.as_micros(),"rlimit":stats.rlimit_count,"success":!focus.func_fails.contains(fun)})); } times.push(serde_json::json!({"module":module_name(bucket.module()),"function-breakdown":fns})); }
+        let diagnostics=reporter.messages.borrow().iter().filter_map(|(msg,level)|msg.downcast_ref::<MessageX>().map(|msg|serde_json::json!({"message":msg,"level":level}))).collect::<Vec<_>>();
+        let document=serde_json::json!({"version":1,"function":name,"confirmed":false,"diagnostics":diagnostics,"verus":{"func-details":functions,"verification-results":{"encountered-error":status.is_err(),"encountered-vir-error":focus.encountered_vir_error,"verified":focus.count_verified,"errors":focus.count_errors,"is-verifying-entire-crate":false},"times-ms":{"smt":{"smt-run-module-times":times}}}});
+        if let Some(path)=std::env::var_os("SAIL_ENGINE_FOCUS_REPORT") { let _=std::fs::write(path,document.to_string()); }
+        emit("phase-finished",serde_json::json!({"function":name,"errors":focus.count_errors,"confirmed":false}));
+        FOCUS.store(false,Ordering::Relaxed);
+        emit("phase-started",serde_json::json!({}));
+    }
+}
