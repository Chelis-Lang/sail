+// Encode complete typed lookup entries. Ordering belongs only to ordered IR,
+// vectors and graph edges; these tables are consumed by keyed lookup.
+const SAIL_KEY_LIMIT:usize=32*1024*1024;
+struct SailKeyWriter(Vec<u8>);
+impl std::io::Write for SailKeyWriter {
+    fn write(&mut self,bytes:&[u8])->std::io::Result<usize>{
+        let needed=self.0.len().checked_add(bytes.len()).ok_or_else(||std::io::Error::other("prepared key budget"))?;
+        if needed>SAIL_KEY_LIMIT{return Err(std::io::Error::other("prepared key budget"));}
+        // Small lookup entries must not each reserve a page; capacity remains charged.
+        if needed>self.0.capacity(){let capacity=needed.max(self.0.capacity().saturating_mul(2)).max(64).min(SAIL_KEY_LIMIT);self.0.try_reserve_exact(capacity-self.0.len()).map_err(std::io::Error::other)?;}
+        if self.0.capacity()>SAIL_KEY_LIMIT{return Err(std::io::Error::other("prepared key allocation budget"));}
+        self.0.extend_from_slice(bytes);Ok(bytes.len())
+    }
+    fn flush(&mut self)->std::io::Result<()>{Ok(())}
+}
+pub fn sail_encode<T:serde::Serialize>(value:&T)->Option<Vec<u8>> {
+    let mut out=SailKeyWriter(Vec::new());
+    bincode_next::serde::encode_into_std_write(value,&mut out,bincode_next::config::legacy()).ok()?;Some(out.0)
+}
+fn sail_map<K:serde::Serialize,V:serde::Serialize>(map:&HashMap<K,V>,budget:&mut usize)->Option<Vec<(Vec<u8>,Vec<u8>)>> {
+    let overhead=map.len().checked_mul(std::mem::size_of::<(Vec<u8>,Vec<u8>)>())?;
+    *budget=budget.checked_add(overhead)?;if *budget>SAIL_KEY_LIMIT{return None;}
+    let mut entries=Vec::new();entries.try_reserve_exact(map.len()).ok()?;
+    for (key,value) in map {let key=sail_encode(key)?;let value=sail_encode(value)?;
+        *budget=budget.checked_add(key.capacity())?.checked_add(value.capacity())?;
+        if *budget>SAIL_KEY_LIMIT{return None;}entries.push((key,value));}
+    entries.sort();Some(entries)
+}
+fn sail_set<K:serde::Serialize>(set:&HashSet<K>,budget:&mut usize)->Option<Vec<Vec<u8>>> {
+    *budget=budget.checked_add(set.len().checked_mul(std::mem::size_of::<Vec<u8>>())?)?;if *budget>SAIL_KEY_LIMIT{return None;}
+    let mut entries=Vec::new();entries.try_reserve_exact(set.len()).ok()?;
+    for key in set {let value=sail_encode(key)?;*budget=budget.checked_add(value.capacity())?;
+        if *budget>SAIL_KEY_LIMIT{return None;}entries.push(value);}
+    entries.sort();Some(entries)
+}
