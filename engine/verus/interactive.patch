+mod provenance_memo_tests {
+    use super::*;
+    fn inventory(hash:&str)->Sources {
+        Sources(vec![SourceOwner{index:0,name:"local.rs".into(),start:0,length:100,hash:"localhash".into(),foreign:false},SourceOwner{index:1,name:"foreign.rs".into(),start:100,length:100,hash:hash.into(),foreign:true}],512,std::sync::Mutex::new(ProvenanceMemo::default()))
